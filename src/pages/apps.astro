---
import Layout from '../layouts/Layout.astro'
import OuroMdMedia from '../components/OuroMdMedia.astro'
import { ogPathFor } from '../data/og'
import { labelFor, entry } from '../data/readiness.mjs'
import { ouroMdInstall } from '../data/principles.mjs'
import StoryScene from '../components/StoryScene.astro'

// The apps shelf. It moved here from the ouro.bot homepage (ourostack/ouro-apps-site#15)
// when ouro.bot forwarded to ouroboros.bot (Ari, 2026-11-06: "we need a unified domain").
// The copy is that homepage's, kept playful. Ouro MD's download page stays at
// ouro.bot/apps/ouro-md/, its App Store marketing URL.
const title = 'Apps: fresh from the workshop, ready to install | Ouro'
const description = 'Download Ouro MD, hatch an agent with npx ouro.bot, and pick up Ouro Shepherd, Ouro HX, Desk and Ouro Butler.'
const link = 'text-scale underline underline-offset-4 decoration-scale/40 hover:text-glow hover:decoration-current hover:decoration-2 transition-colors'
const section = 'px-6 md:px-12 lg:px-16 py-12 md:py-16 border-t border-canopy/20'
const md = labelFor('ouro-md')
const mdDetail = entry('ouro-md').detail

const why = [
  ['Genuinely native', 'Ouro MD is a real Mac app, not a browser tab in a trench coat. Native menus, shortcuts, and windows — fast, quiet, and at home on macOS.'],
  ['Local-first', 'Your files are plain files on your disk. No account to make, no cloud to trust, nothing phoning your documents home.'],
  ['Shipped with receipts', 'Public downloads are Developer-ID signed and notarized, with checksums and manifests you can verify. Trust, but audit.'],
]

const shelf = [
  { id: 'ouroboros', scene: 'ouroboros', name: 'Ouroboros', readiness: 'harness',
    body: 'Ouroboros is the agent harness I built from scratch, and it’s where I test what agents need. npx ouro.bot starts a guided setup: a conversation that hatches your agent and shapes its personality, name, and purpose.',
    links: [['/lab/', 'The harness →']] },
  { id: 'shepherd', scene: 'shepherd', name: 'Ouro Shepherd', readiness: 'shepherd',
    body: 'Keeps the agents in my terminals on task. When one stops before it needs to, Shepherd answers it where I can see it.',
    links: [['https://github.com/ourostack/ouroboros/blob/main/docs/shepherd-sense.md', 'How Shepherd decides ↗']] },
  { id: 'ouro-hx', scene: 'ouro-hx', name: 'Ouro HX', readiness: 'ouro-hx',
    body: 'Ouro HX is a React component library that feels right to the people using it and is obvious to the agents building with it.',
    links: [['/ouro-hx/', 'Meet Ouro HX →'], ['https://ui.ouro.bot/', 'See it live ↗']] },
  { id: 'desk', scene: 'desk', name: 'Desk', readiness: 'desk-claude-code-macos',
    body: 'Desk keeps my agents’ work in a Git repository: every track, task, decision, and lesson. Ask “where were we?” on any machine, and the agent knows.',
    links: [['/desk/', 'Desk →']] },
  { id: 'butler', scene: 'butler', name: 'Ouro Butler', readiness: 'butler',
    body: 'An Ouroboros agent that looks after a home server. When something your household counts on breaks, it fixes what it is allowed to and tells you the rest.',
    links: [['/butler/', 'Ouro Butler →']] },
].map((item) => ({ ...item, status: labelFor(item.readiness), detail: entry(item.readiness).detail }))
---

<Layout title={title} description={description} ogImage={ogPathFor('/apps')} canonical="https://ouroboros.bot/apps/">
  <section class="px-6 md:px-12 lg:px-16 pt-28 pb-12 md:pt-36">
    <div class="max-w-6xl mx-auto">
      <h1 class="heading-lead"><span class="t-clause"><span class="t-ph">Fresh from</span> <span class="t-ph">the workshop,</span></span> <span class="t-clause t-ph">ready to install.</span></h1>
      <p class="mt-6 text-xl md:text-2xl text-bone leading-snug">Small, sharp tools for people who live in text, and for the agents who live there with them. What they're for, and how my agents put them to work, is <a href="/" class={link}>all over this site</a>.</p>
    </div>
  </section>

  <section id="ouro-md" class={`${section} scroll-mt-16`} aria-labelledby="ouro-md-heading">
    <div class="max-w-6xl mx-auto grid gap-10 split split-media">
      <div class="grid gap-5 content-start min-w-0 split-head">
        <h2 id="ouro-md-heading" class="heading-section page-mark"><img src="/brand/ouro-md-icon.png" width="64" height="64" alt="" loading="lazy" decoding="async" class="mark-tile" />Ouro MD</h2>
        <p class="flex flex-wrap items-center gap-3"><span class={`tag ${md.tone}`}>{md.label}</span><span class="text-mist">{mdDetail}.</span></p>
        <p class="text-lg text-mist leading-relaxed">My agents write their plans and reports in Markdown. Ouro MD is a Mac editor made for reading them: it renders as you type, and marks exactly what changed when an agent edits.</p>
        <div class="flex flex-wrap items-center gap-3">
          <a href="https://ouro.bot/apps/ouro-md/" class="btn-primary">Download Ouro MD &#8599;</a>
          <a href="/ouro-md/" class={`hit ${link}`}>Features and install details &rarr;</a>
        </div>
        <div class="grid gap-2">
          <p class="caption-mono">Or install in Terminal</p>
          <pre id="apps-ouro-md-install" class="agent-text">{ouroMdInstall}</pre>
          <div class="flex flex-wrap items-center gap-3">
            <button type="button" data-copy-target="apps-ouro-md-install" class="btn-ghost !py-2 text-sm"><span data-copy-label>Copy</span></button>
            <span class="text-sm text-mist">Signed &amp; notarized. Local files stay local.</span>
          </div>
        </div>
      </div>
      <div class="min-w-0 split-body"><OuroMdMedia only="agent" /></div>
    </div>
  </section>

  <section id="why" class={`${section} bg-deep/40 scroll-mt-16`} aria-labelledby="why-heading">
    <h2 id="why-heading" class="heading-section max-w-6xl mx-auto">Made the way desktop software used to be made.</h2>
    <div class="max-w-6xl mx-auto split split-media why-split">
      <div class="split-head">
      <ul class="does does-stack">
        {why.map(([name, body]) => (
          <li><h3 class="does-name">{name}</h3><p>{body}</p></li>
        ))}
      </ul>
      </div>
      <StoryScene scene="ouro-md" class="split-body" sizes="(min-width: 1024px) 40rem, 100vw" />
    </div>
  </section>

  <section id="more" class={`${section} pb-20 scroll-mt-16`} aria-labelledby="more-heading">
    <div class="max-w-6xl mx-auto">
      <h2 id="more-heading" class="heading-section">More from the workshop</h2>
      <p class="mt-4 text-lg text-mist leading-relaxed">The shelf grows as the tools do: one honest status, one obvious next step. No vaporware, no roadmaps you'll resent.</p>
      <ul class="shelf">
        {shelf.map((item) => (
          <li id={item.id}>
            <StoryScene scene={item.scene} sizes="(min-width: 900px) 34rem, 100vw" />
            <div class="shelf-body">
              <h3 class="shelf-name">{item.name}</h3>
              <p class="shelf-status"><span class={`tag ${item.status.tone}`}>{item.status.label}</span> {item.detail}</p>
              <p>{item.body}</p>
              <p class="product-links">{item.links.map(([href, label]) => <a href={href} class={link}>{label}</a>)}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .page-mark { display: flex; align-items: center; gap: 1rem; }
  .page-mark img { width: 3rem; height: 3rem; }
  @media (min-width: 768px) { .page-mark img { width: 4rem; height: 4rem; } }
  .does { display: grid; gap: 1.75rem 3rem; margin-top: 2rem; }
  @media (min-width: 768px) { .does { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .does li { display: grid; gap: 0.4rem; align-content: start; padding-top: 1rem; border-top: 1px solid color-mix(in srgb, var(--color-canopy) 60%, transparent); color: var(--color-mist); line-height: 1.6; font-size: 1.0625rem; }
  @media (min-width: 1024px) { .why-split { align-items: center; } .does-stack { grid-template-columns: minmax(0, 1fr); } }
  .does-name { font-family: var(--font-display); font-size: 1.5rem; line-height: 1.2; color: var(--color-bone); }
  .shelf { display: grid; gap: 3.5rem 3rem; margin-top: 2.5rem; }
  @media (min-width: 900px) { .shelf { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  /* An odd one out never stands alone in the last row: it takes the whole row, its scene beside its words. */
  @media (min-width: 900px) { .shelf > li:last-child:nth-child(odd) { grid-column: 1 / -1; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 3rem; align-items: center; } }
  .shelf > li { display: grid; gap: 1.25rem; align-content: start; color: var(--color-mist); font-size: 1.0625rem; line-height: 1.6; }
  .shelf-body { display: grid; gap: 0.5rem; align-content: start; }
  .shelf-status { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.6rem; font-size: 0.875rem; color: var(--color-mist); }
  .shelf-name { font-family: var(--font-display); font-size: 1.6rem; line-height: 1.1; color: var(--color-bone); }
</style>
