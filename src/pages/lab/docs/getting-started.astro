---
import DocsPageShell from '../../../components/DocsPageShell.astro'
import SerpentGuidePreview from '../../../components/SerpentGuidePreview.astro'
import PromptCard from '../../../components/PromptCard.astro'
import { ogPathFor } from '../../../data/og'
import { labelFor } from '../../../data/readiness.mjs'

const harness = labelFor('harness')
---

<DocsPageShell
  title="Get started with Ouroboros in 3 minutes"
  description="Run one command. The serpent guide handles the rest."
  eyebrow="Operator guide"
  ogImage={ogPathFor('/lab/docs/getting-started')}
  canonical="https://ouroboros.bot/lab/docs/getting-started/"
  intro="Setup is a conversation, not a checklist. The serpent guide walks you through provider setup, naming, and personality — you just answer its questions."
>
  <section class="space-y-4" aria-label="Install Ouroboros">
    <p class="flex flex-wrap items-center gap-3 text-sm text-mist leading-relaxed" data-harness-notice>
      <span class={`tag ${harness.tone}`}>{harness.label}</span>
      <span>The Ouroboros harness is an experiment. Expect breaking changes.</span>
    </p>
    <p class="text-sm text-mist leading-relaxed">You'll need <a href="https://nodejs.org/en/download/" class="text-scale underline underline-offset-2 hover:text-glow transition-colors">Node.js 22 or newer</a>.</p>
    <PromptCard label="Open Terminal" prompt="npx ouro.bot" />
  </section>

  <SerpentGuidePreview />

  <div>
    <h2 class="font-mono text-xs text-scale uppercase tracking-[0.22em] mb-4">Already running?</h2>
    <PromptCard
      prompt="Inspect the current Ouroboros install on this machine and tell me what's set up, what's missing, and what I should do next."
      footnote="Use this if you already ran the setup and want your agent to check the current state."
    />
  </div>

  <!-- Exit links -->
  <div class="pt-6 border-t border-canopy/30 space-y-3">
    <a href="/lab/what-is-an-agent-harness" class="group block text-sm text-mist hover:text-bone transition-colors">
      Want to understand the philosophy behind Ouroboros? <span class="text-scale group-hover:text-glow transition-colors">&rarr;</span>
    </a>
    <a href="/lab/story" class="group block text-sm text-mist hover:text-bone transition-colors">
      Curious how we got here? <span class="text-scale group-hover:text-glow transition-colors">&rarr;</span>
    </a>
  </div>
</DocsPageShell>
