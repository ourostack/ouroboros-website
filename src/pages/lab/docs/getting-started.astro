---
import DocsPageShell from '../../../components/DocsPageShell.astro'
import SerpentGuidePreview from '../../../components/SerpentGuidePreview.astro'
import PromptCard from '../../../components/PromptCard.astro'
import { ogPathFor } from '../../../data/og'
import { labelFor } from '../../../data/readiness.mjs'

const harness = labelFor('harness')
---

<DocsPageShell
  title="Get started with Ouroboros in 3 minutes"
  description="Run one command. The serpent guide handles the rest."
  eyebrow="Operator guide"
  ogImage={ogPathFor('/lab/docs/getting-started')}
  canonical="https://ouroboros.bot/lab/docs/getting-started/"
  intro="Setup is a conversation. The serpent guide walks you through provider setup, naming, and personality — you just answer its questions."
>
  <section class="space-y-4" aria-label="Install Ouroboros">
    <p class="text-sm text-mist leading-relaxed">You'll need <a href="https://nodejs.org/en/download/" class="text-scale underline underline-offset-2 hover:text-glow transition-colors">Node.js 22 or newer</a>.</p>
    <PromptCard label="Open Terminal" prompt="npx ouro.bot" />
  </section>

  {/* What setup will ask for, for a builder deciding whether to run it. */}
  {/* Laid out openly, in the storybook type: no box, only the command above wears a frame. */}
  <dl class="setup-facts" data-setup-facts>
    <div><dt>Status</dt><dd><span class={`tag ${harness.tone}`}>{harness.label}</span> Expect breaking changes.</dd></div>
    <div><dt>Model provider</dt><dd>Pick one: Anthropic, Azure OpenAI, MiniMax, OpenAI Codex, or GitHub Copilot. You sign in or paste a key, and it's kept in your agent's own vault.</dd></div>
    <div><dt>Where you talk to it</dt><dd>The terminal, Telegram, iMessage (through BlueBubbles), Teams, email and voice. Reply to an earlier message in Telegram, iMessage or Teams and the agent sees what you replied to.</dd></div>
    <div><dt>Version</dt><dd>The 0.1.0 alpha series of <a href="https://www.npmjs.com/package/@ouro.bot/cli" class="text-scale underline underline-offset-2 hover:text-glow transition-colors">@ouro.bot/cli</a>. <a href="https://github.com/ourostack/ouroboros/blob/main/changelog.json" class="text-scale underline underline-offset-2 hover:text-glow transition-colors">Release notes</a>.</dd></div>
    <div><dt>How it's built</dt><dd><a href="/lab/docs/architecture/" class="text-scale underline underline-offset-2 hover:text-glow transition-colors">Architecture</a> and <a href="https://github.com/ourostack/ouroboros" class="text-scale underline underline-offset-2 hover:text-glow transition-colors">source on GitHub</a>.</dd></div>
  </dl>

  <SerpentGuidePreview />

  <div>
    <h2 class="heading-sub mb-4">Already running?</h2>
    <PromptCard
      prompt="Inspect the current Ouroboros install on this machine and tell me what's set up, what's missing, and what I should do next."
      footnote="Use this if you already ran the setup and want your agent to check the current state."
    />
  </div>

  <!-- Exit links -->
  <div class="pt-3 border-t border-canopy/30">
    <a href="/lab/what-is-an-agent-harness/" class="exit-link group block text-sm text-mist hover:text-bone transition-colors">
      Want to understand the philosophy behind Ouroboros? <span class="text-scale group-hover:text-glow transition-colors">&rarr;</span>
    </a>
    <a href="/lab/story/" class="exit-link group block text-sm text-mist hover:text-bone transition-colors">
      Curious how we got here? <span class="text-scale group-hover:text-glow transition-colors">&rarr;</span>
    </a>
  </div>
</DocsPageShell>

<style>
  .setup-facts { display: grid; column-gap: 3rem; }
  @media (min-width: 640px) { .setup-facts { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  .setup-facts > div { display: grid; gap: 0.3rem; align-content: start; padding: 1rem 0; border-top: 1px solid color-mix(in srgb, var(--color-canopy) 55%, transparent); }
  .setup-facts dt { font-family: var(--font-display); font-size: 1.5rem; line-height: 1.15; color: var(--color-bone); }
  .setup-facts dd { color: var(--color-mist); line-height: 1.6; }
</style>
