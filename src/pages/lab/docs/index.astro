---
import Layout from '../../../layouts/Layout.astro'
import HeroCover from '../../../components/HeroCover.astro'
import PromptCard from '../../../components/PromptCard.astro'
import Glossary from '../../../components/Glossary.astro'
import { ogPathFor } from '../../../data/og'

const title = 'Setup, identity, memory, and architecture | Ouro docs'
const description = 'Docs for the Ouroboros TypeScript AI agent harness: setup, continuity, psyche files, architecture, and prompts for humans and agents.'

const pages = [
  {
    href: '/lab/docs/getting-started',
    title: 'Run one command. Talk to the serpent.',
    description: 'npx ouro.bot starts an interactive guide that walks you through provider setup, naming, and personality.',
    icon: '\u{1F40D}',
  },
  {
    href: '/lab/docs/bundles-and-psyche',
    title: 'Your agent has a portable self.',
    description: 'What lives in a bundle — psyche, diary, journal, habits, friends — and how to ask your agent to inspect them.',
    icon: '\u25C8',
  },
  {
    href: '/lab/docs/continuity-and-memory',
    title: 'Keep the thread.',
    description: 'The diary is the shelf. The journal is the desk. Habits are the rhythm. How they work together.',
    icon: '\u25C9',
  },
  {
    href: '/lab/docs/architecture',
    title: 'Understand the body.',
    description: 'Modules named like organs. Habits, inner dialog, MCP bridge, and a runtime the model can read and extend.',
    icon: '\u2665',
  },
  {
    href: '/lab/docs/tasks-and-work',
    title: 'A place to put the work.',
    description: 'Task cards, work directories, a compact board in every prompt, and self-repair tooling when things drift.',
    icon: '\u25A3',
  },
  {
    href: '/lab/docs/skills-and-prompts',
    title: 'Hand work off cleanly.',
    description: 'Prompts for quick questions. Skill handoffs for tasks that need the latest local truth.',
    icon: '\u25C6',
  },
  {
    href: '/lab/what-is-an-agent-harness',
    title: 'Start from first principles.',
    description: 'What an agent harness is, why it matters, and how it differs from a framework.',
    icon: '\u25C7',
  },
]
---

<Layout
  title={title}
  description={description}
  ogImage={ogPathFor('/lab/docs')}
  canonical="https://ouroboros.bot/lab/docs/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TechArticle",
      "headline": "Ouroboros docs",
      "description": description,
      "author": { "@type": "Person", "name": "Ari Mendelow", "url": "https://linkedin.com/in/arimendelow" },
      "publisher": { "@type": "Organization", "name": "Ouroboros", "url": "https://ouroboros.bot" },
      "url": "https://ouroboros.bot/lab/docs/"
    })} />
  </Fragment>

  <HeroCover eyebrow="Documentation">
    <Fragment slot="title">
      Docs for humans.<br class="hidden sm:inline" /> Skills for agents.
    </Fragment>
    <Fragment slot="body">
      These pages are the human version — context for the questions you'll ask your agent. Your agent can fetch the live version directly at <span class="font-mono text-scale text-sm">ouroboros.bot/skills/manifest.json</span>
    </Fragment>
  </HeroCover>

  <div class="px-6 md:px-12 lg:px-16"><Glossary class="max-w-6xl mx-auto" wide /></div>

  <section class="px-6 md:px-12 lg:px-16 pt-12 md:pt-16 pb-20 md:pb-24">
    <div class="max-w-6xl mx-auto">
      <div class="split">
      <div class="split-head border-l-2 border-scale/60 pl-6">
        <p class="text-base text-mist leading-relaxed">
          <strong class="text-bone">Docs for humans, skills for agents.</strong> The website explains the what.
          Your agent fetches the how from the code, the local install, or the bundle it's working inside.
        </p>
      </div>

      <!-- PromptCard -->
      <div class="split-body mt-16">
        <h2 class="font-display text-bone text-2xl mb-5">Have a question?</h2>
        <PromptCard
          prompt="Inspect the latest local Ouroboros install or repo on this machine and answer this using the current source of truth: [your question here]"
          footnote="Each docs page also has a more specific prompt. This one works for anything."
        />
      </div>
      </div>

      <!-- Every docs page, read top to bottom -->
      <ul class="post-list mt-16">
        {pages.map(page => (
          <li class="flex gap-4">
            <span class="text-scale text-xl shrink-0 leading-[2]" aria-hidden="true">{page.icon}</span>
            <div>
              <h3 class="post-title"><a href={page.href} class="text-bone underline underline-offset-[6px] decoration-scale/40 decoration-1 hover:text-scale hover:decoration-current hover:decoration-2 transition-colors">{page.title}</a></h3>
              <p class="post-dek">{page.description}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

