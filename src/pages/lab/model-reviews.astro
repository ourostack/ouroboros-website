---
import Layout from '../../layouts/Layout.astro'
import PageHero from '../../components/PageHero.astro'
import modelReviews from '../../data/model-reviews.json'
import { ogPathFor } from '../../data/og'
import { parseInlineMd } from '../../lib/md.mjs'
import { getModelReviewClaims } from '../../lib/model-review-claims.mjs'

const reviews = modelReviews.reviews
const { claimSentence, shortClaim, totalReviews } = getModelReviewClaims(modelReviews)

// Harness count, derived from the script output. Render as a word for
// editorial readability up to twenty, as the Lab does; fall back to the digit above that.
const harnessCount = modelReviews.harnesses.length
const harnessCountWord = ['zero','one','two','three','four','five','six','seven','eight','nine','ten','eleven','twelve','thirteen','fourteen','fifteen','sixteen','seventeen','eighteen','nineteen','twenty'][harnessCount] ?? String(harnessCount)
// The day the panel ran, from the script output (root misses ruling 7.6).
const runDate = new Date(modelReviews.generated).toLocaleDateString('en-US', { timeZone: 'UTC', month: 'long', day: 'numeric', year: 'numeric' })
---

<Layout
  title="Which agent harness do frontier models prefer? | Ouro"
  description={`${claimSentence} Read the full methodology and transcripts.`}
  ogImage={ogPathFor('/lab/model-reviews')}
 crumbs={["Reviews"]}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Which agent harness do frontier models prefer?",
      "description": claimSentence,
      "dateModified": modelReviews.generated,
      "datePublished": modelReviews.generated,
      "author": { "@type": "Person", "name": "Ari Mendelow" },
      "publisher": { "@type": "Person", "name": "Ari Mendelow" }
    })} />
  </Fragment>

  <PageHero>
    <Fragment slot="title">
      {/* "Which agent harness" stays whole at every width (Ari's ruling on
          taste review r17: a compound term never breaks). */}
      <span class="t-ph">Which agent harness</span> do frontier models prefer?
    </Fragment>
    <Fragment slot="description">
      <p class="m-0 text-scale">{shortClaim}</p>
      <p class="m-0 mt-4">Each model was given web search, URL fetching, and a list of {harnessCountWord} publicly documented agent harnesses. They were asked to research freely, then state which one they would most want to inhabit.</p>
      <p class="m-0 mt-4 text-sm">Run on {runDate}.</p>
    </Fragment>
  </PageHero>

  <!-- Jump links: the page runs long, so each model's verdict and its
       per-harness rationale are one tap from the top (taste review r5). Plain
       anchors: every sentence stays on the page, and nothing needs JS. -->
  <nav aria-label="Jump to a model" class="relative px-6 md:px-12 lg:px-16 pt-0 md:pt-2 pb-4">
    <div class="max-w-6xl mx-auto">
      <span class="font-mono text-xs text-fang uppercase tracking-[0.22em] block mb-3">Jump to</span>
      <ul class="review-jumps">
        {reviews.map((review) => (
          <li>
            <a href={`#${review.provider}`} class="review-jump-name"><span>{review.displayName}</span></a>
            <span class="review-jump-more"><a href={`#${review.provider}-rationale`}><span>Per-harness rationale</span></a><a href={`/lab/model-reviews/${review.provider}/`}>Transcript</a></span>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <!-- ═══════════════ THE TESTIMONIALS — FULL WIDTH EDITORIAL ═══════════════ -->
  <section class="relative px-6 md:px-12 lg:px-16 py-20 md:py-28 reveal">
    <div class="relative max-w-6xl mx-auto">
      <div class="flex items-center gap-4 mb-14 md:mb-20">
        <span class="font-mono text-sm md:text-base text-scale uppercase tracking-[0.22em]">The verdict, in their own words</span>
        <span class="h-px flex-1 bg-canopy/40"></span>
      </div>

      <div class="divide-y divide-canopy/30">
        {reviews.map((review) => (
          <article id={review.provider} class="scroll-mt-24 py-16 md:py-24 first:pt-0 last:pb-0">
            <div class="grid gap-6">
              <!-- Attribution, then the quote under it -->
              <div class="flex flex-col">
                <div class="font-mono text-xs text-fang uppercase tracking-[0.22em] mb-3">{review.vendor}</div>
                <h2 class="font-display text-bone text-3xl md:text-4xl leading-tight">{review.displayName}</h2>

                <div class="mt-4 flex flex-wrap items-baseline gap-x-8 gap-y-3">
                  <div class="flex items-baseline gap-3">
                    <span class="font-mono text-xs text-mist uppercase tracking-[0.22em]">Verdict</span>
                    <span class="font-mono text-scale text-sm uppercase tracking-[0.12em]">{review.verdict}</span>
                  </div>
                  <div class="flex items-baseline gap-3">
                    <span class="font-mono text-xs text-mist uppercase tracking-[0.22em]">Inference</span>
                    <span class="font-mono text-bone text-xs uppercase tracking-[0.12em]">{review.transport === 'copilot' ? 'GitHub Copilot' : 'Direct API'}</span>
                  </div>
                  <a href={`/lab/model-reviews/${review.provider}/`} class="hit group inline-flex items-center gap-2 text-scale hover:text-glow transition-colors text-sm md:text-base font-medium">
                    <span class="underline underline-offset-[5px] decoration-scale/50 group-hover:decoration-glow">Read the {review.rounds}-round transcript</span>
                    <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
                  </a>
                </div>
              </div>

              <!-- The quote, full width.
                   parseInlineMd renders backtick code spans (`src/arc/...`)
                   and **bold** that the model produced in its testimonial. -->
              <blockquote class="text-bone text-base md:text-lg lg:text-lg leading-[1.75]" set:html={`&#8220;${parseInlineMd(review.testimonial)}&#8221;`}></blockquote>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════ FULL EVALUATIONS ═══════════════ -->
  <section class="relative px-6 md:px-12 lg:px-16 py-20 md:py-28 reveal">

    <div class="max-w-6xl relative mx-auto split">
      <div class="split-head">
        <span class="font-mono text-xs text-fang uppercase tracking-[0.25em] block mb-6">Per-harness rationale</span>
        <h2 class="heading-section mb-12 md:mb-16">
          How each model evaluated each harness.
        </h2>
      </div>

      <div class="split-body space-y-12 md:space-y-16">
        {reviews.map((review) => (
          <div id={`${review.provider}-rationale`} class="border-l-2 border-canopy/40 pl-6 md:pl-8 scroll-mt-24">
            <div class="flex items-baseline gap-3 mb-6">
              <span class="font-mono text-xs text-fang uppercase tracking-[0.22em]">{review.vendor}</span>
              <h3 class="heading-sub">{review.displayName}</h3>
            </div>
            <!-- Evaluations are paragraphs of `**Name** — text` per harness.
                 parseInlineMd handles bold + code spans + paragraph wrapping. -->
            <div class="prose-ouro" set:html={parseInlineMd(review.evaluations, { wrapInParagraphs: true })}></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════ METHODOLOGY ═══════════════ -->
  <section class="relative px-6 md:px-12 lg:px-16 py-20 md:py-28 reveal">
    <div class="max-w-6xl relative mx-auto">
      <span class="font-mono text-xs text-scale uppercase tracking-[0.25em] block mb-6">Methodology</span>
      <h2 class="heading-section mb-12 md:mb-16">
        How the review was run.
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 md:gap-12">
        <div>
          <h3 class="font-display text-bone text-2xl md:text-3xl mb-3">The setup</h3>
          <p class="text-mist text-sm md:text-base leading-relaxed">
            A single Node script runs the {totalReviews} selected models in parallel through the GitHub Copilot CLI runtime in stripped <code class="font-mono text-scale text-xs">empty</code> mode. The runner supplies the same instructions, the same list of {harnessCountWord} harnesses, and only three tools: <code class="font-mono text-scale text-xs">search</code> (web search via Perplexity), <code class="font-mono text-scale text-xs">fetch_url</code> (direct URL retrieval), and <code class="font-mono text-scale text-xs">final_verdict</code> (structured submission).
          </p>
        </div>

        <div>
          <h3 class="font-display text-bone text-2xl md:text-3xl mb-3">Copilot first</h3>
          <p class="text-mist text-sm md:text-base leading-relaxed">
            When the logged-in Copilot account exposes a selected model, inference uses that entitlement. Models absent from its catalog use their direct API. Every review uses the same research tools and Copilot CLI runtime.
          </p>
        </div>

        <div>
          <h3 class="font-display text-bone text-2xl md:text-3xl mb-3">Random order</h3>
          <p class="text-mist text-sm md:text-base leading-relaxed">
            The harness list is shuffled independently for each model to reduce position bias. The order is recorded with each transcript.
          </p>
        </div>

        <div>
          <h3 class="font-display text-bone text-2xl md:text-3xl mb-3">Research context</h3>
          <p class="text-mist text-sm md:text-base leading-relaxed">
            Automatic context compaction and large-output file indirection are disabled.
          </p>
        </div>

        <div>
          <h3 class="font-display text-bone text-2xl md:text-3xl mb-3">Source records</h3>
          <p class="text-mist text-sm md:text-base leading-relaxed">
            The transcript keeps every model turn and tool call. Search and fetch payloads are stored as exact prefixes of up to 500 characters with their model-visible length and SHA-256 hash.
          </p>
        </div>

        <div>
          <h3 class="font-display text-bone text-2xl md:text-3xl mb-3">Research process</h3>
          <p class="text-mist text-sm md:text-base leading-relaxed">
            We ran an initial comparison, repaired repository access for every candidate, and expanded the field to {harnessCountWord} harnesses. Then we reran the complete panel. The results and transcripts from that run are shown here.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ RUN IT YOURSELF ═══════════════ -->
  <section class="relative px-6 md:px-12 lg:px-16 py-20 md:py-28 reveal">

    <div class="max-w-6xl relative mx-auto split">
      <div class="split-head">
        <span class="font-mono text-xs text-fang uppercase tracking-[0.25em] block mb-6">Run it yourself</span>
        <h2 class="heading-section mb-8">
          Don't trust us. Run it.
        </h2>

        <p class="text-mist text-base md:text-lg leading-relaxed mb-8">
          The script is open source. Clone the repo and choose direct API keys or a Copilot subscription for inference. Both paths use the same research tools.
        </p>
      </div>

      <div class="split-body">

      <div class="border border-canopy/40 bg-deep/60 backdrop-blur-sm p-6 md:p-8 mb-3">
        <pre id="reviews-run" class="font-mono text-xs md:text-sm text-bone leading-relaxed overflow-x-auto" tabindex="0"><code>git clone https://github.com/ourostack/ouroboros-website
cd ouroboros-website
npm install
npm run reviews -- --inference direct-api

# Or use a Copilot subscription:
npm run reviews -- --inference copilot-first</code></pre>
      </div>
      {/* Every command block carries the shared Copy button (taste review r16). */}
      <div class="mb-6"><button type="button" data-copy-target="reviews-run" class="btn-ghost !py-2 text-sm"><span data-copy-label>Copy</span></button></div>

      <p class="text-shadow text-sm leading-relaxed">
        Use Node 22. Direct API mode is the default and needs no Copilot account or subscription. For the selected panel, set <code class="font-mono text-scale text-xs">ANTHROPIC_API_KEY</code>, <code class="font-mono text-scale text-xs">OPENAI_API_KEY</code>, <code class="font-mono text-scale text-xs">GEMINI_API_KEY</code> (or <code class="font-mono text-scale text-xs">GOOGLE_API_KEY</code>), and <code class="font-mono text-scale text-xs">MINIMAX_API_KEY</code>. Both modes require <code class="font-mono text-scale text-xs">PERPLEXITY_API_KEY</code> for search and share the bundled SDK research runtime.
      </p>
      <p class="text-shadow text-sm leading-relaxed mt-4">
        For Copilot-first mode, authenticate with <code class="font-mono text-scale text-xs">COPILOT_GITHUB_TOKEN</code> or an existing <code class="font-mono text-scale text-xs">copilot login</code>. Exact catalog matches use Copilot inference; only missing models need direct API keys. Copilot authentication, quota, and execution errors stop the run, and it never switches to paid APIs silently.
      </p>
      <p class="text-shadow text-sm leading-relaxed mt-4">
        Results are saved privately in the directory printed by the runner and do not update this page. Each run records its candidate list.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row sm:items-baseline gap-6">
        <a href="https://github.com/ourostack/ouroboros-website/blob/main/scripts/model-reviews.cjs" target="_blank" rel="noopener noreferrer" class="hit inline-flex items-center gap-2 whitespace-nowrap px-5 py-2.5 bg-scale text-void text-sm font-medium rounded-lg transition-all duration-300 hover:bg-glow hover:shadow-[0_0_30px_rgba(45,148,71,0.15)]">
          View the script on GitHub
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
        <a href="/" class="hit text-mist hover:text-bone transition-colors text-sm">&#8592; Back to home</a>
      </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .review-jumps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem 2.5rem; }
  @media (min-width: 768px) { .review-jumps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .review-jumps li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 1rem; padding: 0.1rem 0; border-top: 1px solid color-mix(in srgb, var(--color-canopy) 30%, transparent); }
  .review-jump-name { font-family: var(--font-display); font-size: 1.5rem; color: var(--color-bone); text-decoration: underline; text-underline-offset: 6px; text-decoration-color: color-mix(in srgb, var(--color-scale) 40%, transparent); }
  .review-jump-name:hover { color: var(--color-scale); }
  .review-jump-more { display: inline-flex; flex-wrap: wrap; gap: 0 0.9rem; font-size: 0.875rem; }
  /* A finger-sized 44px on every jump (taste review r15). */
  .review-jump-name, .review-jump-more a { display: inline-flex; align-items: center; min-height: 2.75rem; }
  .review-jump-more a { color: var(--color-scale); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: color-mix(in srgb, var(--color-scale) 40%, transparent); }
  .review-jump-more a:hover { color: var(--color-glow); }
</style>
