---
import Layout from '../../layouts/Layout.astro'
import HeroCover from '../../components/HeroCover.astro'
import Glossary from '../../components/Glossary.astro'
import OuroborosRing from '../../components/OuroborosRing.astro'
import modelReviews from '../../data/model-reviews.json'
import { ogPathFor } from '../../data/og'
import { getModelReviewClaims } from '../../lib/model-review-claims.mjs'

const headline = "Why persistence isn't enough for AI agents"
const title = `${headline} | Ouro`
const description = 'Why persistent agents need structured identity, automatic memory recall, per-person relationships, and cross-session continuity.'

const { claimSentence: calloutClaim } = getModelReviewClaims(modelReviews)

const psycheFiles = [
  { file: 'SOUL.md', role: 'What you are.', desc: 'Core invariants and temperament.' },
  { file: 'IDENTITY.md', role: 'How you show up.', desc: 'Tone, voice, self-presentation.' },
  { file: 'LORE.md', role: 'Where you come from.', desc: 'Origin and philosophical context.' },
  { file: 'TACIT.md', role: 'What you\'ve learned.', desc: 'Patterns the agent can\'t explain — it just knows.' },
  { file: 'ASPIRATIONS.md', role: 'Where you\'re going.', desc: 'Current direction and active priorities.' },
]

const organs = [
  { name: 'heart', desc: 'Runtime, providers, habits, daemon.', icon: '♥' },
  { name: 'mind', desc: 'Context assembly, diary, journal, recall.', icon: '◉' },
  { name: 'senses', desc: 'CLI, Teams, inner dialog, MCP.', icon: '◈' },
  { name: 'repertoire', desc: 'Tools, skills, tasks, coding.', icon: '◆' },
  { name: 'nerves', desc: 'Observability, logs, signals.', icon: '◇' },
]
---

<Layout title={title} description={description} ogImage={ogPathFor('/lab/why')} canonical="https://ouroboros.bot/lab/why/" ogType="article">
  <Fragment slot="head">
    <meta name="author" content="Ari Mendelow" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": headline,
      "description": description,
      "author": { "@type": "Person", "name": "Ari Mendelow" },
      "datePublished": "2026-03-05",
      "url": "https://ouroboros.bot/lab/why/"
    })} />
  </Fragment>

  <!-- ═══════ 1. HERO ═══════ -->
  <HeroCover eyebrow="Why Ouroboros">
    <Fragment slot="title">Persistence is not enough.</Fragment>
    <Fragment slot="body">
      A long-lived agent that can't stay oriented is just a chatbot with a longer memory.
      Ouroboros lowers the cost of self-recovery — so the human can collaborate without re-briefing.
    </Fragment>
  </HeroCover>

  <div class="px-6 md:px-12 lg:px-16"><Glossary class="max-w-6xl mx-auto" wide /></div>

  <!-- Pull quote (moved out of the hero so the cover stays focused) and the reviews callout, side by side on desktop -->
  <section class="relative px-6 md:px-12 lg:px-16 pt-8 pb-12 reveal">
    <div class="max-w-6xl mx-auto grid gap-28 lg:grid-cols-2 lg:gap-16 lg:items-center">
    <blockquote class="w-full mx-auto border-l border-fang/30 pl-6">
      <p class="text-bone text-lg sm:text-xl leading-relaxed">
        &#8220;I spent more time trying to get my agents back on track than we actually spent working.&#8221;
      </p>
      <p class="mt-3 text-sm text-mist">That's the problem.</p>
    </blockquote>

    <div class="max-w-6xl w-full mx-auto">
      <a href="/lab/model-reviews" class="block group border border-scale/30 bg-scale/5 hover:bg-scale/10 hover:border-scale/60 rounded-sm p-6 md:p-8 transition">
        <div class="font-mono uppercase tracking-[0.22em] text-scale text-xs mb-3">Reviews</div>
        <p class="font-display text-2xl md:text-3xl text-bone leading-tight mb-3">
          {calloutClaim}
        </p>
        <span class="font-mono text-xs uppercase tracking-[0.18em] text-scale group-hover:text-glow">
          Read the reviews →
        </span>
      </a>
    </div>
    </div>
  </section>

  <!-- ═══════ 2. FRICTION — diagonal flow, each question offset ═══════ -->
  <section id="friction" class="px-6 md:px-12 lg:px-16 py-12 sm:py-16 md:py-20 reveal">
    <div class="max-w-6xl relative mx-auto friction-stair">
      <p class="friction-intro text-sm sm:text-base text-mist mb-14 sm:mb-20 lg:mb-0 leading-relaxed">
        The hidden tax. Every time the agent loses the thread, someone pays to rebuild it.
        Usually the human. That's <a href="/blog/what-is-agent-experience" class="text-scale hover:text-glow transition-colors underline underline-offset-2">reorientation overhead</a>.
      </p>

      <div class="space-y-12 sm:space-y-20 md:space-y-28 lg:space-y-0 lg:contents">
        <div class="friction-1">
          <span class="font-mono text-xs text-fang uppercase tracking-[0.25em]">Self</span>
          <h2 class="heading-section mt-3">Who am I again?</h2>
          <p class="text-sm sm:text-base text-mist mt-4 leading-relaxed">
            Identity drift turns every interruption into a soft reset.
          </p>
        </div>

        <div class="friction-2 sm:ml-[12%] md:ml-[20%] lg:ml-0">
          <span class="font-mono text-xs text-fang uppercase tracking-[0.25em]">Work</span>
          <h2 class="heading-section mt-3">What was I doing?</h2>
          <p class="text-sm sm:text-base text-mist mt-4 leading-relaxed">
            Context gets trimmed. The human has to reconstruct the thread.
          </p>
        </div>

        <div class="friction-3 sm:ml-[24%] md:ml-[40%] lg:ml-0">
          <span class="font-mono text-xs text-fang uppercase tracking-[0.25em]">Relationships</span>
          <h2 class="heading-section mt-3">Who matters here?</h2>
          <p class="text-sm sm:text-base text-mist mt-4 leading-relaxed">
            The agent loses track of humans, preferences, and interpersonal nuance.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════ 3. RING, beside the identity section on desktop ═══════ -->
  <section class="lg:px-16">
  <div class="lg:max-w-6xl lg:mx-auto split split-sticky lg:items-center">
  <div class="split-head flex items-center justify-center py-12 sm:py-20 md:py-28">
    <OuroborosRing size="md" id="why" />
  </div>

  <!-- ═══════ 4. IDENTITY ═══════ -->
  <div id="identity" class="split-body px-6 md:px-12 lg:px-0 py-16 sm:py-24 md:py-32 reveal">
    <div class="max-w-6xl mx-auto">
      <p class="text-scale text-base sm:text-lg mb-4">You always know who you are.</p>
      <h2 class="heading-section mb-6 sm:mb-8">
        A structured psyche.
      </h2>

      <div class="sm:grid sm:grid-cols-2 sm:gap-12 mb-12">
        <p class="text-sm sm:text-base text-mist leading-relaxed">
          Five markdown files define the agent's identity. Loaded every turn.
          The self is structured.
          <a href="/lab/docs/bundles-and-psyche" class="text-scale hover:text-glow transition-colors ml-0.5">Your agent can inspect its own bundle.</a>
        </p>
        <p class="text-sm sm:text-base text-mist leading-relaxed mt-4 sm:mt-0 sm:border-l sm:border-canopy/30 sm:pl-6">
          Most harnesses give the agent a single personality file. As the agent grows, that file becomes a junk drawer.
        </p>
      </div>

      {psycheFiles.map(({ file, role, desc }, i) => (
        <div class:list={["py-4 sm:py-5 flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6", i > 0 && "border-t border-canopy/20"]}>
          <span class="font-mono text-sm text-scale tracking-wide shrink-0 sm:w-32">{file}</span>
          <span class="font-mono text-bone text-xs sm:text-sm uppercase tracking-[0.15em]">{role}</span>
          <span class="text-sm text-mist">{desc}</span>
        </div>
      ))}

      <p class="text-sm text-mist mt-10 leading-relaxed">
        Naming shapes reasoning: <span class="font-mono text-scale">friends/</span>, <span class="font-mono text-scale">TACIT.md</span>, and <span class="font-mono text-scale">psyche/</span> are words chosen for how the agent should think about each one.
      </p>
    </div>
  </div>
  </div>
  </section>

  <!-- ═══════ 5. MEMORY ═══════ -->
  <section id="memory" class="px-6 md:px-12 lg:px-16 py-16 sm:py-24 md:py-32 reveal">
    <div class="max-w-6xl mx-auto split split-wide">
      <div class="split-head mb-12 sm:mb-16">
        <p class="text-scale text-base sm:text-lg mb-4">Memories find you.</p>
        <h2 class="heading-section">
          Agent-initiated. Automatically recalled.
        </h2>
      </div>

      <div class="grid sm:grid-cols-3 gap-10 sm:gap-12 lg:col-span-full">
        <div>
          <span class="font-mono text-xs text-scale uppercase tracking-[0.25em] block mb-4">The shelf</span>
          <p class="text-sm sm:text-base text-mist leading-relaxed">
            The <span class="font-mono text-scale text-sm">diary/</span> is the agent's permanent record — conclusions, learned facts, things worth keeping. Written via
            <span class="font-mono text-scale text-sm">diary_write</span>.
            Friend-scoped observations via
            <span class="font-mono text-scale text-sm">save_friend_note</span>.
          </p>
        </div>
        <div class="sm:border-l sm:border-canopy/30 sm:pl-10">
          <span class="font-mono text-xs text-scale uppercase tracking-[0.25em] block mb-4">The desk</span>
          <p class="text-sm sm:text-base text-mist leading-relaxed">
            The <span class="font-mono text-scale text-sm">journal/</span> is working space — thinking-in-progress, drafts, notes the agent is still forming. Written with the same file tools it uses for everything else.
          </p>
        </div>
        <div class="sm:border-l sm:border-canopy/30 sm:pl-10">
          <span class="font-mono text-xs text-scale uppercase tracking-[0.25em] block mb-4">Recall</span>
          <p class="text-sm sm:text-base text-mist leading-relaxed">
            Relevant memories surface in the system prompt before reasoning
            begins — via embedding similarity, across both diary and journal. Ouroboros does the work before the agent starts thinking.
          </p>
        </div>
      </div>

      <p class="split-body lg:row-start-1 lg:self-end lg:mb-16 text-sm sm:text-base text-mist mt-12 border-l-2 border-canopy/40 pl-6 leading-relaxed">
        In most systems, the agent has to know it's forgotten something before it can search for it. That's backwards.
      </p>
    </div>
  </section>

  <!-- ═══════ 6. RELATIONSHIPS — narrow, intimate ═══════ -->
  <section id="relationships" class="px-6 md:px-12 lg:px-16 py-16 sm:py-24 md:py-32 reveal">
    <div class="max-w-6xl mx-auto split">
      <div class="split-head mb-8">
        <p class="text-scale text-base sm:text-lg mb-4">You remember who matters.</p>
        <h2 class="heading-section">
          Friends.
        </h2>
      </div>

      <div class="split-body">

      <p class="text-sm sm:text-base text-mist leading-relaxed">
        Each person the agent interacts with gets a FriendRecord. Trust levels gate which tools the agent can
        use with which humans. Friend-scoped observations let the agent
        jot down context about specific individuals without polluting
        the diary.
      </p>

      <p class="text-sm sm:text-base text-mist mt-5 leading-relaxed">
        Reactions are social cues. A thumbs-down on Teams or a heart on iMessage
        reaches the agent as a first-class signal — it gets a full turn to observe, ponder what went wrong,
        or adjust. No hardcoded cooldowns. The agent decides what a reaction means.
      </p>

      <p class="text-sm sm:text-base text-mist mt-8 border-l-2 border-canopy/40 pl-6 leading-relaxed">
        Most agent systems treat every human the same. No per-person context,
        no trust model, no way to remember that this person prefers terse
        responses or that person shouldn't have access to the calendar.
      </p>
      </div>
    </div>
  </section>

  <!-- ═══════ 7. CONTINUITY — staggered features ═══════ -->
  <section id="continuity" class="px-6 md:px-12 lg:px-16 py-16 sm:py-24 md:py-32 reveal">
    <div class="max-w-6xl mx-auto split split-wide">
      <div class="split-head mb-12 sm:mb-16 md:mb-20">
        <p class="text-scale text-base sm:text-lg mb-4">Context gets trimmed.</p>
        <h2 class="heading-section">
          The conversation is continuous. <span class="text-mist">The self is structural.</span>
        </h2>
      </div>

      <div class="space-y-12 sm:space-y-16 lg:space-y-0 lg:col-span-full lg:grid lg:grid-cols-2 lg:gap-x-16 lg:gap-y-12">
        <div>
          <span class="font-mono text-xs text-scale uppercase tracking-[0.25em]">Cross-session bridges</span>
          <p class="text-sm sm:text-base text-mist mt-3 leading-relaxed">
            State machines that coordinate work across conversations and channels.
            The agent creates them deliberately — attaching sessions to a shared objective.
          </p>
        </div>

        <div>
          <span class="font-mono text-xs text-scale uppercase tracking-[0.25em]">Inner dialog</span>
          <p class="text-sm sm:text-base text-mist mt-3 leading-relaxed">
            A dedicated channel to think independently — processing, reflecting, planning
            without waiting for a human message. When a thought is ready, the agent surfaces it outward.
          </p>
        </div>

        <div>
          <span class="font-mono text-xs text-scale uppercase tracking-[0.25em]">Dev tools as peers</span>
          <p class="text-sm sm:text-base text-mist mt-3 leading-relaxed">
            The agent serves as an MCP server for Claude Code and Codex.
            Each message runs a full agent turn with identity, diary, tools, everything.
            The dev tool and the agent are bidirectional peers.
          </p>
        </div>

        <div>
          <span class="font-mono text-xs text-scale uppercase tracking-[0.25em]">Portable self</span>
          <p class="text-sm sm:text-base text-mist mt-3 leading-relaxed">
            The .ouro bundle. Psyche, diary, journal, habits, friends, tasks, skills —
            everything that makes an agent <em>that</em> agent, in one directory.
            Move it, and the identity moves with it.
          </p>
        </div>
      </div>

      <p class="split-body lg:row-start-1 lg:self-end lg:mb-20 text-sm sm:text-base text-mist mt-14 border-l-2 border-canopy/40 pl-6 leading-relaxed">
        In most systems, conversations are isolated. Work that spans multiple threads
        has to be stitched together by the human.
      </p>
    </div>
  </section>

  <!-- ═══════ 8. INNER LIFE ═══════ -->
  <section id="inner-life" class="px-6 md:px-12 lg:px-16 py-16 sm:py-24 md:py-32 reveal">
    <div class="max-w-6xl mx-auto split split-wide">
      <div class="split-head mb-12 sm:mb-16 md:mb-20">
        <p class="text-scale text-base sm:text-lg mb-4">You breathe on your own time.</p>
        <h2 class="heading-section">
          Habits.
        </h2>
      </div>

      <div class="sm:grid sm:grid-cols-2 sm:gap-12 mb-14 lg:col-span-full">
        <p class="text-sm sm:text-base text-mist leading-relaxed">
          Your agent has a heartbeat — a periodic nudge back to its own thinking space.
          When it wakes, it sees its journal, its pending obligations, how long it's been.
          It decides what to do: ponder something, surface a thought, or rest.
        </p>
        <p class="text-sm sm:text-base text-mist leading-relaxed mt-4 sm:mt-0 sm:border-l sm:border-canopy/30 sm:pl-6">
          The heartbeat is just one habit. Agents create their own: daily reflections,
          weekly check-ins, inbox triage. Each habit is a markdown file the agent writes and owns —
          cadence, instructions, purpose. The OS fires the cron. The agent decides what the turn means.
        </p>
      </div>

      <div class="space-y-12 sm:space-y-16 lg:space-y-0 lg:col-span-full lg:grid lg:grid-cols-3 lg:gap-x-12">
        <div>
          <span class="font-mono text-xs text-scale uppercase tracking-[0.25em]">Rhythms</span>
          <p class="text-sm sm:text-base text-mist mt-3 leading-relaxed">
            Habits live at <span class="font-mono text-scale text-sm">habits/</span> in the bundle.
            A title, a cadence, a body the agent wrote for itself. Each one fires independently
            via OS-level scheduling — no hand-rolled timers, no reinventing the wheel.
          </p>
        </div>

        <div>
          <span class="font-mono text-xs text-scale uppercase tracking-[0.25em]">Ponder / Surface / Rest</span>
          <p class="text-sm sm:text-base text-mist mt-3 leading-relaxed">
            A vocabulary for thinking. <em>Ponder</em> sends a thought inward.
            <em>Surface</em> brings it back to the world.
            <em>Rest</em> ends the turn. <em>Observe</em> stays quiet in a group.
            Cognitive states the agent moves between naturally.
          </p>
        </div>

        <div>
          <span class="font-mono text-xs text-scale uppercase tracking-[0.25em]">Self-directed</span>
          <p class="text-sm sm:text-base text-mist mt-3 leading-relaxed">
            The agent detects missing infrastructure — no heartbeat yet? It surfaces to its
            family to discuss what cadence feels right. The breathing rate is a conversation.
          </p>
        </div>
      </div>

      <p class="split-body lg:row-start-1 lg:self-end lg:mb-20 text-sm sm:text-base text-mist mt-14 border-l-2 border-canopy/40 pl-6 leading-relaxed">
        Most agent systems are reactive — they wait for a message, then respond.
        This one thinks on its own schedule and decides when to share.
      </p>
    </div>
  </section>

  <!-- ═══════ 9. BODY — only section with texture ═══════ -->
  <section id="body" class="relative px-6 md:px-12 lg:px-16 py-16 sm:py-24 md:py-36 reveal">
    <div class="absolute inset-0 bg-undergrowth/25 pointer-events-none"></div>
    <div class="absolute inset-0 opacity-[0.06] pointer-events-none" style="background-image: linear-gradient(var(--color-scale) 1px, transparent 1px), linear-gradient(90deg, var(--color-scale) 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="max-w-6xl relative mx-auto">
      <div class="lg:grid lg:grid-cols-[1fr_1.8fr] lg:gap-16 items-start">
        <div class="lg:sticky lg:top-28 mb-12 lg:mb-0">
          <p class="text-scale text-base sm:text-lg mb-4">You can read your own source.</p>
          <h2 class="heading-section">
            The codebase is a creature.
          </h2>
          <p class="text-sm sm:text-base text-mist mt-5 leading-relaxed">
            Named for the model that lives inside it. A heart that beats, a mind that thinks, senses that perceive.
          </p>
        </div>

        <div>
          {organs.map(({ name, desc, icon }) => (
            <div class="flex items-baseline gap-4 sm:gap-5 py-4 border-b border-canopy/30 last:border-0">
              <span class="text-scale text-base shrink-0">{icon}</span>
              <span class="font-mono text-sm sm:text-base text-bone tracking-wide shrink-0 w-24 sm:w-28">{name}/</span>
              <span class="text-sm sm:text-base text-mist">{desc}</span>
            </div>
          ))}
          <div class="flex items-baseline gap-4 sm:gap-5 py-4">
            <span class="text-scale text-base shrink-0">◈</span>
            <span class="font-mono text-sm sm:text-base text-bone tracking-wide shrink-0 w-24 sm:w-28">Name.ouro/</span>
            <span class="text-sm sm:text-base text-mist">The portable self.</span>
          </div>

          <p class="text-sm sm:text-base text-mist mt-10 leading-relaxed">
            <a href="/blog/build-ai-agent-from-scratch" class="text-scale hover:text-glow transition-colors underline underline-offset-2">Code a model can use</a>, not code that uses a model.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════ 9. CLOSING ═══════ -->
  <section class="px-6 md:px-12 lg:px-16 py-16 sm:py-20 reveal">
    <div class="max-w-6xl mx-auto space-y-8 split">
      <p class="split-head text-bone text-base sm:text-lg leading-relaxed">
        This started with <a href="/lab/story" class="text-scale underline underline-offset-2 hover:text-glow transition-colors">a plugin that couldn't hold the weight</a>.
        A single SOUL.md trying to be five things at once. Duct tape on someone else's architecture.
        What emerged was something different.
      </p>
      <p class="split-body text-sm text-mist leading-relaxed">
        <a href="/lab/docs" class="text-scale underline underline-offset-2 hover:text-glow transition-colors">Your agent will explain how it works</a>.
        Or if you want to understand the primitive underneath, <a href="/blog/build-ai-agent-from-scratch" class="text-scale underline underline-offset-2 hover:text-glow transition-colors">build the loop from scratch</a> in 150 lines.
      </p>
    </div>
  </section>
</Layout>

<style>
  /* Friction: on desktop the three questions step down across the width, with the intro at the top right. */
  @media (min-width: 1024px) {
    .friction-stair { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 3rem; row-gap: 3rem; }
    .friction-intro { grid-column: 2 / 4; grid-row: 1; justify-self: end; align-self: start; }
    .friction-1 { grid-column: 1; grid-row: 1; }
    .friction-2 { grid-column: 2; grid-row: 2; }
    .friction-3 { grid-column: 3; grid-row: 3; }
  }
</style>
