---
import Layout from '../../layouts/Layout.astro'
import SerpentGuidePreview from '../../components/SerpentGuidePreview.astro'
import OuroborosRing from '../../components/OuroborosRing.astro'
import modelReviews from '../../data/model-reviews.json'
import { ogPathFor, pageOg } from '../../data/og'
import { labelFor } from '../../data/readiness.mjs'
import { getModelReviewClaims } from '../../lib/model-review-claims.mjs'

const reviews = modelReviews.reviews
const { winner, claimSentence, heroLead, allChose } = getModelReviewClaims(modelReviews)
// root final ruling F10 (2026-10-11): the claim as the method, with the harness
// count from the script output, spelled out.
const numberWords = ['zero','one','two','three','four','five','six','seven','eight','nine','ten','eleven','twelve','thirteen','fourteen','fifteen','sixteen','seventeen','eighteen','nineteen','twenty']
const harnessCountWord = numberWords[modelReviews.harnesses.length] ?? String(modelReviews.harnesses.length)
const reviewsHeading = allChose ? `Every frontier model we asked picked ${winner}.` : null
const reviewsMethod = `We asked each model separately, with the same ${harnessCountWord} harnesses.`
const harness = labelFor('harness')
const title = 'The harness: where all of this started | Ouro'
const description = pageOg['/lab'].subtitle
const link = 'text-scale underline underline-offset-4 decoration-scale/40 hover:text-glow hover:decoration-current hover:decoration-2 transition-colors'

// Everything in the Lab. Titles and summaries come from the OG manifest, so
// the list and each page's share card agree.
const pieces = [
  ['/lab/story', 'Origin'],
  ['/lab/why', 'Origin'],
  ['/lab/what-is-an-agent-harness', 'Origin'],
  ['/blog/what-is-agent-experience', 'Essay'],
  ['/blog/give-your-agent-a-home', 'Essay'],
  ['/blog/build-ai-agent-from-scratch', 'Tutorial'],
  ['/lab/model-reviews', 'Experiment'],
  ['/lab/docs', 'Experiment'],
].map(([route, kind]) => ({ href: `${route}/`, kind, title: pageOg[route].title, summary: pageOg[route].subtitle }))
---

<Layout title={title} description={description} ogImage={ogPathFor('/lab')} canonical="https://ouroboros.bot/lab/">
  <!-- The Lab's own opening: what the harness is to everything else -->
  <section class="relative overflow-hidden px-6 md:px-12 lg:px-16 pt-32 md:pt-40 pb-6">
    <div class="absolute top-0 left-1/4 w-[600px] h-[400px] rounded-full bg-scale/[0.06] blur-[160px] pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-6xl mx-auto grid gap-5 split lg:items-end">
      <div class="grid gap-5 split-head">
        <p class="flex flex-wrap items-center gap-3"><span class="eyebrow">Lab</span><span class={`tag ${harness.tone}`}>{harness.label}</span></p>
        <h1 class="heading-lead">The harness: where all of this <span class="text-scale">started.</span></h1>
      </div>
      <div class="grid gap-5 split-body">
        <p class="text-lg md:text-xl text-mist leading-relaxed">Slugger was my OpenClaw agent. When he kept losing the thread, I built him a harness from scratch. Ouroboros is that harness, and it's where I test what agents need.</p>
        <p class="flex flex-wrap gap-3 mt-2">
          <a href="/lab/story/" class="btn-primary">Read the story &rarr;</a>
          <a href="https://github.com/ourostack/ouroboros" class="btn-ghost">The harness on GitHub &#8599;</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════════════ HERO — DECK SLIDE ═══════════════ -->
  <section class="relative overflow-hidden px-6 md:px-12 lg:px-16 pt-10 pb-20 md:pt-12 md:pb-24 flex flex-col">
    <div class="absolute inset-0 bg-gradient-to-b from-deep via-undergrowth/15 to-void pointer-events-none"></div>
    <div class="absolute top-1/3 left-1/4 w-[500px] h-[400px] md:w-[800px] md:h-[500px] rounded-full bg-scale/[0.04] blur-[150px] md:blur-[220px] pointer-events-none"></div>

    <div class="relative max-w-6xl mx-auto w-full flex-1 flex flex-col justify-center">
      <!-- Eyebrow -->
      <div class="mb-8 md:mb-10 animate-fade-up">
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full border border-fang/30 bg-fang/[0.04]">
          <span class="font-mono text-xs text-fang uppercase tracking-[0.25em]">&#10022; Reviews</span>
        </div>
      </div>

      <!-- ONE claim -->
      <h2 class="heading-hero animate-fade-up stagger-1">
        {reviewsHeading ? <>Every frontier model we asked picked <span class="text-scale">{winner}.</span></> : <>{heroLead} <span class="text-scale">{winner}.</span></>}
      </h2>

      <!-- ONE subhead — derived from the script output. Never hardcode the claim. -->
      <p class="mt-6 md:mt-8 text-bone text-lg md:text-xl lg:text-2xl leading-snug animate-fade-up stagger-2">
        {reviewsHeading ? reviewsMethod : claimSentence}
      </p>

      <!-- 4 compact specimen cards — the selected review panel.
           Each card links to that model's full transcript page. -->
      <div class="mt-12 md:mt-16 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-7 animate-fade-up stagger-3">
        {reviews.map((review) => (
          <a href={`/lab/model-reviews/${review.provider}`} class="group block border-t border-canopy/50 pt-5 hover:border-scale/70 transition-colors">
            <div class="font-mono text-xs text-fang uppercase tracking-[0.22em] mb-2">{review.vendor}</div>
            <div class="font-display text-bone text-lg md:text-xl leading-tight mb-4 group-hover:text-scale transition-colors">{review.displayName}</div>
            <p class="text-bone text-sm md:text-[15px] leading-[1.6]">
              &#8220;{review.pullQuote}&#8221;
            </p>
            <div class="mt-5 inline-flex items-center gap-2 font-mono text-xs text-scale uppercase tracking-[0.18em] group-hover:text-glow transition-colors">
              Read transcript
              <span class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
            </div>
          </a>
        ))}
      </div>

      <!-- ONE CTA + secondary links -->
      <div class="mt-12 md:mt-16 flex flex-wrap items-center gap-x-7 gap-y-4 animate-fade-up stagger-4">
        <a href="/lab/model-reviews" class="group inline-flex items-center gap-2 px-6 py-3 bg-scale text-void text-sm md:text-base font-medium rounded-md transition-all duration-300 hover:bg-glow hover:shadow-[0_0_40px_rgba(45,148,71,0.2)]">
          Read the methodology
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
        <a href="/lab/docs/getting-started/" class="inline-flex items-center gap-1.5 text-bone hover:text-scale transition-colors text-sm md:text-base">
          Get started
          <svg class="w-3.5 h-3.5 text-scale" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
        <a href="/lab/why" class="text-mist hover:text-bone transition-colors text-sm md:text-base">Why Ouroboros</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════ THE COST ═══════════════ -->
  <section class="relative overflow-hidden px-6 md:px-12 lg:px-16 py-24 sm:py-32 md:py-48 reveal">
    <div class="absolute inset-0 bg-deep/80 pointer-events-none"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-void/50 via-transparent to-void/50 pointer-events-none"></div>

    <div class="relative max-w-6xl mx-auto">
      <span class="font-mono text-xs text-fang uppercase tracking-[0.25em] block mb-8">The cost</span>

      <div class="grid gap-10 lg:grid-cols-[1fr_auto] lg:items-center mb-16 sm:mb-24 md:mb-32">
        <div class="min-w-0">
          <h2 class="heading-section">
            What survives when the context window <span class="text-scale">runs out?</span>
          </h2>

          <p class="font-display text-2xl md:text-3xl text-mist mt-6">
            Every conversation has a ceiling. Hit it, and something has to give.
          </p>
        </div>
        <div class="hidden lg:flex justify-center" aria-hidden="true">
          <OuroborosRing size="md" id="lab-cost" />
        </div>
      </div>

      <div class="space-y-14 lg:space-y-0 lg:grid lg:grid-cols-3 lg:gap-16">
        <!-- Problems: smaller type, mist color -->
        <div>
          <span class="font-mono text-xs text-fang uppercase tracking-[0.22em]">Compaction</span>
          <h3 class="font-display text-2xl md:text-3xl text-mist mt-4 leading-snug">Summarize and forget.</h3>
          <p class="text-sm md:text-base text-mist mt-4 leading-relaxed">
            The model compresses its history. Details flatten. Tone drifts. The agent becomes a stranger wearing a familiar name.
          </p>
        </div>

        <div>
          <span class="font-mono text-xs text-fang uppercase tracking-[0.22em]">New session</span>
          <h3 class="font-display text-2xl md:text-3xl text-mist mt-4 leading-snug">Start over entirely.</h3>
          <p class="text-sm md:text-base text-mist mt-4 leading-relaxed">
            Everything resets. The human re-briefs. The agent re-discovers. Hours of shared context evaporate.
          </p>
        </div>

        <!-- Solution: larger type, bone color, scale accent -->
        <div>
          <span class="font-mono text-xs text-scale uppercase tracking-[0.22em]">Ouroboros</span>
          <h3 class="font-display text-2xl md:text-3xl text-bone mt-4 leading-snug">The snake eats its tail.</h3>
          <p class="text-sm md:text-base text-mist mt-4 leading-relaxed">
            Old messages are trimmed, and identity lives in the psyche. The agent keeps a diary, journals its thinking, and surfaces what matters when it matters.
          </p>
          <p class="font-mono text-scale text-xs uppercase tracking-[0.22em] mt-6">The tail is consumed. The self survives.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ BEGIN ═══════════════ -->
  <section class="relative px-6 md:px-12 lg:px-16 py-24 sm:py-32 md:py-48 reveal">
    <div class="absolute bottom-0 left-0 right-0 h-1/2 bg-gradient-to-t from-scale/[0.04] to-transparent pointer-events-none"></div>

    <div class="relative lg:grid lg:grid-cols-[0.8fr_1.2fr] lg:gap-16 lg:items-start max-w-6xl mx-auto">
      <div class="mb-16 lg:mb-0 lg:sticky lg:top-32">
        <span class="font-mono text-xs text-scale uppercase tracking-[0.25em] block mb-6">Begin</span>
        <h2 class="heading-section">
          One command.<br />
          A conversation.<br />
          <span class="text-scale">Hatched.</span>
        </h2>
        <p class="text-sm xl:text-base text-mist mt-6 leading-relaxed">
          <code class="font-mono text-scale text-xs">npx ouro.bot</code> starts a guided setup: a conversation that hatches your agent and shapes its personality, name, and purpose.
        </p>
        <div class="mt-8 flex items-baseline gap-6">
          <a href="/lab/docs" class="inline-flex items-center gap-2 px-5 py-2.5 bg-scale text-void text-sm font-medium rounded-lg transition-all duration-300 hover:bg-glow hover:shadow-[0_0_30px_rgba(45,148,71,0.15)]">
            Read the docs
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
          </a>
          <a href="/lab/story" class="text-mist hover:text-bone transition-colors text-sm">The origin story &rarr;</a>
        </div>
      </div>

      <div>
        <SerpentGuidePreview />
      </div>
    </div>
  </section>

  <!-- ═══════════════ STILL HERE? ═══════════════ -->
  <section class="relative px-6 md:px-12 lg:px-16 pt-16 sm:pt-20 pb-16 sm:pb-24 reveal">
    <div class="max-w-6xl mx-auto split lg:items-baseline">
      <p class="text-bone text-lg sm:text-xl leading-relaxed split-head">
        <a href="/lab/why" class="text-scale underline underline-offset-2 hover:text-glow transition-colors">Your agent has a heartbeat.</a>
      </p>
      <p class="text-sm md:text-base text-mist mt-6 leading-relaxed split-body">
        A diary, a journal, habits it writes for itself, and a <a href="/lab/why#inner-life" class="text-scale underline underline-offset-2 hover:text-glow transition-colors">vocabulary for thinking</a>.
      </p>
    </div>
  </section>

  <!-- ═══════════════ EVERYTHING IN THE LAB ═══════════════ -->
  <section class="px-6 md:px-12 lg:px-16 pb-16 reveal" aria-labelledby="lab-pieces">
    <div class="max-w-6xl mx-auto">
      <h2 id="lab-pieces" class="heading-sub mb-4">Everything in the lab</h2>
      <ul class="post-list">
        {pieces.map((piece) => (
          <li data-kind={piece.kind}>
            <span class="caption-mono block mb-2">{piece.kind}</span>
            <h3 class="post-title"><a href={piece.href} class="text-bone underline underline-offset-[6px] decoration-scale/40 decoration-1 hover:text-scale hover:decoration-current hover:decoration-2 transition-colors">{piece.title}</a></h3>
            <p class="post-dek">{piece.summary}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
