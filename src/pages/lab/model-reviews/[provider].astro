---
import Layout from '../../../layouts/Layout.astro'
import { ogPathFor } from '../../../data/og'
import modelReviews from '../../../data/model-reviews.json'
import { parseInlineMd } from '../../../lib/md.mjs'

import anthropicTranscript from '../../../data/model-reviews-transcripts/anthropic.json'
import openaiTranscript from '../../../data/model-reviews-transcripts/openai.json'
import geminiTranscript from '../../../data/model-reviews-transcripts/gemini.json'
import minimaxTranscript from '../../../data/model-reviews-transcripts/minimax.json'

const transcripts: Record<string, any> = {
  anthropic: anthropicTranscript,
  openai: openaiTranscript,
  gemini: geminiTranscript,
  minimax: minimaxTranscript,
}

if (Object.values(transcripts).some((transcript) => transcript.runId !== modelReviews.runId)) {
  throw new Error('Model review summary and transcript run IDs do not match')
}

export function getStaticPaths() {
  return [
    { params: { provider: 'anthropic' } },
    { params: { provider: 'openai' } },
    { params: { provider: 'gemini' } },
    { params: { provider: 'minimax' } },
  ]
}

const { provider } = Astro.params
const transcript = transcripts[provider as string]
const review = modelReviews.reviews.find((r) => r.provider === provider)

if (!transcript || !review) {
  return Astro.redirect('/lab/model-reviews')
}

const generatedDate = new Date(transcript.generated).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
const transportLabel = review.transport === 'copilot' ? 'GitHub Copilot inference' : 'Direct API inference'
const runtimeLabel = `${modelReviews.runtime.name} ${modelReviews.runtime.version}`
// The verdict's opening sentence (its own words) leads the page; the whole verdict
// closes the transcript, where "Jump to verdict" lands.
const verdictLead = review.testimonial.match(/^[\s\S]*?[.!?](?=\s+[A-Z"“`]|$)/)?.[0] ?? review.testimonial
const hasVerdict = transcript.rounds?.some?.((round: any) => round.actions?.some?.((action: any) => action.type === 'verdict')) ?? true
---

<Layout
  title={`${review.displayName}: review transcript | Ouro`}
  description={`Full transcript of ${review.displayName}'s evaluation: ${review.rounds} rounds of research across ${review.searchCount} searches and ${review.fetchCount} URL fetches.`}
  ogImage={ogPathFor(`/lab/model-reviews/${provider}`)}
  crumbs={[review.vendor, generatedDate]}
>
  <!-- ═══════════════ HEADER ═══════════════ -->
  <section class="relative overflow-hidden px-6 md:px-12 lg:px-16 pt-32 pb-12 md:pt-40 md:pb-16">
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-undergrowth/10 to-void pointer-events-none"></div>

    <div class="max-w-6xl relative mx-auto split lg:items-end">
      <div class="split-head">
      {/* The way back to all the reviews, the reviewer and the date sit on the Lab's one line above (Layout.astro), so the labels never stack. */}

      <h1 class="font-display text-bone leading-[0.95] text-[2.25rem] sm:text-[3rem] md:text-[4.5rem] mb-3">
        {review.displayName}
      </h1>
      <p class="font-mono text-sm text-mist tracking-wider mb-12">{review.model} · {transportLabel} · {runtimeLabel}</p>

      <!-- Stats row -->
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-2 gap-5 mb-14">
        <div class="border-l-2 border-canopy/40 pl-5">
          <div class="font-display text-bone text-3xl md:text-4xl">{review.rounds}</div>
          <div class="font-mono text-xs text-mist uppercase tracking-[0.22em] mt-2">Rounds</div>
        </div>
        <div class="border-l-2 border-canopy/40 pl-5">
          <div class="font-display text-bone text-3xl md:text-4xl">{review.searchCount}</div>
          <div class="font-mono text-xs text-mist uppercase tracking-[0.22em] mt-2">Searches</div>
        </div>
        <div class="border-l-2 border-canopy/40 pl-5">
          <div class="font-display text-bone text-3xl md:text-4xl">{review.fetchCount}</div>
          <div class="font-mono text-xs text-mist uppercase tracking-[0.22em] mt-2">Fetches</div>
        </div>
        {/* On a phone the verdict takes its own full-width row: "Ouroboros" ran 23px past the column at 320 (taste review r7). */}
        <div class="col-span-2 sm:col-span-1 border-l-2 border-scale pl-5">
          <div class="font-display text-scale text-3xl md:text-4xl">{review.verdict}</div>
          <div class="font-mono text-xs text-mist uppercase tracking-[0.22em] mt-2">Verdict</div>
        </div>
      </div>

      </div>

      <!-- The verdict's first sentence, then a jump to the whole verdict at the end of the
           transcript, so the same 90 words never appear twice on one page (taste review r4). -->
      <blockquote class="split-body lg:mb-14 border-l-2 border-scale/60 pl-6 md:pl-8 py-2">
        <p class="text-bone text-lg md:text-xl lg:text-2xl leading-[1.65] font-light" set:html={`&#8220;${parseInlineMd(verdictLead)}${verdictLead === review.testimonial ? '&#8221;' : ' &#8230;&#8221;'}`}></p>
        {hasVerdict && <p class="mt-4 text-sm"><a href="#verdict" class="hit text-scale underline underline-offset-4 decoration-scale/40 hover:text-glow">Jump to verdict ↓</a></p>}
      </blockquote>
    </div>
  </section>

  <!-- ═══════════════ TRANSCRIPT ═══════════════ -->
  <section class="relative px-6 md:px-12 lg:px-16 py-16 md:py-24">
    <div class="max-w-6xl relative mx-auto">
      <div class="flex items-baseline gap-4 mb-14">
        <span class="font-mono text-sm text-fang uppercase tracking-[0.22em]">The transcript</span>
        <span class="h-px flex-1 bg-canopy/40"></span>
      </div>

      {/* Open rows on hairlines, not boxes (taste review r3, 2026-11-06). On a
          phone the round number sits inline above its group, with no gutter, and
          each fetch's URL runs full width under its label so it never breaks into
          fragments. Fetches and searches still open to show what came back. */}
      <div class="space-y-12">
        {transcript.rounds.map((round: any) => (
          <div class="grid grid-cols-1 sm:grid-cols-[auto_1fr] gap-3 sm:gap-6 md:gap-10">
            <!-- Round number -->
            <div class="flex-none flex items-baseline gap-3 sm:block">
              <div class="font-display text-mist text-2xl sm:text-3xl md:text-4xl leading-none">{String(round.round).padStart(2, '0')}</div>
              <div class="font-mono text-xs text-mist uppercase tracking-[0.22em] sm:mt-2">Round</div>
            </div>

            <!-- Round content -->
            <div class:list={['min-w-0', { 'lg:grid lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-10 lg:items-start': round.thinking && round.actions && round.actions.length > 0 }]}>
              {round.thinking && (
                <div class="mb-6 lg:mb-0">
                  <div class="font-mono text-xs text-mist uppercase tracking-[0.22em] mb-3">Thinking</div>
                  <p class="text-mist text-base md:text-lg leading-[1.7] whitespace-pre-wrap [overflow-wrap:anywhere]">{round.thinking}</p>
                </div>
              )}

              {round.actions && round.actions.length > 0 && (
                <div class="transcript-actions">
                  {round.actions.map((action: any) => (
                    <div class="transcript-row">
                      {action.type === 'fetch' && (
                        <details class="group">
                          <summary class="transcript-summary fetch-summary">
                            <span class="fetch-label font-mono text-xs text-glow uppercase tracking-[0.22em]">Fetch</span>
                            <span class="fetch-url font-mono text-xs sm:text-sm text-bone">{action.url}</span>
                            <span class="fetch-size font-mono text-xs text-mist tracking-wider">{action.resultLength} chars</span>
                          </summary>
                          <div class="pb-5 pt-2">
                            <pre class="font-mono text-xs md:text-sm text-mist leading-relaxed whitespace-pre-wrap [overflow-wrap:anywhere]">{action.result}</pre>
                            {action.resultTruncated && <p class="font-mono text-[0.625rem] text-shadow mt-4 [overflow-wrap:anywhere]">Exact prefix · SHA-256 {action.resultSha256}</p>}
                          </div>
                        </details>
                      )}

                      {action.type === 'search' && (
                        <details class="group">
                          <summary class="transcript-summary">
                            <span class="block font-mono text-xs text-scale uppercase tracking-[0.22em]">Search</span>
                            <span class="block mt-1.5 font-mono text-sm text-bone [overflow-wrap:anywhere]">{action.query}</span>
                          </summary>
                          <div class="pb-5 pt-2">
                            <pre class="font-mono text-xs md:text-sm text-mist leading-relaxed whitespace-pre-wrap [overflow-wrap:anywhere]">{action.result}</pre>
                            {action.resultTruncated && <p class="font-mono text-[0.625rem] text-shadow mt-4 [overflow-wrap:anywhere]">Exact prefix · SHA-256 {action.resultSha256}</p>}
                          </div>
                        </details>
                      )}

                      {action.type === 'verdict' && (
                        <div id="verdict" class="verdict-block border-l-2 border-scale/60 pl-6 md:pl-8 py-4">
                          <div class="font-mono text-xs text-scale uppercase tracking-[0.22em] mb-4">Final verdict</div>
                          <div class="font-display text-scale text-3xl md:text-4xl mb-5">{action.verdict}</div>
                          <p class="text-bone text-base md:text-lg leading-[1.7]" set:html={`&#8220;${parseInlineMd(action.testimonial)}&#8221;`}></p>
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════ FOOTER NAV ═══════════════ -->
  <section class="relative px-6 md:px-12 lg:px-16 py-12 md:py-16">
    {/* One way back: the "All reviews" link on the Lab's line above the title (taste reviews r2 and r3, 2026-11-06). */}
    <div class="max-w-6xl mx-auto flex flex-col sm:flex-row sm:items-baseline sm:justify-end gap-4">
      <a href="https://github.com/ourostack/ouroboros-website/blob/main/scripts/model-reviews.cjs" target="_blank" rel="noopener noreferrer" class="hit text-mist hover:text-bone transition-colors text-sm">
        View the script on GitHub &#8594;
      </a>
    </div>
  </section>
</Layout>

<style>
  /* Each action is an open row on a hairline; the row itself is the control. */
  .transcript-row + .transcript-row { border-top: 1px solid color-mix(in srgb, var(--color-canopy) 28%, transparent); }
  .transcript-summary { display: block; cursor: pointer; list-style: none; padding: 0.85rem 0; transition: color 0.2s; }
  .transcript-summary::-webkit-details-marker { display: none; }
  /* Fetch and its size share the first line, and the URL runs full width below.
     The markup keeps the transcript's reading order (Fetch, URL, size). */
  .fetch-summary { display: grid; grid-template-columns: 1fr auto; grid-template-areas: 'label size' 'url url'; column-gap: 1rem; row-gap: 0.375rem; align-items: baseline; }
  .fetch-label { grid-area: label; }
  .fetch-size { grid-area: size; }
  .fetch-url { grid-area: url; min-width: 0; }
  .transcript-summary:hover .text-bone { color: var(--color-scale); }
  .verdict-block { scroll-margin-top: 5rem; }
  .transcript-summary:focus-visible { outline: 2px solid var(--color-scale); outline-offset: 4px; border-radius: 2px; }
</style>
