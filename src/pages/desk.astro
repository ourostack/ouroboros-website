---
import Layout from '../layouts/Layout.astro'
import DeskBootPreview from '../components/DeskBootPreview.astro'
import DeskMedia from '../components/DeskMedia.astro'
import { ogPathFor } from '../data/og'
import { deskHosts, labelFor, allowedLabels } from '../data/readiness.mjs'
import { deskSetupUrl, factoryUrl, rfcUrl } from '../data/principles.mjs'

const title = 'Desk: where my agents keep their work | Ouroboros'
const description = 'Desk keeps the principles in the setup: your agent’s work lives in a Git repository you own, every job starts with one alignment conversation, and a job is done when you’ve seen it work. An alpha for Claude Code and GitHub Copilot CLI.'
const status = labelFor('desk-claude-code-macos')
// The three Claude Code hosts share the page's label, so they collapse into one row.
const otherHosts = deskHosts.filter((host) => !host.id.startsWith('desk-claude-code-'))
const supportPrompt = 'Something went wrong with Desk. Look at what happened in this session, then file a GitHub issue on ourostack/desk with the steps to reproduce it and the exact error. Show me the issue before you submit it.'
const link = 'text-scale underline underline-offset-4 decoration-scale/40 hover:text-glow transition-colors'
const card = 'rounded-2xl border border-canopy/40 bg-deep/70 p-6'
---

<Layout title={title} description={description} ogImage={ogPathFor('/desk')} canonical="https://ouroboros.bot/desk/">
  <section class="px-6 md:px-12 lg:px-16 pt-32 pb-10 md:pt-44">
    <div class="max-w-6xl mx-auto grid gap-10 lg:grid-cols-[1.2fr_1fr]">
      <div class="grid gap-5 content-start min-w-0">
        <span class={`tag ${status.tone} justify-self-start`}>{status.label}</span>
        <div class="flex items-center gap-4">
          <img src="/brand/desk-icon.svg" width="64" height="64" alt="" class="mark-tile w-14 h-14 md:w-16 md:h-16" />
          <h1 class="heading-lead">Desk</h1>
        </div>
        <p class="text-xl md:text-2xl text-bone font-display leading-snug max-w-[40ch]">Desk keeps my agents' work in a Git repository: every track, task, decision, and lesson. I can open any harness on any of my machines, ask "where were we?", and the agent knows.</p>
        <p class="text-lg text-mist leading-relaxed max-w-[52ch]">Every job starts with one conversation and a go, and ends with evidence you accept or send back. The full design is in <a href={rfcUrl} class={link}>Desk's design doc</a>.</p>

        <div class="grid gap-2">
          <span class="caption-mono">Give your agent</span>
          <pre id="desk-setup" class="agent-text">{`${deskSetupUrl}\nset this up`}</pre>
          <div class="flex flex-wrap items-center gap-3">
            <button type="button" data-copy-target="desk-setup" class="inline-flex items-center rounded-xl bg-bone text-void px-4 py-2.5 text-sm font-medium hover:bg-scale transition-colors"><span data-copy-label>Copy</span></button>
            <span class="sr-only">In words: give your agent {deskSetupUrl} and say "set this up".</span>
          </div>
        </div>
        <p class="text-sm text-mist">Setup also installs <a href="https://github.com/obra/superpowers" class={link}>Superpowers</a>, Jesse Vincent's skill set for coding agents. Desk asks once whether you'd like to send your sessions' timings to the public <a href={factoryUrl} class={link}>factory</a>. It sends timings and sizes, never your prompts, commands, or code.</p>
        <div class={card}>
          <h2 class="caption-mono mb-3">Known limits today</h2>
          <ul class="list-disc pl-5 grid gap-2 text-mist">
            <li>Desk's own browser starts signed out, and on macOS it can steal focus.</li>
            <li>We haven't yet tested a first install on a brand-new Mac account.</li>
            <li>Turning reported problems into fixes is built, and it hasn't been proven on real work yet.</li>
          </ul>
        </div>
      </div>

      <div class="grid gap-6 content-start min-w-0">
        <DeskMedia />
        <div class={card}>
          <h2 class="caption-mono mb-3">Where it runs</h2>
          <ul class="grid">
            <li class="flex flex-wrap items-center justify-between gap-2 py-3 border-b border-dashed border-canopy/50">
              <span class="text-bone">Claude Code<span class="block text-sm text-mist">macOS: tested daily. Linux: lightly tested. Windows: works, with rough edges</span></span>
              <span class={`tag ${status.tone}`}>{status.label}</span>
            </li>
            {otherHosts.map((host) => (
              <li class="flex flex-wrap items-center justify-between gap-2 py-3 border-b border-dashed border-canopy/50 last:border-b-0">
                <span class="text-bone">{host.name}<span class="block text-sm text-mist">{host.detail}</span></span>
                <span class={`tag ${allowedLabels[host.label]}`}>{host.label}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="px-6 md:px-12 lg:px-16 py-12 border-t border-canopy/15">
    <div class="max-w-3xl lg:max-w-6xl mx-auto grid gap-6 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-x-12 lg:items-start">
      <div class="grid gap-6 min-w-0">
        <h2 class="heading-sub">What a new session looks like</h2>
        <figure class="grid gap-3">
          <DeskBootPreview />
          <figcaption class="text-sm text-mist">A new session picks up where the last one left off. This is real output from Desk's session start, run on a sample desk.</figcaption>
        </figure>
      </div>
      <div class={`${card} grid gap-3 content-start min-w-0 lg:mt-14`}>
        <h2 class="heading-sub">Support goes through your agent</h2>
        <p class="text-mist">Give your agent this:</p>
        <pre id="desk-support" class="agent-text !text-xs">{supportPrompt}</pre>
        <button type="button" data-copy-target="desk-support" class="justify-self-start inline-flex items-center rounded-xl border border-canopy text-bone px-4 py-2 text-sm font-medium hover:border-scale hover:text-scale transition-colors"><span data-copy-label>Copy</span></button>
      </div>
    </div>
  </section>

</Layout>

