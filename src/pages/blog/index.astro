---
import Layout from '../../layouts/Layout.astro'
import PageHero from '../../components/PageHero.astro'
import { ogPathFor } from '../../data/og'
import StoryScene from '../../components/StoryScene.astro'
import { sceneFor } from '../../data/scenes.mjs'
import { posts, post } from '../../data/blog.mjs'

// Each post opens on its own scene; the index shows a small vignette of it
// beside the title (taste review r5), so the list reads as a walk through the world.
const sceneOf = (href: string) => sceneFor(href).hero

const title = 'Essays on agents | Ouro blog'
const description = 'Essays on agent experience, persistent agents, and software shaped for the thing inside it.'

const featured = [
  {
    title: 'Why Ouroboros',
    description: 'Why long-lived agents need better ergonomics if you want shared momentum.',
    href: '/lab/why/',
    tag: 'Essay',
    label: 'Start here',
  },
  {
    title: 'The origin story',
    description: 'How a plugin for my OpenClaw agent turned into a harness I built from scratch.',
    href: '/lab/story/',
    tag: 'Story',
    label: 'The timeline',
  },
]

// Each post's title comes from src/data/blog.mjs, the same title its page and
// /llms.txt carry, so the index never names a post differently. The line under
// it is the post's index dek where the copy deck gave it one.
// A title's closing abbreviation stays on the line with the term it names, so
// a phone never shows "(AX)?" alone (check:headings).
const phrased = (title: string) => {
  const m = title.match(/^(.*?\s)(\S+\s\S+\s\([^)]*\)\S*)$/)
  return m ? { head: m[1], tail: m[2] } : { head: title, tail: '' }
}

const essays = posts.filter((p) => p.kind !== 'Tutorial').map((p) => ({ ...p, href: p.route, description: p.dek ?? p.description }))

const link = 'text-scale underline underline-offset-4 decoration-scale/40 hover:text-glow hover:decoration-current hover:decoration-2 transition-colors'
const postLink = 'hit text-bone underline underline-offset-[6px] decoration-scale/40 decoration-1 hover:text-scale hover:decoration-current hover:decoration-2 transition-colors'

const tutorialPost = post('/blog/build-ai-agent-from-scratch/')
const tutorial = { ...tutorialPost, href: tutorialPost.route, description: tutorialPost.dek ?? tutorialPost.description }
---

<Layout
  title={title}
  description={description}
  ogImage={ogPathFor('/blog')}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Blog",
      "name": "Ouroboros blog",
      "description": description,
      "url": "https://ouroboros.bot/blog",
      "publisher": { "@type": "Person", "name": "Ari Mendelow", "url": "https://linkedin.com/in/arimendelow" }
    })} />
  </Fragment>

  <PageHero eyebrow="Blog" title="Dispatches from the serpent.">
    <Fragment slot="description">
      Essays on agent experience, persistent agents, and the problem of building software an agent can actually stay oriented inside.
    </Fragment>
  </PageHero>

  <!-- Recommended reading -->
  <section class="px-6 md:px-12 lg:px-16 pt-12 md:pt-8 pb-12 reveal">
    <div class="max-w-6xl mx-auto">
      <h2 class="heading-sub mb-4">Recommended reading</h2>
      <ul class="post-list">
        {featured.map(item => (
          <li>
            <span class="flex flex-wrap items-center gap-3 mb-2">
              <span class="font-mono text-xs text-scale uppercase tracking-[0.18em]">{item.tag}</span>
              <span class="font-mono text-xs text-glow uppercase tracking-[0.18em]">{item.label}</span>
            </span>
            <h3 class="post-title"><a href={item.href} class={postLink}>{item.title}</a></h3>
            <p class="post-dek">{item.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Tutorial -->
  <section class="px-6 md:px-12 lg:px-16 py-12 reveal">
    <div class="max-w-6xl mx-auto">
      <h2 class="heading-sub mb-4">Tutorial</h2>
      <ul class="post-list">
        <li class="post-with-scene">
          <a href={tutorial.href} class="post-scene" tabindex="-1" aria-hidden="true"><StoryScene scene={sceneOf(tutorial.href)} variant="vignette" alt="" sizes="(min-width: 768px) 8rem, (min-width: 360px) 5.5rem, 4rem" /></a>
          <div>
            <h3 class="post-title"><a href={tutorial.href} class={postLink}>{tutorial.title}</a></h3>
            <p class="post-dek">{tutorial.description}</p>
            <span class="post-byline">{tutorial.author}</span>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- Essays -->
  <section class="px-6 md:px-12 lg:px-16 py-12 reveal">
    <div class="max-w-6xl mx-auto">
      <h2 class="heading-sub mb-4">Essays</h2>
      <ul class="post-list">
        {essays.map(essay => (
          <li class="post-with-scene">
            <a href={essay.href} class="post-scene" tabindex="-1" aria-hidden="true"><StoryScene scene={sceneOf(essay.href)} variant="vignette" alt="" sizes="(min-width: 768px) 8rem, (min-width: 360px) 5.5rem, 4rem" /></a>
            <div>
              <h3 class="post-title"><a href={essay.href} class={postLink}>{phrased(essay.title).head}{phrased(essay.title).tail && <span class="t-ph">{phrased(essay.title).tail}</span>}</a></h3>
              <p class="post-dek">{essay.description}</p>
              <span class="post-byline">{essay.author}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Footer text -->
  <section class="px-6 md:px-12 lg:px-16 pt-8 pb-24 md:pb-36 reveal">
    <div class="max-w-6xl mx-auto">
      <p class="text-lg text-mist leading-relaxed">
        Read <a href="/lab/why/" class={link}>Why Ouroboros</a> for the core argument,
        or step into <a href="/lab/docs/" class={link}>the docs</a> if you want the operator path.
      </p>
    </div>
  </section>
</Layout>

