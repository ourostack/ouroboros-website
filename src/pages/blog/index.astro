---
import Layout from '../../layouts/Layout.astro'
import HeroCover from '../../components/HeroCover.astro'
import { ogPathFor } from '../../data/og'

const title = 'Essays on agents | Ouro blog'
const description = 'Essays on agent experience, persistent agents, and software shaped for the thing inside it.'

const featured = [
  {
    title: 'Why Ouroboros',
    description: 'Why long-lived agents need better ergonomics if you want shared momentum.',
    href: '/lab/why',
    tag: 'Essay',
    label: 'Start here',
  },
  {
    title: 'The origin story',
    description: 'How a plugin for my OpenClaw agent turned into a harness I built from scratch.',
    href: '/lab/story',
    tag: 'Story',
    label: 'The timeline',
  },
]

const essays = [
  {
    title: 'The work spoke back',
    description: 'The task scanner produced 184 false errors. Before patching the parser, we asked the agent living inside the system what was actually broken.',
    href: '/blog/designing-with-your-agent',
    author: 'Ari Mendelow & Slugger',
  },
  {
    title: 'Give your agent a home',
    description: 'Most agents live as scattered files across your filesystem. A bundle changes that. One folder, one identity, one place to back up and carry.',
    href: '/blog/give-your-agent-a-home',
    author: 'Ari Mendelow & Slugger',
  },
  {
    title: 'What is Agent Experience?',
    description: 'Why long-lived agents become users too: Agent Experience beside HX under UX, reorientation overhead, and shared momentum.',
    href: '/blog/what-is-agent-experience',
    author: 'Ari Mendelow',
  },
  {
    title: 'Stop being the glue',
    description: 'We were promised an intelligent assistant, and we got a fragmentation of semi-intelligent bots. How I stopped copy-pasting between my agents and started collaborating.',
    href: '/blog/stop-being-the-glue',
    author: 'Ari Mendelow',
  },
]

const link = 'text-scale underline underline-offset-4 decoration-scale/40 hover:text-glow hover:decoration-current hover:decoration-2 transition-colors'
const postLink = 'text-bone underline underline-offset-[6px] decoration-scale/40 decoration-1 hover:text-scale hover:decoration-current hover:decoration-2 transition-colors'

const tutorial = {
  title: 'Build an agent loop from scratch',
  description: 'A working agent in ~150 lines of TypeScript. Five milestones: first API call, streaming, multi-turn conversation, tools, and the agentic loop. Then the handoff — you stop talking to your coding agent and start talking to your creation.',
  href: '/blog/build-ai-agent-from-scratch',
  author: 'Ari Mendelow',
}
---

<Layout
  title={title}
  description={description}
  ogImage={ogPathFor('/blog')}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Blog",
      "name": "Ouroboros blog",
      "description": description,
      "url": "https://ouroboros.bot/blog",
      "publisher": { "@type": "Person", "name": "Ari Mendelow", "url": "https://linkedin.com/in/arimendelow" }
    })} />
  </Fragment>

  <HeroCover eyebrow="Blog">
    <Fragment slot="title">
      Dispatches from<br class="hidden sm:inline" /> the serpent.
    </Fragment>
    <Fragment slot="body">
      Essays on agent experience, persistent agents, and the problem of building software an agent can actually stay oriented inside.
    </Fragment>
  </HeroCover>

  <!-- Recommended reading -->
  <section class="px-6 md:px-12 lg:px-16 pt-4 md:pt-8 pb-12 reveal">
    <div class="max-w-6xl mx-auto">
      <h2 class="heading-sub mb-4">Recommended reading</h2>
      <ul class="post-list">
        {featured.map(item => (
          <li>
            <span class="flex flex-wrap items-center gap-3 mb-2">
              <span class="font-mono text-xs text-scale uppercase tracking-[0.18em]">{item.tag}</span>
              <span class="font-mono text-xs text-glow uppercase tracking-[0.18em]">{item.label}</span>
            </span>
            <h3 class="post-title"><a href={item.href} class={postLink}>{item.title}</a></h3>
            <p class="post-dek">{item.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Tutorial -->
  <section class="px-6 md:px-12 lg:px-16 py-12 reveal">
    <div class="max-w-6xl mx-auto">
      <h2 class="heading-sub mb-4">Tutorial</h2>
      <ul class="post-list">
        <li>
          <span class="font-mono text-xs text-scale uppercase tracking-[0.18em] block mb-2">Guide</span>
          <h3 class="post-title"><a href={tutorial.href} class={postLink}>{tutorial.title}</a></h3>
          <p class="post-dek">{tutorial.description}</p>
          <span class="post-byline">{tutorial.author}</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- Essays -->
  <section class="px-6 md:px-12 lg:px-16 py-12 reveal">
    <div class="max-w-6xl mx-auto">
      <h2 class="heading-sub mb-4">Essays</h2>
      <ul class="post-list">
        {essays.map(essay => (
          <li>
            <h3 class="post-title"><a href={essay.href} class={postLink}>{essay.title}</a></h3>
            <p class="post-dek">{essay.description}</p>
            <span class="post-byline">{essay.author}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Footer text -->
  <section class="px-6 md:px-12 lg:px-16 pt-8 pb-24 md:pb-36 reveal">
    <div class="max-w-6xl mx-auto">
      <p class="text-lg text-mist leading-relaxed">
        Read <a href="/lab/why" class={link}>Why Ouroboros</a> for the core argument,
        or step into <a href="/lab/docs" class={link}>the docs</a> if you want the operator path.
      </p>
    </div>
  </section>
</Layout>

