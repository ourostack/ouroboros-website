  html[data-shell-active="mac"] [data-shell-variant]:not([data-shell-variant="mac"]),
  html[data-shell-active="powershell"] [data-shell-variant]:not([data-shell-variant="powershell"]),
  html[data-shell-active="wsl"] [data-shell-variant]:not([data-shell-variant="wsl"]) { display: none; }
  .shell-commands { margin: 1.5rem 0; }
  .shell-control { margin-bottom: 0.75rem; }
  .shell-variant + .shell-variant { margin-top: 0.75rem; }
  html[data-shell-active] .shell-variant + .shell-variant { margin-top: 0; }
  [data-side-quest] { scroll-margin-top: 6rem; }
</style>

<style>
  .prose-ouro :global([data-ouro="code-block"]) { margin: 1.5rem 0; }
  .prose-ouro :global([data-expected-output]) { margin-bottom: 0.5rem; }
  .prose-ouro :global(.side-quest) { margin: 1.5rem 0; }
