  .trouble { overflow-x: auto; }
  .trouble table { width: 100%; min-width: 30rem; border-collapse: collapse; font-size: 1rem; line-height: 1.6; }
  .trouble th { text-align: left; font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-fang); font-weight: 400; padding: 0 1rem 0.6rem 0; border-bottom: 1px solid var(--color-canopy); }
  .trouble td { vertical-align: top; color: var(--color-mist); padding: 0.75rem 1rem 0.75rem 0; border-bottom: 1px solid color-mix(in srgb, var(--color-canopy) 50%, transparent); }
  .trouble td:first-child { color: var(--color-bone); width: 40%; }
