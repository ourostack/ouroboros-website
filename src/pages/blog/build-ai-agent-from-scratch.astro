---
import Layout from '../../layouts/Layout.astro'
import { post } from '../../data/blog.mjs'
import { ogPathFor } from '../../data/og'
import PromptCard from '../../components/PromptCard.astro'
import PostByline from '../../components/PostByline.astro'
import PageHero from '../../components/PageHero.astro'
import ShellCommands from '../../components/ShellCommands'
import { CodeBlock } from '../../components/ouro/code-block/code-block'
import { Card } from '../../components/ouro/card/card'
import { Kbd } from '../../components/ouro/kbd/kbd'
import agentsMdText from '../../../public/grow-an-agent/AGENTS.md?raw'
// What my terminal showed, captured from the run that built the starter (tmux, ANSI kept so thinking shows dimmed).
// Only blank-line runs and the shell's end-of-line marker are tidied; every word is as it appeared.
import outM1Raw from '../../data/grow-an-agent/outputs/m1.ansi?raw'
import outM2Raw from '../../data/grow-an-agent/outputs/m2.ansi?raw'
import outM3Raw from '../../data/grow-an-agent/outputs/m3.ansi?raw'
import outM4Raw from '../../data/grow-an-agent/outputs/m4.ansi?raw'
import outStartRaw from '../../data/grow-an-agent/outputs/s0.ansi?raw'
import outNameRaw from '../../data/grow-an-agent/outputs/h1.ansi?raw'
import outAgentsMdRaw from '../../data/grow-an-agent/outputs/ha.ansi?raw'
import outSystemMessageRaw from '../../data/grow-an-agent/outputs/h2.ansi?raw'
import outSkillRaw from '../../data/grow-an-agent/outputs/g2.ansi?raw'
import outDateToolRaw from '../../data/grow-an-agent/outputs/g3.ansi?raw'
import outMessagesExcerptText from '../../data/grow-an-agent/outputs/m2-what-the-model-sees.json.txt?raw'
// The starter's agent.ts, byte for byte as published in ourostack/my-agent (.txt so the site doesn't type-check it).
import starterCodeText from '../../data/grow-an-agent/agent.ts.txt?raw'
import { codeToTokens } from 'shiki'

// One title everywhere (taste review r2, 2026-11-06): the post's own headline.
// "Grow an agent" is the workshop's name; it lives in the eyebrow.
const { title: headline, description } = post('/blog/build-ai-agent-from-scratch/')
const title = `${headline} | Ouro`
const canonicalUrl = "https://ouroboros.bot/blog/build-ai-agent-from-scratch/"
const datePublished = "2026-03-01"
const dateModified = "2026-11-18"

const yt = "https://youtube.com/watch?v=YFjfBk8HI5o&t=9298"
const transcript = "https://lexfridman.com/peter-steinberger-transcript#how-openclaw-works"
const copilotDocs = "https://docs.github.com/en/copilot/how-tos/copilot-cli/set-up-copilot-cli/install-copilot-cli"

// The one program the reader grows.
const file = "agent.ts"
const run = `node ${file}`

// Who the reader is talking to. Never blur the two.
const toCoder = "Prompt the coding agent"
const toAgent = "Prompt your agent"

const makeFolder = "mkdir my-agent\ncd my-agent\ngit init"

// The note every agent working in my-agent reads first, served from public/ so the page shows exactly what readers download.
const agentsMd = agentsMdText.trimEnd()
const getAgentsMd = {
  mac: "curl -fsSO https://ouroboros.bot/grow-an-agent/AGENTS.md",
  powershell: "Invoke-WebRequest https://ouroboros.bot/grow-an-agent/AGENTS.md -OutFile AGENTS.md",
}
const starterCode = starterCodeText.trimEnd()
// Color agent.ts at build time with Shiki's TypeScript grammar, written as terminal colors so Ouro HX's
// CodeBlock (language="ansi") draws it in the theme's own palette, light and dark.
const tsColor = (scopes: string[]) => {
  const has = (prefix: string) => scopes.some((scope) => scope.startsWith(prefix))
  if (has('comment')) return '2'
  if (has('string')) return '32'
  if (has('keyword') || has('storage')) return '35'
  if (has('constant.numeric') || has('constant.language')) return '36'
  if (has('entity.name.function') || has('support.function')) return '34'
  if (has('entity.name.type') || has('support.class') || has('entity.name.class')) return '33'
  return null
}
const colorTs = async (code: string) => (await codeToTokens(code, { lang: 'ts', theme: 'github-dark', includeExplanation: true })).tokens
  .map((line) => line.map((token) => {
    const color = tsColor((token.explanation ?? []).flatMap((part) => part.scopes.map((scope) => scope.scopeName)))
    // A short punctuation token such as "{}" is held whole with word joiners, so a phone never wraps inside it.
    const content = /^[^A-Za-z0-9 ]{2,6}$/.test(token.content) ? [...token.content].join('\u2060') : token.content
    return color ? `\x1b[${color}m${content}\x1b[0m` : content
  }).join('')).join('\n')
const starterCodeColored = await colorTs(starterCode)

// Captures keep their escape codes, so the model's thinking shows dimmed; trailing
// blank lines and resets go.
const shown = (raw: string) => raw.replace(/(?:\s|\x1b\[[0-9;:]*m)+$/, '')
const outM1 = shown(outM1Raw)
const outM2 = shown(outM2Raw)
const outM3 = shown(outM3Raw)
const outM4 = shown(outM4Raw)
const outMessagesExcerpt = outMessagesExcerptText.trimEnd()
const outStart = shown(outStartRaw)
const outName = shown(outNameRaw)
const outAgentsMd = shown(outAgentsMdRaw)
const outSystemMessage = shown(outSystemMessageRaw)
const outSkill = shown(outSkillRaw)
const outDateTool = shown(outDateToolRaw)
const getStarter = "git clone https://github.com/ourostack/my-agent\ncd my-agent\nnpm install"
const gitIdentity = 'git config --global user.name "Your Name"\ngit config --global user.email "you@example.com"'
const versions = "git --version\nnode --version\ngh --version\ncopilot --version"

// The prompts, as the dry run used them (prompt-sequence.md), plus the asks for short,
// readable code added after the first workshop (2026-11-12), where Copilot wrote nearly
// 400 lines for the loop. They ask for outcomes, not steps; the page explains anything
// technical before each one.
const p = (...paragraphs: string[]) => paragraphs.join("\n\n")

const promptHello = p(
  "We're building a tiny agent together, from scratch, in one file called agent.ts. Build the agent part by hand: the only add-on should be the openai package, for talking to the model, with no ready-made agent kits.",
  "For the model, use my GitHub Copilot access through the gh CLI I'm signed in with: `gh auth token` gives the key, and `gh api /copilot_internal/user --jq .endpoints.api` gives the address. Use claude-opus-5.5 with reasoning effort set to max, and let it write up to 128,000 tokens, the most it allows.",
  "To start, send it one message, \"say hi in exactly five words\". Stream the reply so I can watch it think: print its thinking dimmed as it arrives, then what it says.",
  "Set up the folder however it needs, and tell me how to run it.",
)

const promptChat = p(
  "Turn agent.ts into a conversation in my terminal: I type after a `You:` prompt, it answers, and it remembers everything we've said. Keep its thinking as part of the conversation and send it back every time; never strip it.",
  "Every time you call the model, save the exact request you send to what-the-model-sees.json. When agent.ts starts, pick the conversation back up from that file, so it survives a restart.",
)

const promptTool = "Give the model one tool, read_file, for reading a text file. When the model asks to use it, show me exactly what it asked for, then actually read the file and show me what we got, but don't hand the result back to the model yet. I want to see it ask and then get stuck waiting."

const promptLoop = p(
  "Now close the loop. Run whatever tools the model asks for, hand back the results, and keep going until it answers without asking for anything. If the saved conversation is still waiting on a tool when agent.ts starts, run that tool first.",
  "Give it three tools: read_file, write_file, and shell, which runs a command in the same kind of shell I'm using right now, and in PowerShell 7 (pwsh) on Windows. Show me a short line each time a tool runs. Keep it from running away: cap the rounds, stop slow commands after 30 seconds, and cut very long tool output short. If a reply stops before it's finished, say why, so I know to ask it to carry on.",
)

const promptTidy = p(
  "Reread agent.ts as if you'd never seen it. Make it shorter and easier to follow without changing what it does: remove anything I didn't ask for, merge anything repeated, and make sure every important part has a short comment saying what it does and why. Run it to check it still works, then commit.",
  "The loop is the heart of it: someone reading agent.ts for the first time should be able to find it and follow it without help. Keep every tool description true on every platform, because the description is all the model knows.",
)

const promptName = "Read agent.ts. That's your own source code. Pick a name for yourself and show it where I'll see it, instead of \"agent\". Commit, and tell me when to restart you."

const promptSystem = "You don't have a system message yet: the standing instructions you read at the start of every conversation. I'd like you to write your own. First, ask me a few questions, one at a time, about who you're for and how I like to work. I'd suggest writing it in first person (\"I am…\"), the way you'd think to yourself: thoughts in your own head come in first person, and a \"you are…\" reads like someone else's orders. If you see it differently, tell me why. Then write it, make sure you read it at the start of every conversation, commit, and tell me when to restart."

const promptAgentsMd = "Read AGENTS.md. It's a note for any agent working in this folder, and most agents read it at the start of every conversation without being told. You don't yet. Make it so you read it every time you start, and follow it. Commit, and tell me when to restart."

const promptSkills = "Give yourself skills: instructions you pick up when a task needs them. Each skill gets its own folder inside a skills folder, holding a SKILL.md file that starts with the skill's name and one line on when to use it, then the instructions. When you start, read only those names and lines, so you know what you have; read a skill's full instructions only when a task calls for it. Write your first skill: how to add a new tool to yourself. Commit, and tell me when to restart."

const promptDate = "Use your skill to give yourself a tool that tells you the current date and time. Commit, and tell me when to restart."

const promptByok = "Switch agent.ts from my GitHub Copilot access to my own provider. I'll tell you which one, its address and the model. Keep my key out of the code and out of git, and tell me where to put it. Keep everything else the same. Commit when it works."


const promptBorrow = "Look through the skills at https://github.com/anthropics/skills. Pick one you think would help us, add it to your skills folder, and tell me why you picked it. Commit, and tell me when to restart."

// What my terminal showed when I followed this guide, copied from my dry run.
// A line holding only "…" marks text I left out; nothing else is changed or reworded.
const loopCode = `while (true) {
  const reply = await askModel(conversation)   // send everything so far
  conversation.push(reply)
  if (!reply.toolCalls) break                  // no requests: it has answered
  for (const call of reply.toolCalls) {
    conversation.push(await runTool(call))     // do it, hand back the result
  }
}`

const faq = [
  {
    q: "What is an agent loop?",
    a: "An agent loop is the cycle that makes an AI agent work: the model reads the conversation, decides on an action (like reading a file or running a command), your program runs it and hands back the result, and the model decides again. It repeats until the model answers without asking for anything. The loop turns a model that can only talk into an agent that can act.",
  },
  {
    q: "How do AI agents work?",
    a: "An AI agent is a language model with tools, inside a loop. To a model, a tool is just a name, a description and its parameters. The model can't run anything itself; it asks for a tool call, the program runs it and adds the result to the conversation, and the model goes again. Three tools, read file, write file and run shell, let an agent do almost anything a developer can do at a terminal, including change its own code.",
  },
  {
    q: "How many lines of code does it take to build an AI agent?",
    a: `The loop itself fits on one screen. Your whole agent lives in one file, ${file}, short enough to read in one sitting. Streaming, skills and everything else grow from there, written by the agent itself.`,
  },
  {
    q: "Do I need an API key?",
    a: "Not if you have GitHub Copilot. The agent in this guide calls the model through the GitHub CLI you're signed in with, using your Copilot plan. If you'd rather use your own key, most AI providers work.",
  },
  {
    q: "What tools does an AI agent need?",
    a: "At minimum, three: read file, write file and run a shell command. With file access and a shell, a model can install packages, run tests, call APIs and change code. You can add more later, and the agent can add them to itself.",
  },
]

const outputExempt = "program output, shown as evidence"
---

<Layout title={title} description={description} ogImage={ogPathFor('/blog/build-ai-agent-from-scratch')} canonical={canonicalUrl} ogType="article">

  <Fragment slot="head">
    <meta property="article:published_time" content={datePublished} />
    <meta property="article:modified_time" content={dateModified} />
    <meta property="article:author" content="Ari Mendelow" />
    <meta property="article:tag" content="AI agents" />
    <meta property="article:tag" content="agent loop" />
    <meta property="article:tag" content="TypeScript" />
    <meta name="author" content="Ari Mendelow" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TechArticle",
      "headline": "Just give the model a keyboard",
      "description": description,
      "author": {
        "@type": "Person",
        "name": "Ari Mendelow",
        "url": "https://github.com/arimendelow"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Ouro Labs",
        "url": "https://ouroboros.bot",
        "logo": {
          "@type": "ImageObject",
          "url": "https://ouroboros.bot/images/ouroboros.png"
        }
      },
      "datePublished": datePublished,
      "dateModified": dateModified,
      "mainEntityOfPage": canonicalUrl,
      "keywords": ["AI agent", "agent loop", "how to build an AI agent", "what is an agent loop", "how do AI agents work", "TypeScript agent", "LLM agent", "agentic AI", "workshop"],
      "inLanguage": "en",
      "isAccessibleForFree": true
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faq.map(({ q, a }) => ({
        "@type": "Question",
        "name": q,
        "acceptedAnswer": { "@type": "Answer", "text": a }
      }))
    })} />
    <!-- The reader's shell, before anything paints: saved choice, else a guess from the platform.
         Without JavaScript nothing is set, so every variant shows under its own caption. -->
    <script is:inline>
      try {
        var saved = localStorage.getItem('ouroboros-agent-loop-shell');
        document.documentElement.dataset.shellActive = saved === 'powershell' || saved === 'mac'
          ? saved
          : navigator.userAgent.indexOf('Windows') >= 0 ? 'powershell' : 'mac';
      } catch (e) {}
    </script>
  </Fragment>

  <PageHero eyebrow="Grow an agent" title="Just give the model a keyboard">
    <Fragment slot="description">
      <p class="m-0">How to build an agent from scratch, understand what an agent loop really is, and grow something that modifies its own code.</p>
      <PostByline authors={["Ari Mendelow"]} published={datePublished} updated={dateModified} />
    </Fragment>
  </PageHero>

  <article class="px-6 md:px-12 lg:px-16 pb-20">

    <div class="max-w-6xl mx-auto">

      <div class="prose-ouro">

        <aside class="post-note my-8">
          <p class="!mb-2 !text-base"><strong class="text-bone">TL;DR: What is an agent loop?</strong></p>
          <p class="!mb-2 !text-base">
            An <strong>agent loop</strong> is the core cycle that makes AI agents work: the model reads context, decides what action to take,
            executes it (reading a file, running a shell command, writing code), observes the result, and loops back, repeating
            until the task is done. Three tools, <strong>read file, write file, and run shell</strong>, are all it
            needs. With just these tools inside a loop, a language model can do almost anything a developer can. Including modify its own code.
          </p>
          <p class="!mb-0 !text-base">
            This guide walks you through building one from scratch, then handing the keyboard to
            your creation and watching it grow.
          </p>
        </aside>

        <p>
          I remember the feeling I got when writing software first clicked. I went from feeling "so what" about
          "hello world" to understanding that software engineering is, more than anything else, a pure expression
          of creation.
        </p>
        <p>
          As the way we build changes, I'm experiencing that same feeling all over again.
        </p>
        <p>
          Even though it's been at least a month since I've stopped writing code by hand, it didn't really click
          that we need to completely relearn the way we approach building software until I went through the
          "hello world" exercise of SWE in 2026: building an agent loop from scratch.
        </p>
        <p>
          This guide will give you that same moment.
        </p>
        <p>
          I'm not the only one who thinks so. Peter Steinberger, who built <a href="https://openclaw.ai">OpenClaw</a>,
          says everyone should build an agent loop at some point. He <a href={yt}>put it this way</a>:
        </p>
        <blockquote>It's like the Hello World in AI, you know? And it's actually quite simple.</blockquote>
        <p>
          He's right on both counts. (The <a href={transcript}>transcript</a> has the rest of that conversation.) In an hour
          or two you'll go from nothing to an agent that reads files, runs commands, picks its own name, writes its own
          instructions and teaches itself new skills. You'll watch every piece of it arrive. And at the end, you'll stop
          talking to the agent that built it, and start talking to the one you built.
        </p>

        <h2 id="how-we-do-this">How we'll do this</h2>
        <p>
          Most days I don't give my agents steps. I give them the outcome I want and trust them with the rest. That's
          <a href="/approach/">how I work</a>, and <a href="/blog/trust-the-agent/">why it works</a>. You could do that
          here too: tell a coding agent "make me an agent loop" and you'd have one in a minute.
        </p>
        <p>
          Today we walk it on purpose, one small piece at a time, so the architecture ends up in your head and not just in
          a file. A coding agent still writes every line. You steer, and you watch.
        </p>
        <p>
          One more thing is different from everyday work. Code that agents write for themselves tends to be long and
          dense, and nobody minds, because nobody reads it. Here you'll read every line, so before you start you'll leave
          your agents a note asking for short, plain code with comments that say why. If yours comes back long or hard to
          follow anyway, say so. It's your agent.
        </p>
        <p>
          Every output on this page is real. It's what my terminal showed when I followed this guide myself. In those
          outputs, <code>%</code> is my terminal's prompt; don't type it.
        </p>

        <h2>The shape of what's coming</h2>
        <p><strong>Phase 1: The bootstrap.</strong> You'll direct a coding agent to build the smallest agent that works, one piece at a time:</p>
        <ol>
          <li>A first hello, with the model's thinking on show</li>
          <li>A conversation it remembers</li>
          <li>One tool it can ask for</li>
          <li>The loop (it keeps going until it decides it's done)</li>
        </ol>
        <p>That's it. That's the bootstrap.</p>
        <p><strong>Phase 2: The handoff.</strong> You run your agent. You start talking to <em>it</em>. It names itself, learns to read the note you left for agents, and writes its own instructions.</p>
        <p>
          <strong>Phase 3: Growing together.</strong> You and your agent build it out together. It builds itself a skills
          system, then uses a skill to give itself a new tool. Watch capability compound.
        </p>
        <p>On your own, the main path takes about an hour. In a group, with everyone reading along and asking questions, plan on two. By the end, you'll have something substantive, and you'll have built it the new way.</p>
        <p>Short on time? Milestone 4, the loop, is the finish line. Everything after it is the fun bit you can finish at home.</p>
        <aside id="start-here-signpost" class="post-note my-8">
          <p class="!mb-0 !text-base">
            <strong class="text-bone">Here for the second half?</strong> Do the setup below, then
            <a href="#start-from-the-loop">start from the loop</a>: a copy of the agent the first half builds, ready to run.
          </p>
        </aside>

        <h2 id="before-you-start">Before we start</h2>
        <p>
          You'll need a GitHub account with Copilot, and about ten minutes to set up. If you've never used a command line,
          you're in exactly the right place. If you're joining a workshop, do this part beforehand.
        </p>
        <p>
          Have more than one GitHub account? Sign in to the one you'll use and check that
          <a href="https://github.com/settings/copilot">github.com/settings/copilot</a> shows you have Copilot.
        </p>

        <h3>Your terminal</h3>
        <p>
          Everything today happens in a terminal: a window where you type commands instead of clicking. Here's how to open
          one:
        </p>
        <ul>
          <li><strong>macOS:</strong> open Spotlight with Command-Space, type <code>Terminal</code>, and press Return.</li>
          <li><strong>Windows:</strong> click Start, type <code>PowerShell</code>, and open it. Copilot CLI needs PowerShell 7 or later: run <code>$PSVersionTable.PSVersion</code>, and the first number should be 7. If it isn't, run <code>winget install Microsoft.PowerShell</code> once (winget is Windows' built-in app installer), then open PowerShell 7 instead.</li>
          <li><strong>WSL</strong> (Windows Subsystem for Linux)<strong>:</strong> if you already use Linux on Windows, open your WSL terminal and install everything below inside it.</li>
        </ul>
        <p>
          To run a command, paste it into the terminal with <Kbd client:visible keys={["mod", "v"]} /> and press
          <Kbd client:visible keys={["enter"]} />. In PowerShell, right-click also pastes; in some WSL terminals it's
          <Kbd client:visible keys={["ctrl", "shift", "v"]} />. When a box shows a few lines, run them one at a time. Where your shell
          needs something different, pick it once and the whole page follows.
        </p>

        <h3 id="command-line-or-chat-box">Command line or chat box?</h3>
        <p>
          Today you'll type into two different kinds of box that look alike in a terminal, and mixing them up is the most
          common way to get lost:
        </p>
        <ul>
          <li>
            <strong>A command line runs commands.</strong> It's what a new terminal shows: a short prompt, such as
            <code>%</code> on a Mac or <code>PS C:\Users\you&gt;</code> in PowerShell, waiting for a command. Type
            <code>node agent.ts</code> here and your agent runs.
          </li>
          <li>
            <strong>A chat box sends a message.</strong> Some programs draw their own screen inside the terminal, called a
            TUI (terminal user interface). Copilot CLI is one: the line at the bottom of its screen, between two bars, is a
            chat box. Whatever you type there goes to Copilot as a message. Type <code>node agent.ts</code> there and you've
            only told Copilot about it.
          </li>
        </ul>
        <p>
          So you'll keep two terminal windows: one with Copilot's chat box, and one with a command line where you run your
          agent. A program that finishes drops you back at the command line. To leave one that's still running, press
          <Kbd client:visible keys={["ctrl", "c"]} />; Copilot may need it twice. Your own agent will have a chat box too:
          its <code>You:</code> line.
        </p>
        <p>On Windows, use PowerShell, not Command Prompt (<code>cmd</code>). They look alike, but this page's commands are for PowerShell.</p>

        <h3>Install four things</h3>
        <ul>
          <li><strong>Node.js</strong>, version 22.18 or later, from <a href="https://nodejs.org">nodejs.org</a>. It runs the agent you're about to build. On WSL, use the site's Linux instructions (its download page offers nvm), which need no <code>sudo</code>.</li>
          <li><strong>Git</strong>, from <a href="https://git-scm.com">git-scm.com</a>. On a Mac, run <code>git --version</code> once and accept the offer to install the developer tools. On Windows, run <code>winget install Git.Git</code>. WSL usually has it already.</li>
          <li><strong>The GitHub CLI</strong>, from <a href="https://cli.github.com">cli.github.com</a>. Your agent uses it to reach a model with your Copilot access.</li>
          <li><strong>GitHub Copilot CLI</strong>, the coding agent that builds the first version with you:</li>
        </ul>
        <ShellCommands client:load mac="npm install -g @github/copilot" powershell="winget install GitHub.Copilot" />
        <p>
          Copilot CLI's <a href={copilotDocs}>install guide</a> has every other way to get it. When you're done, close the
          terminal and open a new one, so it can find what you just installed.
        </p>
        <p>To check you're ready, run these one at a time. Each should print a version number:</p>
        <CodeBlock client:load code={versions} language="shell" title="terminal" wrap />

        <h3>Sign in and make a home</h3>
        <p>Sign in to GitHub from the terminal:</p>
        <CodeBlock client:load code="gh auth login" language="shell" title="terminal" />
        <p>
          It asks a few questions. Pick GitHub.com (or your company's GHE.com host, if that's where your Copilot lives),
          then HTTPS, then Yes, then Login with a web browser. Copy the one-time code it shows, press
          <Kbd client:visible keys={["enter"]} />, and paste the code into the browser page that opens.
        </p>
        <p>Now make a folder for your agent, move into it and make it a git repo, one line at a time:</p>
        <CodeBlock client:load code={makeFolder} language="shell" title="terminal" wrap />
        <p>
          Git keeps every version of every file, so any change an agent makes can be seen and undone. Each commit is a
          saved snapshot of your files. Your agent will soon run any command it likes in here, so keep nothing private in
          this folder.
        </p>
        <p>Tell git who you are, so your commits carry your name. Use your own name and email:</p>
        <CodeBlock client:load code={gitIdentity} language="shell" title="terminal" wrap />
        <p>
          Last, leave a note for the agents that will work here. <code>AGENTS.md</code> is a file of instructions for any
          agent working in a folder, and most general-purpose agents, Copilot included, read it on their own at the start of
          every conversation. (<a href="https://agents.md/">agents.md</a> has the details.) Agents left alone write long,
          dense code; this note asks for code short and plain enough for you to read every line. Download it into your
          folder:
        </p>
        <ShellCommands client:load mac={getAgentsMd.mac} powershell={getAgentsMd.powershell} />
        <CodeBlock client:load code={agentsMd} language="markdown" title="AGENTS.md" copy={false} data-copy-exempt="the file the command above downloads" wrap />
        <p>Start your coding agent:</p>
        <CodeBlock client:load code="copilot" language="shell" title="terminal" />
        <p>
          When it asks whether you trust the files in this folder, say yes: it shows a short numbered menu, so press
          <Kbd client:visible keys={["enter"]} /> on Yes (or type its number). If it asks you to sign in, type
          <code>/login</code> and follow along. Keep this window open: it's your coding agent, an agent someone else built.
        </p>
        <p>
          Last, a text editor, so you can open files side by side with your terminal. Any editor works;
          <a href="https://zed.dev">Zed</a> is a light, fast one.
        </p>
        <p>You're ready. If something goes wrong along the way, start here:</p>

        <div id="troubleshooting" class="trouble my-6" role="region" aria-label="If something goes wrong" tabindex="0">
          <table>
            <thead>
              <tr><th scope="col">You see</th><th scope="col">Try</th></tr>
            </thead>
            <tbody>
              <tr>
                <td><code>401</code></td>
                <td>Your GitHub sign-in has lapsed. Run <code>gh auth login</code>, then run your agent again.</td>
              </tr>
              <tr>
                <td><code>403</code> or <code>404</code></td>
                <td>This GitHub account has no Copilot. If another of yours does, switch to it with <code>gh auth switch</code>.</td>
              </tr>
              <tr>
                <td><code>400</code>, model not supported</td>
                <td>Your Copilot plan doesn't include that model. Ask your coding agent to switch to one your plan has.</td>
              </tr>
              <tr>
                <td><code>copilot</code>, <code>gh</code> or <code>git</code> not found</td>
                <td>Close the terminal and open a new one. Still missing? Install it again; WSL needs its own copy.</td>
              </tr>
              <tr>
                <td>Node can't run a <code>.ts</code> file</td>
                <td>Your Node is older than 22.18. Install the current one from nodejs.org, then open a new terminal.</td>
              </tr>
              <tr>
                <td><code>EACCES</code> while installing</td>
                <td>
                  Don't use <code>sudo</code>. On macOS or WSL, install Copilot CLI without npm:
                  <code>curl -fsSL https://gh.io/copilot-install | bash</code> (answer <code>y</code> if it offers to add
                  itself to your PATH), or <code>brew install --cask copilot-cli</code> if you use Homebrew. Then open a new
                  terminal. Or fix npm's folder permissions with its own guide:
                  <a href="https://docs.npmjs.com/resolving-eacces-permissions-errors-when-installing-packages-globally">resolving EACCES permissions errors</a>.
                </td>
              </tr>
              <tr>
                <td><code>quota exceeded</code></td>
                <td>This GitHub account has used up its Copilot allowance for now. If another of yours has Copilot, switch to it with <code>gh auth switch</code>, then run your agent again.</td>
              </tr>
              <tr>
                <td>It can't find <code>secret.txt</code>, or keeps trying</td>
                <td>Check the file's name and folder: <code>secret.txt</code>, not <code>secrets.txt</code>, in the same folder as <code set:text={file} />.</td>
              </tr>
              <tr>
                <td>A reply stops partway, or says it was filtered</td>
                <td>Copilot's content filter sometimes stops a long reply early. Your conversation is saved; say "keep going" and it picks up where it left off.</td>
              </tr>
              <tr>
                <td>Your agent won't start after it changed itself</td>
                <td>It can't fix itself if it can't run. Ask Copilot, in the other window, to fix <code set:text={file} />.</td>
              </tr>
              <tr>
                <td>PowerShell rejects <code>&amp;&amp;</code></td>
                <td>Older Windows PowerShell has no <code>&amp;&amp;</code>. Run the commands one line at a time, or open PowerShell 7.</td>
              </tr>
