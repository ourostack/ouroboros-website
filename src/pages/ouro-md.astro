---
import Layout from '../layouts/Layout.astro'
import OuroMdMedia from '../components/OuroMdMedia.astro'
import { ogPathFor } from '../data/og'
import { ouroMdInstall } from '../data/principles.mjs'
import { ouroMdDownload } from '../data/ouro-md-release.mjs'

const title = 'Ouro MD: Markdown that renders as you type | Ouro'
const description = 'A native macOS Markdown editor. Your agent’s plans and notes show as a document, update live when the agent edits them, and mark what changed.'
const link = 'text-scale underline underline-offset-4 decoration-scale/40 hover:text-glow hover:decoration-current hover:decoration-2 transition-colors'
---

<Layout title={title} description={description} ogImage={ogPathFor('/ouro-md')} canonical="https://ouroboros.bot/ouro-md/">
  <section class="px-6 md:px-12 lg:px-16 pt-32 pb-10 md:pt-44">
    <div class="max-w-6xl mx-auto md-hero">
      <div class="grid gap-5 content-start min-w-0 split-head hero-copy md-copy">
        <div class="flex items-center gap-4">
          <img src="/brand/ouro-md-icon.png" width="64" height="64" alt="" class="mark-tile w-14 h-14 md:w-16 md:h-16" />
          <h1 class="heading-lead">Ouro MD</h1>
        </div>
        <p class="product-lede" data-hero-lede>My agents write their plans and reports in Markdown. Ouro MD is a Mac editor made for reading them: it renders as you type, and marks exactly what changed when an agent edits.</p>
        <div class="btn-row" data-primary-action>
          <a href={ouroMdDownload} class="btn-primary">Download for Mac &rarr;</a>
          <span class="text-sm text-mist">macOS 15 or later. Signed, notarized, updates itself.</span>
        </div>
      </div>
      <p class="md-aside text-lg text-mist leading-relaxed">When a document needs to leave the screen, Ouro MD prints it or saves a PDF from a preview where you set the margins, type size, line spacing, paper, and which headings start a new page.</p>
      <div class="min-w-0 split-body hero-media"><OuroMdMedia only="agent" /></div>
    </div>
  </section>

  <section class="px-6 md:px-12 lg:px-16 pt-[3.25rem] md:pt-4">
    <div class="max-w-6xl mx-auto grid gap-5 split">
      <div class="grid gap-2 min-w-0 split-head">
        <h2 class="heading-sub">Or install in Terminal</h2>
        <pre id="ouro-md-install" class="agent-text">{ouroMdInstall}</pre>
        <div class="flex flex-wrap items-center gap-3">
          <button type="button" data-copy-target="ouro-md-install" class="btn-ghost !py-2 text-sm"><span data-copy-label>Copy</span></button>
          <span class="text-sm text-mist">Also adds an <code class="font-mono">md</code> shell alias.</span>
        </div>
      </div>
      <div class="grid gap-5 lg:gap-8 content-start min-w-0 split-body lg:pt-6">
        <p class="text-mist">Every feature, theme and export is on <a href="/ouro-md/download/" class={link}>the download page</a>.</p>
        <p class="text-sm text-mist">Builds from the installer or the download page send anonymous usage telemetry (you can turn it off in Settings). The <a href="/privacy/" class={link}>privacy page</a> says what's sent.</p>
        <p class="text-mist pt-3 lg:pt-0">To report a problem, ask your agent to file an issue on <a href="https://github.com/ourostack/ouro-md/issues" class={link}>github.com/ourostack/ouro-md</a>.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* The hero: the words, the print note and the recording. The recording is
     never wider than its own 840px (global.css), so wherever the hero runs
     the full column it sits beside the print note instead of stretching
     across the page (Ari, 2026-11-09: "never designed to be so large").
     Phone: words, note, recording. From 1280 on a tall screen: words and
     note on the left, the recording on the right. Stacked (1024 to 1279, and
     the short laptops where every product hero stacks for its primary
     action, the query in global.css): the words across, then the recording
     with the note beside it. */
  .md-hero { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-areas: "copy" "aside" "media"; gap: 1.25rem 4rem; }
  .md-copy { grid-area: copy; }
  .md-aside { grid-area: aside; margin: 0; }
  .md-hero > .hero-media { grid-area: media; margin-top: 0.75rem; }
  @media (min-width: 1024px) {
    .md-hero { grid-template-columns: minmax(0, 840px) minmax(16rem, 1fr); grid-template-areas: "copy copy" "media aside"; row-gap: 2.5rem; align-items: center; }
    .md-hero > .hero-media { margin-top: 0; }
    .md-copy { align-self: start; }
  }
  @media (min-width: 1280px) {
    .md-hero { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); grid-template-rows: auto 1fr; grid-template-areas: "copy media" "aside media"; row-gap: 1.25rem; align-items: start; }
    .md-hero > .hero-media { justify-self: end; width: 100%; max-width: 840px; }
  }
  /* From 2000px the 7/12 column is wider than the recording, so the words take
     the rest and the recording keeps the column's right edge, with no gap
     opening between them. */
  @media (min-width: 2000px) {
    .md-hero { grid-template-columns: minmax(0, 1fr) minmax(0, 840px); }
  }
  /* The short laptops, and 1280x800, where the 5/12 column would wrap the
     lede so far that Download slipped within 20px of the fold. */
  @media (min-width: 1280px) and (max-height: 960px) and (min-aspect-ratio: 33 / 20), (min-width: 1280px) and (max-height: 820px) {
    .md-hero { grid-template-columns: minmax(0, 840px) minmax(16rem, 1fr); grid-template-rows: none; grid-template-areas: "copy copy" "media aside"; row-gap: 2.5rem; align-items: center; }
    .md-hero > .hero-media { justify-self: stretch; }
  }
</style>

