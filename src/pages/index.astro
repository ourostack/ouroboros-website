  @media (min-width: 768px) { .molt-line { width: 8rem; } }
  .origin-body { display: grid; gap: 1.25rem; margin-top: 2.5rem; font-size: 1.125rem; line-height: 1.7; color: var(--color-mist); }
  .starts { display: grid; }
  .start { display: flex; flex-direction: column; align-items: flex-start; gap: 0.35rem; padding: 1.1rem 0; border-top: 1px solid color-mix(in srgb, var(--color-canopy) 60%, transparent); transition: color 0.2s; }
  .starts li:last-child .start { border-bottom: 1px solid color-mix(in srgb, var(--color-canopy) 60%, transparent); }
  .start-q { font-family: var(--font-display); font-size: 1.5rem; line-height: 1.2; color: var(--color-bone); transition: color 0.2s; }
  @media (min-width: 768px) { .start-q { font-size: 1.875rem; } }
  .start-a { font-size: 1rem; color: var(--color-scale); white-space: nowrap; transition: transform 0.2s; }
  .start:hover .start-q { color: var(--color-scale); }
  .start:hover .start-a { transform: translateX(0.25rem); }
  .tools { display: grid; gap: 4.5rem; margin-top: 3.5rem; }
  @media (min-width: 1024px) { .tools { gap: 5rem; margin-top: 5rem; } }
  /* Stacked, a tool's demo leads it: its caption keeps the site's section rhythm (2.5rem) above the tool's name, so the caption never reads as the name's label (taste review r19). */
  .tool { display: grid; gap: 2.5rem; align-items: center; }
  /* Side by side, the copy starts level with the top of its demo. */
  @media (min-width: 1024px) {
    .tool { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); column-gap: 4rem; align-items: start; }
    .tool-copy { padding-top: 1.5rem; }
