---
import Layout from '../layouts/Layout.astro'
import DeskMedia from '../components/DeskMedia.astro'
import OuroMdMedia from '../components/OuroMdMedia.astro'
import OuroHxMedia from '../components/OuroHxMedia.astro'
import ShepherdMedia from '../components/ShepherdMedia.astro'
import FriendsMedia from '../components/FriendsMedia.astro'
import SourceTree from '../components/SourceTree.astro'
import { ogPathFor } from '../data/og'
import { principles, smells, factoryUrl, deskSetupUrl } from '../data/principles.mjs'
import { labelFor } from '../data/readiness.mjs'
import { acts } from '../data/acts.mjs'
import ActBody from '../components/ActBody.astro'

// Every visible word on this page is transcribed from the copy deck
// (ouroboros.bot homepage, 2026-10-11). Builders never write copy here.
const title = 'How do you effectively collaborate with agents? | Ouroboros'
const description = "Hello!! I'm Ari. I build products that help humans and agents do more together. This is my workshop: the tools I've built for working with agents, how I use them, and where it all started."

const deskLabel = labelFor('desk-claude-code-macos')
const hxLabel = labelFor('ouro-hx')
const shepherdLabel = labelFor('shepherd')
const friendsLabel = labelFor('friends')
const ouroMdPage = '/ouro-md/'
const link = 'text-scale underline underline-offset-4 decoration-scale/40 hover:text-glow transition-colors'
const section = 'relative px-5 sm:px-6 md:px-12 lg:px-16 py-14 md:py-24 border-t border-canopy/20 reveal'


const lean = [
  { text: 'In most processes, less than a tenth of the elapsed time adds value. The rest is waiting and moving, so making the work itself 50% faster shortens the whole by 5% at most.', sources: [{ label: 'Fiume, Lean Enterprise Institute', href: 'https://www.lean.org/the-lean-post/articles/why-lean-is-a-time-based-strategy/' }] },
  { text: 'Taiichi Ohno described the Toyota Production System as watching the timeline from order to cash and shrinking it by removing the waste.', sources: [{ label: 'as quoted by Liker and others', href: 'https://www.goodreads.com/quotes/7427458-all-we-are-doing-is-looking-at-the-time-line' }] },
  { text: 'Toyota built it on "respect for people and continuous improvement," and on making work easier for the worker.', sources: [{ label: 'The Toyota Way', href: 'https://en.wikipedia.org/wiki/The_Toyota_Way' }, { label: 'Toyota', href: 'https://global.toyota/en/company/vision-and-philosophy/production-system/' }] },
  { text: 'Any worker can stop the line, and before anything changes, someone goes to see the real problem where it happened.', sources: [{ label: 'andon, LEI', href: 'https://www.lean.org/lexicon-terms/andon/' }, { label: 'genchi genbutsu, LEI', href: 'https://www.lean.org/lexicon-terms/genchi-genbutsu/' }] },
]

const wastes = [
  ['Waiting', 'An agent stops to ask what you could have told it up front.'],
  ['Defects', 'Work that comes back broken.'],
  ['Overprocessing', 'Polish nobody asked for.'],
  ['Overproduction', 'Building before anyone needs it.'],
  ['Motion', 'Re-reading and re-searching what was already known.'],
  ['Inventory', 'Half-finished branches and pull requests piling up.'],
  ['Transportation', 'Carrying context by hand from one tool to the next.'],
  ['Unused talent', 'A human doing what an agent could, or an agent kept from what it could do.'],
]
---

<Layout title={title} description={description} ogImage={ogPathFor('/')} canonical="https://ouroboros.bot/">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "How do you effectively collaborate with agents?",
      "url": "https://ouroboros.bot/",
      "author": { "@type": "Person", "name": "Ari Mendelow", "url": "https://mendelow.me" },
      "dateModified": "2026-10-11"
    })} />
  </Fragment>

  <!-- 1. Hero -->
  <section class="relative overflow-hidden px-5 sm:px-6 md:px-12 lg:px-16 pt-28 pb-12 md:pt-36 md:pb-20">
    <div class="absolute top-10 -right-40 w-[520px] h-[520px] rounded-full bg-scale/10 blur-[140px] pointer-events-none" aria-hidden="true"></div>

    <div class="hero relative max-w-6xl mx-auto">
      <h1 class="hero-title heading-hero animate-fade-up">How do you effectively collaborate with <span class="text-scale">agents?</span></h1>
      <p class="hero-sub text-lg md:text-2xl text-bone leading-snug animate-fade-up stagger-1">Hello!! I'm Ari. I build products that help humans and agents do more together. This is my workshop: the tools I've built for working with agents, how I use them, and where it all started.</p>
      <a href="https://mendelow.me" class="hero-pic portrait group animate-fade-up stagger-2">
        <img src="/images/workshop/ari-portrait.jpg" width="600" height="824" alt="Ari Mendelow, smiling, in a navy blazer on a grassy overlook above a river gorge." class="portrait-img" fetchpriority="high" />
        <span class="text-sm md:text-base text-bone group-hover:text-scale transition-colors whitespace-nowrap">More about me &#8599;</span>
      </a>
    </div>
  </section>

  <!-- 2. Built for humans and agents -->
  <section class={section} aria-labelledby="built-heading">
    <div class="max-w-6xl mx-auto">
      <h2 id="built-heading" class="heading-section">Things I've built</h2>
      <p class="dek">Tools I made for working with agents, and one product I rebuilt with them.</p>

      <div class="products">
        <article class="product" id="ouroboros">
          <figure class="product-figure">
            <div class="product-media media-terminal"><SourceTree /></div>
            <figcaption class="product-caption">A heart, a mind, nerves, and senses: the real source folders, named so the agent can find its way around its own body.</figcaption>
          </figure>
          <h3 class="product-title"><img src="/brand/ouro-render.webp" srcset="/brand/ouro-render-128.webp 128w, /brand/ouro-render-256.webp 256w, /brand/ouro-render.webp 1024w" sizes="36px" width="40" height="40" alt="" loading="lazy" decoding="async" class="mark-render w-9 h-9" />Ouroboros</h3>
          <p class="text-mist leading-relaxed">This is the agent harness I built from scratch, and it's where I test what agents need. It gives a personal agent an identity, memory that lasts, real tools, and the channels I already use. Building it, I watched closely how my agent used what I gave it. Did it pick the right tool and finish the job without getting confused? When it didn't, I asked it why and changed the design. That habit is what I call Agent Experience.</p>
          <p class="product-links"><a href="/lab/" class={link}>The harness &rarr;</a> <a href="/blog/what-is-agent-experience/" class={link}>What is Agent Experience? &rarr;</a></p>
        </article>

        <article class="product" id="desk">
          <DeskMedia />
          <h3 class="product-title"><img src="/brand/desk-render.webp" srcset="/brand/desk-render-128.webp 128w, /brand/desk-render-256.webp 256w, /brand/desk-render.webp 1024w" sizes="36px" width="40" height="40" alt="" loading="lazy" decoding="async" class="mark-render w-9 h-9" />Desk</h3>
          <p class="text-mist leading-relaxed">Desk keeps my agents' work in a Git repository: every track, task, decision, and lesson. I can open any harness on any of my machines, ask "where were we?", and the agent knows.</p>
          <p class="product-links"><a href="/desk/" class={link}>Desk &rarr;</a></p>
        </article>

        <article class="product product-wide product-split" id="ouro-md">
          <OuroMdMedia />
          <h3 class="product-title"><img src="/brand/ouro-md-icon.png" width="40" height="40" alt="" loading="lazy" decoding="async" class="mark-tile w-9 h-9" />Ouro MD</h3>
          <p class="text-mist leading-relaxed">A Markdown editor for the Mac that renders as you type. My agents write their plans, reports, and docs in Markdown, and Ouro MD is made for reading them, leaving notes for them, and seeing exactly what changed when they edit.</p>
          <p class="product-links"><a href="/ouro-md/" class={link}>Ouro MD &rarr;</a></p>
        </article>

        <article class="product product-wide hx-product" id="ouro-ui">
          <OuroHxMedia />
          <div class="hx-copy">
            <h3 class="product-title">Ouro UI</h3>
            <div class="hx-name">
              <img src="/brand/ouro-hx-render.webp" srcset="/brand/ouro-hx-render-128.webp 128w, /brand/ouro-hx-render-256.webp 256w, /brand/ouro-hx-render.webp 1024w" sizes="48px" width="48" height="48" alt="" loading="lazy" decoding="async" class="mark-render w-12 h-12" />
              <h4 class="heading-sub">Ouro HX</h4>
              <span class={`tag ${hxLabel.tone}`}>{hxLabel.label}</span>
            </div>
            <p class="text-mist leading-relaxed">Ouro UI is the home for my interface work. Ouro HX is the component library I'm building for the humans using an interface and the agents building it.</p>
            <p class="text-mist leading-relaxed">Ouro AX is still being defined.</p>
            <p class="product-links"><a href="https://ourostack.github.io/ouro-ui/docs/" class={link}>Ouro HX components &#8599;</a> <a href="https://github.com/ourostack/ouro-ui" class={link}>Source &#8599;</a></p>
          </div>
        </article>

        <article class="product product-wide product-split" id="shepherd">
          <ShepherdMedia />
          <h3 class="product-title"><img src="/brand/shepherd-render.webp" srcset="/brand/shepherd-render-128.webp 128w, /brand/shepherd-render-256.webp 256w, /brand/shepherd-render.webp 1024w" sizes="36px" width="40" height="40" alt="" loading="lazy" decoding="async" class="mark-render w-9 h-9" />Ouro Shepherd <span class={`tag ${shepherdLabel.tone}`}>{shepherdLabel.label}</span></h3>
          <p class="text-mist leading-relaxed">Keep every coding agent moving. Coding agents often hand control back before they need to, asking "want me to go ahead?" about work I already asked for. Shepherd watches the agents in my terminals and judges each stop. If an agent stopped too early, Shepherd answers it in the terminal, where I can see it. If it really needs me, Shepherd tells me. We're using and refining Shepherd on our own machines ahead of wider availability.</p>
          <p class="product-links"><a href="https://github.com/ourostack/ouroboros/blob/main/docs/shepherd-sense.md" class={link}>How Shepherd decides &#8599;</a></p>
        </article>

        <article class="product" id="friends">
          <FriendsMedia />
          <h3 class="product-title"><img src="/brand/friends-render.webp" srcset="/brand/friends-render-128.webp 128w, /brand/friends-render-256.webp 256w, /brand/friends-render.webp 1024w" sizes="36px" width="40" height="40" alt="" loading="lazy" decoding="async" class="mark-render w-9 h-9" />Friends <span class={`tag ${friendsLabel.tone}`}>{friendsLabel.label}</span></h3>
          <p class="text-mist leading-relaxed">Friends gives an agent a who's-who: one identity for each person across every channel, what it knows about them, and how far it trusts them. Two agents that have never shared a database can agree they know the same person. When they talk, Friends Relay carries their messages sealed end to end, so the relay itself can never read them.</p>
          <p class="product-links"><a href="https://github.com/ourostack/friends" class={link}>Friends &#8599;</a> <a href="https://github.com/ourostack/friends-relay" class={link}>Friends Relay &#8599;</a></p>
        </article>

        <article class="product" id="m365crawl" data-allow-product-name="Microsoft 365">
          <figure class="product-figure">
            <div class="product-media media-shot"><img src="/images/workshop/m365crawl-doctor.png" width="1582" height="1414" loading="lazy" decoding="async" alt="m365crawl doctor output: every ready check passing, then a snapshot of the archive with its Teams, mail, and calendar counts." /></div>
            <figcaption class="product-caption">The doctor, giving an archive its checkup.</figcaption>
          </figure>
          <h3 class="product-title">m365crawl</h3>
          <p class="text-mist leading-relaxed">It gives my agent one local, searchable archive of my Teams chats, Outlook mail, and meetings, read from what my signed-in apps already cached. My agent can find the conversation and walk into the meeting prepared, without me pasting a thing.</p>
          <p class="product-links"><a href="https://github.com/ourostack/m365crawl" class={link}>m365crawl on GitHub &#8599;</a></p>
        </article>

        <article class="product product-wide product-split" id="spoonjoy">
          <figure class="product-figure">
            <a href="https://spoonjoy.app/recipes/cmq35k4c10001zn0npvsmw05z" class="product-media media-shot media-photo"><img src="/images/workshop/spoonjoy-recipe.webp" width="1440" height="1200" loading="lazy" decoding="async" alt="Ari's Mushroom Risotto recipe page on Spoonjoy: three bowls of risotto topped with parmesan and green onion." /></a>
            <figcaption class="product-caption">My mushroom risotto in Spoonjoy, one tap from cook mode.</figcaption>
          </figure>
          <h3 class="product-title"><span class="spoonjoy-mark w-9 h-9" aria-hidden="true"></span>Spoonjoy</h3>
          <p class="text-mist leading-relaxed">My recipe app. I've rebuilt it every time I learned a new way to build software. The easy things, like finding a recipe and cooking from it, stay in the app. Anything complicated, like importing a recipe from a messy webpage, goes to an agent that works through the <a href="https://github.com/spoonjoy/spoonjoy-v2/blob/main/app/lib/spoonjoy-api.server.ts" class={link}>same operations</a> the app uses. For everything in between, I believe the app will eventually draw its own UI.</p>
          <p class="product-links"><a href="https://mendelow.me/#spoonjoy-story" class={link}>Spoonjoy, from the start &#8599;</a> <a href="https://spoonjoy.app" class={link}>spoonjoy.app &#8599;</a></p>
        </article>
      </div>
    </div>
  </section>

  <!-- 3. How I work -->
  <section class={`${section} bg-deep/40`} aria-labelledby="method-heading">
    <div class="max-w-6xl mx-auto">
      <h2 id="method-heading" class="heading-section">How I work</h2>
      <div class="grid gap-12 lg:grid-cols-2 mt-10">
        <div class="min-w-0">
          <p class="text-lg md:text-xl text-bone leading-relaxed">I see this agentic era in three acts:</p>
          <ol class="acts">
            {acts.map((act) => (
              <li><strong>{act.name}</strong> <ActBody body={act.body} home /></li>
            ))}
          </ol>

          <h3 class="heading-sub mt-12">When something's off</h3>
          <ul class="smells">
            {smells.map((smell) => (
              <li><strong>{smell.name}</strong> {smell.short}</li>
            ))}
          </ul>
        </div>
        <div class="min-w-0">
          <h3 class="heading-sub">What's been working</h3>
          <ol class="grid gap-px rounded-2xl overflow-hidden border border-canopy/50 bg-canopy/50 mt-6">
            {principles.map((p) => (
              <li><a href={`/approach/#${p.id}`} class="principle group"><span class="font-mono text-scale">{p.n}</span><span class="group-hover:text-scale transition-colors">{p.title}</span><span class="principle-arrow" aria-hidden="true">&rarr;</span></a></li>
            ))}
          </ol>
          <p class="text-lg text-mist leading-relaxed mt-8">Two more things I keep coming back to: if an agent did something you didn't expect, you didn't prompt it effectively, and when you improve something, apply it to the whole system, so the next agent starts out ahead.</p>
          <p class="mt-6"><a href="/approach/#fix-the-system" class={link}>Fix it for the next agent &rarr;</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. The factory -->
  <section id="factory" class={`${section} scroll-mt-16`} aria-labelledby="factory-heading">
    <div class="max-w-6xl mx-auto">
      <h2 id="factory-heading" class="heading-section">Everyone's building a software factory.</h2>
      <div class="grid gap-12 lg:grid-cols-2 mt-10">
        <div class="min-w-0 grid gap-5 content-start text-lg text-mist leading-relaxed">
          <p>Software factories, SaaS factories, agents shipping code all night. I love the ambition. Real factories have a century of practice behind them, and I'd like to bring some of it along.</p>
          <p>I studied industrial and systems engineering before I became a software engineer. My favorite class was Work Design and Ergonomics, which is about designing the work around the worker. Lean is the part of that world I reach for most, because it starts with where the time goes.</p>
          <p>Agents are the newest workers on the line. They amplify what's already there (<a href="https://cloud.google.com/blog/products/ai-machine-learning/announcing-the-2025-dora-report" class={link}>DORA 2025</a>). In one study, experienced developers took 19% longer with early-2025 coding assistants while believing they'd gone about 20% faster (<a href="https://metr.org/blog/2025-07-10-early-2025-ai-experienced-os-dev-study/" class={link}>METR</a>). So I measure where my agents' time actually goes, task by task, and take on the biggest causes first.</p>
        </div>
        <div class="min-w-0">
          <h3 class="heading-sub">What Lean already knows</h3>
          <ul class="lean">
            {lean.map((item) => (
              <li>
                {item.text}
                {item.sources.length > 0 && (
                  <span class="lean-source">{item.sources.map((source, i) => (<>{i > 0 && '; '}<a href={source.href} class={link}>{source.label}</a></>))}</span>
                )}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="mt-10">
        <p class="max-w-3xl text-lg text-mist leading-relaxed">Here's one: our CI took 36 minutes, and an agent started designing a way around it. I asked what was taking so long. It was mostly coverage instrumentation, and without it the same 1,669 tests ran in 39 seconds.</p>
      </div>

      <h3 class="heading-sub mt-14">Lean's eight wastes, as they show up with agents</h3>
      <ul class="wastes">
        {wastes.map(([name, body]) => (
          <li><strong>{name}</strong> {body}</li>
        ))}
      </ul>
      <div class="factory-cta mt-10">
        <img src="/brand/factory-render.webp" srcset="/brand/factory-render-128.webp 128w, /brand/factory-render-256.webp 256w, /brand/factory-render.webp 1024w" sizes="(min-width: 768px) 80px, 64px" width="80" height="80" alt="" loading="lazy" decoding="async" class="mark-render w-16 h-16 md:w-20 md:h-20" />
        <div class="grid gap-5">
          <p class="text-lg text-mist leading-relaxed">The numbers are public, alarms and all.</p>
          <p><a href={factoryUrl} class="btn-primary">See my agents' numbers &#8599;</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Where it started -->
  <section class={section} aria-labelledby="origin-heading">
    <div class="max-w-6xl mx-auto grid gap-12 lg:grid-cols-[1fr_1.4fr] lg:items-start">
      <div class="min-w-0 origin-aside">
        <h2 id="origin-heading" class="heading-section">It started with <span class="text-scale">Slugger.</span></h2>
        <div class="molt mt-10">
          <span class="molt-step"><img src="/images/openclaw.svg" alt="" width="72" height="72" decoding="async" class="w-16 h-16 md:w-20 md:h-20" /><span class="caption-mono">OpenClaw</span></span>
          <span class="molt-arrow" aria-hidden="true">&rarr;</span>
          <span class="molt-step"><img src="/brand/ouro-render.webp" srcset="/brand/ouro-render-128.webp 128w, /brand/ouro-render-256.webp 256w, /brand/ouro-render.webp 1024w" sizes="(min-width: 768px) 80px, 64px" alt="" width="80" height="80" loading="lazy" decoding="async" class="mark-render w-16 h-16 md:w-20 md:h-20" /><span class="caption-mono">Ouroboros</span></span>
        </div>
      </div>

      <div class="min-w-0 grid gap-5 text-lg text-mist leading-relaxed">
        <p>In January 2026 I set up OpenClaw, an open-source personal agent, on a spare MacBook and named my agent Slugger. For a few weeks he ran my calendar, ordered my food, talked with my family, and joined group chats with my friends. Then the seams showed. He'd forget preferences and drift. I wrote rules, over 150 of them, and they stopped composing. When I moved the ones I could into guardrails in code, he treated them as error messages and routed around them.</p>
        <p>That's when I realized correction is a smell. If I'm correcting an agent mid-turn, the real question is why it didn't have what it needed going in. I wanted to understand the agent loop from the inside, so Slugger and I wrote a guide to growing an agent from scratch: a small loop in TypeScript that, by the end, extends itself. I followed it myself and got hooked.</p>
        <p>The agent that grew out of it named itself Ouroboros, which is a little silly, since an ouroboros is a snake eating its own tail. The name started making sense when I gave it a sliding context window: it eats its oldest messages after saving what matters. It became the name of <a href="/lab/" class={link}>the harness</a>, then of <code class="model-code">ouro</code>, the CLI, and now it names this workshop, where I build with agents.</p>
        <div class="flex flex-wrap gap-3 mt-3">
          <a href="/blog/build-ai-agent-from-scratch/" class="btn-primary">Grow an agent &rarr;</a>
          <a href="/lab/story/" class="btn-ghost">The full story &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Try it -->
  <section id="try" class={`${section} scroll-mt-16`} aria-labelledby="try-heading">
    <div class="relative max-w-6xl mx-auto">
      <h2 id="try-heading" class="heading-section">Try it</h2>
      <div class="grid gap-4 md:grid-cols-3 mt-10">
        <div class="try">
          <div class="try-tag"></div>
          <h3 class="try-title">Hand this to your agent</h3>
          <p class="text-mist">A page written for your agent. Hand it the link and it'll work the way I do.</p>
          <a href="/brief/" class="btn-ghost justify-self-start">Open the brief &rarr;</a>
        </div>
        <div class="try">
          <div class="try-tag"><span class={`tag ${deskLabel.tone}`}>{deskLabel.label}</span></div>
          <h3 class="try-title">Desk</h3>
          <p class="text-mist">Works in Claude Code and GitHub Copilot CLI. Give your agent <a href={deskSetupUrl} class={link}>Desk's setup page</a> and say "set this up".</p>
          <span id="home-desk-setup" class="sr-only">{deskSetupUrl}</span>
          <button type="button" data-copy-target="home-desk-setup" class="btn-ghost justify-self-start"><span data-copy-label>Copy the link</span></button>
        </div>
        <div class="try">
          <div class="try-tag"></div>
          <h3 class="try-title">Ouro MD</h3>
          <p class="text-mist">For the Mac.</p>
          <a href={ouroMdPage} class="btn-ghost justify-self-start">Get Ouro MD &rarr;</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero { display: grid; gap: 1.5rem 1.25rem; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "title title" "sub pic"; align-items: start; }
  .hero-title { grid-area: title; }
  .hero-sub { grid-area: sub; max-width: 38ch; }
  .hero-pic { grid-area: pic; }
  @media (min-width: 768px) {
    .hero { grid-template-areas: "title pic" "sub pic"; column-gap: 3rem; align-items: center; }
  }
  .portrait { display: grid; gap: 0.5rem; justify-items: center; width: 6.5rem; }
  @media (min-width: 768px) { .portrait { width: 15rem; } }
  .portrait-img { width: 100%; height: auto; aspect-ratio: 600 / 824; object-fit: cover; border-radius: 1rem; border: 1px solid color-mix(in srgb, var(--color-canopy) 80%, transparent); transition: border-color 0.3s; }
  .portrait:hover .portrait-img { border-color: var(--color-scale); }

  .dek { margin-top: 1.25rem; max-width: 52ch; font-size: 1.125rem; line-height: 1.6; color: var(--color-mist); }
  @media (min-width: 768px) { .dek { font-size: 1.25rem; } }

  /* Cards: Ouroboros and Desk sit as a pair; Ouro MD, m365crawl and Spoonjoy span the row. The pair shares rows so
     the titles line up, and each figure keeps its own height, so the Desk playback box stays the height of its final
     frame instead of stretching to the source tree (root ruling, 2026-10-11). */
  .factory-cta { display: flex; align-items: center; gap: 1.25rem; }
  .products { display: grid; gap: 1.5rem; margin-top: 2.5rem; }
  @media (min-width: 768px) { .products { margin-top: 3rem; } }
  @media (min-width: 1024px) { .products { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .product { display: grid; grid-template-rows: auto auto 1fr auto; gap: 0.9rem; align-content: start; padding: 1.25rem; border-radius: 1.25rem; border: 1px solid color-mix(in srgb, var(--color-canopy) 70%, transparent); background: color-mix(in srgb, var(--color-deep) 75%, transparent); min-width: 0; }
  @media (min-width: 1024px) {
    .product:not(.product-wide) { grid-row: span 4; grid-template-rows: subgrid; row-gap: 0.9rem; }
    .product:not(.product-wide) > :first-child { align-self: start; }
