---
import Layout from '../layouts/Layout.astro'
import DeskBootPreview from '../components/DeskBootPreview.astro'
import SerpentGuidePreview from '../components/SerpentGuidePreview.astro'
import { ogPathFor } from '../data/og'
import { principles, proposedPrinciple, factoryUrl, deskSetupUrl } from '../data/principles.mjs'
import { labelFor } from '../data/readiness.mjs'
import { longestSession, longestHours } from '../data/factory.mjs'
import modelReviews from '../data/model-reviews.json'
import { getModelReviewClaims } from '../lib/model-review-claims.mjs'

const title = 'How do you effectively collaborate with agents? | Ouroboros'
const description = "I'm Ari. I build products for humans + agents. People keep ending up as the glue between half-smart tools, copying out of one and pasting into the next. The software should carry that context so you do not have to."

// The model-review result, derived from the review data rather than typed in.
const reviewClaims = getModelReviewClaims(modelReviews)
const numberWords = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve']
const harnessCount = numberWords[modelReviews.harnesses.length] ?? String(modelReviews.harnesses.length)
const reviewLead = reviewClaims.allChose ? 'Every frontier model we tested' : `${reviewClaims.winnerCount} of the ${reviewClaims.totalReviews} frontier models we tested`
const sessionDays = Math.round(longestSession.durationMs / 86_400_000)
const deskLabel = labelFor('desk-claude-code-macos')
const ouroMdDownload = 'https://ouro.bot/apps/ouro-md/'

const link = 'text-scale underline underline-offset-4 decoration-scale/40 hover:text-glow transition-colors'

// Beats quoted verbatim from /lab/story, one concrete line per stage.
const beats = [
  { when: 'January 2026', quote: 'Slugger managed my calendar. Ordered food. Drafted messages. Talked to my family.', tone: 'scale' },
  { when: 'Early February 2026', quote: 'Slugger would forget preferences between sessions. Identity would drift.', tone: 'fang' },
  { when: 'Late February 2026', quote: 'I built the 150-line bootstrap. Ran it. Started talking to it.', tone: 'glow' },
]
---

<Layout title={title} description={description} ogImage={ogPathFor('/')} canonical="https://ouroboros.bot/">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "How do you effectively collaborate with agents?",
      "url": "https://ouroboros.bot/",
      "author": { "@type": "Person", "name": "Ari Mendelow", "url": "https://mendelow.me" },
      "dateModified": "2026-10-10"
    })} />
  </Fragment>

  <!-- Hero: the question, who's asking, and where to find more about him -->
  <section class="relative overflow-hidden px-5 sm:px-6 md:px-12 lg:px-16 pt-24 pb-12 md:pt-32 md:pb-20">
    <div class="absolute top-10 -right-40 w-[520px] h-[520px] rounded-full bg-scale/10 blur-[140px] pointer-events-none" aria-hidden="true"></div>

    <div class="hero relative max-w-6xl mx-auto">
      <h1 class="hero-title heading-hero animate-fade-up">How do you effectively collaborate with <span class="text-scale">agents?</span></h1>
      <p class="hero-sub text-lg md:text-2xl text-bone leading-snug animate-fade-up stagger-1">I'm Ari. I build products for humans + agents. People keep ending up as the glue between half-smart tools, copying out of one and pasting into the next. The software should carry that context so you do not have to.</p>
      <a href="https://mendelow.me" class="hero-pic portrait group animate-fade-up stagger-2">
        <img src="/images/workshop/ari-portrait.jpg" width="600" height="824" alt="Ari Mendelow" class="portrait-img" fetchpriority="high" />
        <span class="text-sm md:text-base text-bone group-hover:text-scale transition-colors">More about me &rarr;</span>
      </a>
    </div>
  </section>

  <!-- Built this way: the proof is the products -->
  <section class="relative px-5 sm:px-6 md:px-12 lg:px-16 py-14 md:py-24 border-t border-canopy/20 reveal" aria-labelledby="built-heading">
    <div class="max-w-6xl mx-auto">
      <h2 id="built-heading" class="heading-section">What I've built with agents</h2>

      <div class="products grid gap-6 lg:grid-cols-2 mt-10 md:mt-12">
        <article class="product">
          <figure class="product-figure">
            <div class="product-media"><img src="/images/workshop/ouro-md-reload-poster.png" data-gif="/images/workshop/ouro-md-reload.gif" data-gif-alt="After reading the human-saved feedback from this same Markdown file, a scripted agent revision changes the invitation and support hours. The person sees quiet margin marks and uses Next change; actual file status is Modified, not automatically committed. Actual captured frames are played at 3 times their captured rate; no tween frames." width="800" height="720" loading="lazy" decoding="async" alt="After reading the human-saved feedback from this same Markdown file, a scripted agent revision changes the invitation and support hours. The person sees quiet margin marks and uses Next change; actual file status is Modified, not automatically committed." /></div>
            <figcaption class="product-caption">A demo: an agent's revision lands in the plan I'm reading, and Ouro MD marks what changed. Sped up 3×.</figcaption>
          </figure>
          <h3 class="product-title"><img src="/brand/ouro-md-icon.png" width="40" height="40" alt="" class="mark-tile w-9 h-9" />Ouro MD</h3>
          <p class="text-mist leading-relaxed">Markdown that renders as you write. It's where I read and answer what my agents write.</p>
          <a href="/ouro-md/" class={link}>Ouro MD &rarr;</a>
        </article>

        <article class="product">
          <figure class="product-figure">
            <div class="product-media"><img src="/images/workshop/spoonjoy-app.jpg" width="1000" height="625" loading="lazy" decoding="async" alt="Spoonjoy's home page: Your food should look as good as it tastes, over a photo of home-cooked dishes." class="object-left-top" /></div>
            <figcaption class="product-caption">The home page at spoonjoy.app.</figcaption>
          </figure>
          <h3 class="product-title">Spoonjoy</h3>
          <p class="text-mist leading-relaxed">A photo-first kitchen for the recipes you actually cook. The same operations that power the app are exposed to an agent, so it does the work through the exact surface you'd use by hand.</p>
          <a href="https://spoonjoy.app" class={link}>spoonjoy.app &rarr;</a>
        </article>

        <article class="product">
          <figure class="product-figure">
            <div class="product-media media-terminal"><DeskBootPreview compact /></div>
            <figcaption class="product-caption">Real output from a Desk session start (sample task).</figcaption>
          </figure>
          <h3 class="product-title"><img src="/brand/desk-icon.svg" width="40" height="40" alt="" class="mark-tile w-9 h-9" />Desk</h3>
          <p class="text-mist leading-relaxed">My agents' work lives in a Git repository: tasks, decisions and lessons, so the next session picks up where the last one left off.</p>
          <a href="/desk/" class={link}>Desk &rarr;</a>
        </article>

        <article class="product">
          <figure class="product-figure">
            <div class="product-media media-terminal"><SerpentGuidePreview compact /></div>
            <figcaption class="product-caption">What first run looks like (illustration).</figcaption>
          </figure>
          <h3 class="product-title"><span class="mark-mask w-9 h-9 text-scale" style="--mark:url(/brand/ouro-badge.svg)" aria-hidden="true"></span>Ouroboros</h3>
          <p class="text-mist leading-relaxed">An open-source harness for personal agents that need an identity, durable state, real tools, and a place to live. {reviewLead} <a href="/lab/model-reviews/" class={link}>chose it from {harnessCount} harnesses</a> as the one it would most want to wake up in.</p>
          <a href="/lab/" class={link}>The harness &rarr;</a>
        </article>
      </div>
    </div>
  </section>

  <!-- How I work -->
  <section class="relative px-5 sm:px-6 md:px-12 lg:px-16 py-14 md:py-24 border-t border-canopy/20 bg-deep/40 reveal" aria-labelledby="method-heading">
    <div class="max-w-6xl mx-auto grid gap-12 lg:grid-cols-2">
      <div class="min-w-0">
        <h2 id="method-heading" class="heading-section">How I work</h2>
        <p class="text-lg md:text-xl text-bone leading-relaxed mt-8">I view this agentic era as three acts: capability, orientation, and work design. Capability has been solved for some time. Everything else I've worked on has been about orientation. Now the industry is starting to move into the third act: designing and measuring how agents get their work done.</p>
        <p class="text-lg text-mist leading-relaxed mt-5">I studied industrial and systems engineering, and my favorite class was Work Design and Ergonomics: designing the work around the worker instead of making the worker absorb the friction. <a href="/blog/what-is-agent-experience/" class={link}>Agent Experience</a> is that idea, pointed at the agent.</p>
      </div>
      <div class="min-w-0">
        <ol class="grid gap-px rounded-2xl overflow-hidden border border-canopy/50 bg-canopy/50">
          {principles.map((p) => (
            <li><a href={`/approach/#${p.id}`} class="principle group"><span class="font-mono text-scale">{p.n}</span><span class="group-hover:text-scale transition-colors">{p.title}</span></a></li>
          ))}
          <li><a href={`/approach/#${proposedPrinciple.id}`} class="principle group"><span class="font-mono text-scale">{proposedPrinciple.n}</span><span class="group-hover:text-scale transition-colors">{proposedPrinciple.title} <span class="text-base text-mist">(proposed)</span></span></a></li>
        </ol>
        <p class="mt-6"><a href="/approach/" class={link}>Five principles and a proposed sixth, with the moments that taught me each one &rarr;</a></p>
      </div>
    </div>
  </section>

  <!-- Receipts: the live factory number, dated, in plain words -->
  <section class="relative px-5 sm:px-6 md:px-12 lg:px-16 py-14 md:py-24 border-t border-canopy/20 reveal" aria-labelledby="proof-heading">
    <div class="max-w-4xl mx-auto">
      <h2 id="proof-heading" class="heading-sub md:!text-5xl !leading-tight">One agent session ran for <span class="text-scale">{longestHours} hours</span>, about {sessionDays === 7 ? 'a week' : `${sessionDays} days`}. {longestSession.prsMerged} of the {longestSession.prsTotal} pull requests it referenced are merged.</h2>
      <p class="text-mist mt-6">From <a href={factoryUrl} class={link}>the factory</a>, my public record of agent work, {longestSession.asOf}.</p>
    </div>
  </section>

  <!-- Where it started: Slugger, in the story's own words -->
  <section class="relative px-5 sm:px-6 md:px-12 lg:px-16 py-14 md:py-24 border-t border-canopy/20 reveal" aria-labelledby="origin-heading">
    <div class="max-w-6xl mx-auto grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-start">
      <div class="min-w-0">
        <h2 id="origin-heading" class="heading-section">It started with <span class="text-scale">Slugger.</span></h2>
        <figure class="mt-10">
          <div class="molt">
            <span class="molt-step"><img src="/images/openclaw.svg" alt="" width="72" height="72" class="w-16 h-16 md:w-20 md:h-20" /><span class="caption-mono">OpenClaw</span></span>
            <span class="molt-arrow" aria-hidden="true">&rarr;</span>
            <span class="molt-step"><span class="mark-mask w-16 h-16 md:w-20 md:h-20 text-scale" style="--mark:url(/brand/ouro-silhouette.svg)" aria-hidden="true"></span><span class="caption-mono">Ouroboros</span></span>
          </div>
          <blockquote class="font-display text-2xl md:text-3xl text-bone leading-snug mt-8 max-w-[32ch]">&ldquo;OpenClaw's mascot is a lobster. [&hellip;] The interim name was Moltbot &mdash; the lobster shedding its shell. But what emerged from Slugger's molt wasn't another crustacean. It was a snake, eating its own tail.&rdquo;</blockquote>
        </figure>
      </div>

      <div class="min-w-0">
        <ol class="grid gap-0">
          {beats.map((beat) => (
            <li class="beat" style={`--beat: var(--color-${beat.tone})`}>
              <span class="caption-mono">{beat.when}</span>
              <p class="font-display text-2xl md:text-[1.7rem] text-bone leading-snug mt-1">&ldquo;{beat.quote}&rdquo;</p>
            </li>
          ))}
        </ol>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="/lab/story/" class="btn-primary">Read the story &rarr;</a>
          <a href="/lab/" class="btn-ghost">The harness</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Try it -->
  <section class="relative px-5 sm:px-6 md:px-12 lg:px-16 py-14 md:py-24 border-t border-canopy/20 reveal" aria-labelledby="try-heading">
    <div class="relative max-w-6xl mx-auto">
      <h2 id="try-heading" class="heading-section">Try it</h2>
      <div class="grid gap-4 md:grid-cols-3 mt-10">
        <div class="try">
          <h3 class="try-title">Hand this to your agent</h3>
          <p class="text-mist">The five principles, written for your agent to read.</p>
          <a href="/brief/" class="btn-ghost justify-self-start">Open the brief &rarr;</a>
        </div>
        <div class="try">
          <span class={`tag ${deskLabel.tone} justify-self-start`}>{deskLabel.label}</span>
          <h3 class="try-title">Desk</h3>
          <p class="text-mist">Give your agent this link and say "set this up": <a href={deskSetupUrl} class={link}>Desk's SETUP.md</a></p>
          <span id="home-desk-setup" class="sr-only">{deskSetupUrl}</span>
          <button type="button" data-copy-target="home-desk-setup" class="btn-ghost justify-self-start"><span data-copy-label>Copy the link</span></button>
        </div>
        <div class="try">
          <h3 class="try-title">Ouro MD</h3>
          <p class="text-mist">For the Mac.</p>
          <a href={ouroMdDownload} class="btn-primary justify-self-start">Download Ouro MD &rarr;</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  // Swap each poster for its animation once it is on screen, unless the
  // reader prefers reduced motion. Without JS, the poster stays.
  (function () {
    var imgs = document.querySelectorAll('img[data-gif]');
    if (!imgs.length || !('IntersectionObserver' in window)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        e.target.src = e.target.getAttribute('data-gif');
        if (e.target.hasAttribute('data-gif-alt')) e.target.alt = e.target.getAttribute('data-gif-alt');
        io.unobserve(e.target);
      });
    }, { rootMargin: '200px' });
    imgs.forEach(function (img) { io.observe(img); });
  })();
</script>

<style>
  .hero { display: grid; gap: 1.5rem 1.25rem; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "title title" "sub pic"; align-items: start; }
  .hero-title { grid-area: title; }
  .hero-sub { grid-area: sub; max-width: 38ch; }
  .hero-pic { grid-area: pic; }
  @media (min-width: 768px) {
    .hero { grid-template-areas: "title pic" "sub pic"; column-gap: 3rem; align-items: center; }
  }
  .portrait { display: grid; gap: 0.5rem; justify-items: center; width: 6.5rem; }
  @media (min-width: 768px) { .portrait { width: 15rem; } }
  .portrait-img { width: 100%; height: auto; aspect-ratio: 600 / 824; object-fit: cover; border-radius: 1rem; border: 1px solid color-mix(in srgb, var(--color-canopy) 80%, transparent); transition: border-color 0.3s; }
  .portrait:hover .portrait-img { border-color: var(--color-scale); }

  .product { display: grid; grid-template-rows: auto auto 1fr auto; gap: 0.9rem; align-content: start; padding: 1.25rem; border-radius: 1.25rem; border: 1px solid color-mix(in srgb, var(--color-canopy) 70%, transparent); background: color-mix(in srgb, var(--color-deep) 75%, transparent); min-width: 0; }
  .product-figure { margin: 0 0 0.25rem; border-radius: 0.9rem; overflow: hidden; border: 1px solid color-mix(in srgb, var(--color-canopy) 60%, transparent); }
  .product-media { aspect-ratio: 3 / 2; overflow: hidden; background: #f6f3ec; }
  .product-media.media-terminal { background: var(--color-deep); aspect-ratio: auto; }
  /* From 1024px the cards sit in pairs. Subgrid lines up each pair's media, titles and links, and every media box fills its row, so the taller terminal is never clipped. */
  @media (min-width: 1024px) {
    .product { grid-row: span 4; grid-template-rows: subgrid; row-gap: 0.9rem; }
    .product-figure { display: flex; flex-direction: column; }
    .product-media { flex: 1 1 auto; }
  }
  .product-media img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .product-media img[src*='ouro-md'] { object-position: top center; }
  .product-media img.object-contain { object-fit: contain; object-position: center; }
  .product-media img.object-left-top { object-position: left top; }
  .product-caption { padding: 0.6rem 0.9rem; font-size: 0.875rem; color: var(--color-mist); background: var(--color-void); border-top: 1px solid color-mix(in srgb, var(--color-canopy) 60%, transparent); }
  .product-title { display: flex; align-items: center; gap: 0.75rem; font-family: var(--font-display); font-size: 1.9rem; line-height: 1.1; color: var(--color-bone); }

  .try { display: grid; gap: 0.75rem; align-content: start; padding: 1.5rem; border-radius: 1.25rem; border: 1px solid color-mix(in srgb, var(--color-canopy) 70%, transparent); background: color-mix(in srgb, var(--color-deep) 75%, transparent); }
  .try-title { font-family: var(--font-display); font-size: 1.9rem; line-height: 1.1; color: var(--color-bone); }

  .molt { display: flex; align-items: center; gap: 1.25rem; }
  .molt-step { display: grid; justify-items: center; gap: 0.5rem; }
  .molt-arrow { font-family: var(--font-display); font-size: 2.25rem; color: var(--color-fang); }

  .beat { position: relative; padding: 0 0 2rem 1.75rem; border-left: 2px solid color-mix(in srgb, var(--beat) 55%, transparent); }
  .beat:last-child { padding-bottom: 0; }
  .beat::before { content: ""; position: absolute; left: -7px; top: 0.15rem; width: 12px; height: 12px; border-radius: 50%; background: var(--beat); box-shadow: 0 0 14px var(--beat); }

  .principle { display: flex; gap: 1rem; align-items: baseline; padding: 1rem 1.25rem; background: var(--color-deep); font-family: var(--font-display); font-size: 1.3rem; line-height: 1.3; color: var(--color-bone); transition: background 0.2s; }
  .principle:hover { background: var(--color-undergrowth); }
</style>
