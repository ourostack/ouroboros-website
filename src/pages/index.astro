  /* Every row's words start on one line down the page. From 2000px every
     row's demo column is 840 CSS px; the Ouro MD recording, never drawn
     larger than its pixels (--clip-w, global.css), sits at its column's
     start, so on a 2x screen it is narrower than the column, not centred. */
  @media (min-width: 2000px) {
    .tool { grid-template-columns: minmax(0, 840px) minmax(0, 1fr); }
  }
  .tool :global(.clip:has(> .media-clip)) { margin-inline: 0; }
  .tool > :global(.product-figure) { margin: 0; min-width: 0; }
  .tool-copy { display: grid; gap: 1rem; align-content: start; min-width: 0; color: var(--color-mist); font-size: 1.125rem; line-height: 1.65; }
  .tool-name { text-wrap: pretty; font-family: var(--font-display); font-size: 1.5rem; line-height: 1.1; color: var(--color-bone); }
  /* Under its section's heading at every width: 24px on a phone, where that heading is 30px. */
  @media (min-width: 768px) { .tool-name { font-size: 2.25rem; } }
  .hx-voyage { display: block; }
  .hx-voyage img { display: block; width: 100%; height: auto; }

  /* Receipts: the count large, then the latest pull requests as ruled rows, like the start links below.
     From 1024px the count and the list sit side by side, both under the full-width heading. The rows
     are :global because the page's script redraws them. */
  .receipts { display: grid; gap: 2.5rem 4rem; margin-top: 2.5rem; }
  @media (min-width: 1024px) { .receipts { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: start; } }
  .tally-n { font-family: var(--font-display); font-size: clamp(5.5rem, 3rem + 11vw, 10rem); line-height: 0.8; letter-spacing: -0.03em; font-variant-numeric: lining-nums tabular-nums; color: var(--color-scale); }
  .tally-what { margin-top: 0.75rem; font-family: var(--font-display); font-size: 1.5rem; line-height: 1.2; color: var(--color-bone); }
  @media (min-width: 768px) { .tally-what { font-size: 1.875rem; } }
  .tally-more { margin-top: 0.75rem; font-size: 1.125rem; line-height: 1.6; color: var(--color-mist); }
  .tally-asof { display: flex; align-items: center; gap: 0.5rem; margin-top: 1.25rem; font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-mist); }
  /* Lit only while the page holds an answer from the last few minutes (the script sets .is-live). */
  .live-dot { display: none; width: 0.5rem; height: 0.5rem; border-radius: 9999px; background: var(--color-scale); }
  [data-receipts].is-live .live-dot { display: inline-block; }
  .latest .latest-label { margin-top: 0; margin-bottom: 0.25rem; }
  .receipt-list :global(.receipt) { display: flex; flex-direction: column; align-items: flex-start; gap: 0.3rem; padding: 0.9rem 0; border-top: 1px solid color-mix(in srgb, var(--color-canopy) 60%, transparent); }
  .receipt-list :global(li:last-child .receipt) { border-bottom: 1px solid color-mix(in srgb, var(--color-canopy) 60%, transparent); }
  .receipt-list :global(.receipt-title) { font-family: var(--font-display); font-size: 1.25rem; line-height: 1.25; color: var(--color-bone); text-wrap: pretty; transition: color 0.2s; }
  @media (min-width: 768px) { .receipt-list :global(.receipt-title) { font-size: 1.5rem; } }
  .receipt-list :global(.receipt-meta) { font-size: 1rem; color: var(--color-scale); }
  .receipt-list :global(.receipt:hover .receipt-title) { color: var(--color-scale); }
  .receipts-all { margin-top: 1.25rem; font-size: 1.125rem; }
  @media (prefers-reduced-motion: no-preference) {
    [data-receipts].is-live .live-dot { animation: receipt-pulse 2.4s ease-in-out infinite; }
    .receipt-list :global(.receipt.is-new .receipt-title) { animation: receipt-new 2.4s ease-out; }
  }
  @keyframes receipt-pulse { 50% { opacity: 0.35; } }
  @keyframes receipt-new { from { color: var(--color-scale); } }
</style>

<script>
  // Swaps in the receipts the Worker has now (/api/receipts.json, src/worker/receipts.mjs) and keeps
  // asking every two minutes while the page is open; an answer that fails, or isn't newer than what the
  // page shows, changes nothing. Times read as "14 min ago" in place of the build's Pacific times. The
  // count rises from zero the first time it comes into view, unless the reader asks for less motion.
  import { ago, formatCount, isValidReceipts } from '../lib/receipts.mjs'

  const root = document.querySelector<HTMLElement>('[data-receipts]')
  if (root) {
    const part = <T extends HTMLElement = HTMLElement>(name: string) => root.querySelector<T>(`[data-r="${name}"]`)!
    const countEl = part('count')
    const reduce = matchMedia('(prefers-reduced-motion: reduce)')
    let asOf = root.dataset.asOf!
    let count = Number(root.dataset.count)
    let shownCount = count
    let frame = 0

    const tween = (from: number, to: number) => {
      cancelAnimationFrame(frame)
      if (reduce.matches || from === to) {
        shownCount = to
        countEl.textContent = formatCount(to)
        return
      }
      const start = performance.now()
      const ms = from === 0 ? 1600 : 900
      const step = (t: number) => {
        const p = Math.min(1, (t - start) / ms)
        shownCount = Math.round(from + (to - from) * (1 - (1 - p) ** 3))
        countEl.textContent = formatCount(shownCount)
        if (p < 1) frame = requestAnimationFrame(step)
      }
      frame = requestAnimationFrame(step)
    }

    const timeText = (iso: string) => {
      const at = new Date(iso)
      const sameDay = at.toDateString() === new Date().toDateString()
      return new Intl.DateTimeFormat(undefined, { ...(sameDay ? {} : { month: 'short', day: 'numeric' }), hour: 'numeric', minute: '2-digit', timeZoneName: 'short' }).format(at)
    }
    const tick = () => {
      for (const t of root.querySelectorAll<HTMLTimeElement>('time[data-ago]')) t.textContent = ago(t.dateTime)
      const asOfEl = part<HTMLTimeElement>('as-of')
      asOfEl.textContent = timeText(asOfEl.dateTime)
      root.classList.toggle('is-live', Date.now() - Date.parse(asOf) < 10 * 60 * 1000)
    }

    // A title's paths break only after a slash, as the build's code-wrap breaks them.
    const titleNode = (title: string) => {
      const span = document.createElement('span')
      span.className = 'receipt-title'
      title.split(/(?<=\/)/).forEach((piece, i) => {
        if (i) span.append(document.createElement('wbr'))
        span.append(piece)
      })
      return span
    }
    type Pr = { title: string; url: string; repo: string; number: number; mergedAt: string }
    const item = (pr: Pr, fresh: boolean) => {
      const li = document.createElement('li')
      const a = document.createElement('a')
      a.href = pr.url
      a.className = fresh ? 'receipt is-new' : 'receipt'
      const meta = document.createElement('span')
      meta.className = 'receipt-meta'
      const time = document.createElement('time')
      time.dateTime = pr.mergedAt
      time.dataset.ago = ''
      time.textContent = ago(pr.mergedAt)
      meta.append(`${pr.repo} #${pr.number} · `, time, '\u00a0\u2197')
      a.append(titleNode(pr.title), meta)
      li.append(a)
      return li
    }

    const show = (r: any) => {
      const shown = new Set([...root.querySelectorAll<HTMLAnchorElement>('.receipt')].map((a) => a.href))
      asOf = r.asOf
      part<HTMLTimeElement>('as-of').dateTime = r.asOf
      part('repos-phrase').hidden = r.repos === null
      if (r.repos !== null) part('repos').textContent = String(r.repos)
      part('more').hidden = r.week === null || r.all === null
      if (r.week !== null) part('week').textContent = formatCount(r.week)
      if (r.all !== null) part('all').textContent = formatCount(r.all)
      part<HTMLAnchorElement>('search').href = r.search
      part('latest').replaceChildren(...r.latest.map((pr: Pr) => item(pr, !shown.has(pr.url))))
      const from = shownCount
      count = r.count
      tween(from, count)
      tick()
    }

    let last = 0
    const refresh = async () => {
      if (document.visibilityState !== 'visible') return
      last = Date.now()
      try {
        const res = await fetch('/api/receipts.json', { headers: { accept: 'application/json' } })
        if (!res.ok || !res.headers.get('content-type')?.includes('json')) return
        const r = await res.json()
        if (isValidReceipts(r) && Date.parse(r.asOf) > Date.parse(asOf)) show(r)
      } catch {
        // Offline, or the Worker isn't there: the page keeps what it has.
      }
    }

    tick()
    setInterval(tick, 30 * 1000)
    refresh()
    setInterval(refresh, 2 * 60 * 1000)
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && Date.now() - last > 2 * 60 * 1000) refresh()
    })

    if (!reduce.matches && 'IntersectionObserver' in window) {
      const seen = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return
        seen.disconnect()
        tween(0, count)
      }, { threshold: 0.6 })
      seen.observe(countEl)
    }
  }
</script>
