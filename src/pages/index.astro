---
import Layout from '../layouts/Layout.astro'
import DeskMedia from '../components/DeskMedia.astro'
import OuroMdMedia from '../components/OuroMdMedia.astro'
import ModelQuotes from '../components/ModelQuotes.astro'
import modelReviews from '../data/model-reviews.json'
import { getModelReviewClaims } from '../lib/model-review-claims.mjs'
import { ogPathFor } from '../data/og'
import { principles, smells, factoryUrl, deskSetupUrl } from '../data/principles.mjs'
import { labelFor, entry } from '../data/readiness.mjs'
import { acts } from '../data/acts.mjs'
import ActBody from '../components/ActBody.astro'

// Every visible word on this page is transcribed from the copy deck
// (ouroboros.bot homepage, 2026-10-11). Builders never write copy here.
const title = 'How can humans and agents do more together? | Ouro'
// Link previews put this beside the Ouro character, so it never greets as Ari (cringe pass, 2026-10-16).
const description = "Ari Mendelow's workshop: the tools he's built for working with agents, how he uses them, and where it all started."

const { winner: reviewWinner, allChose, winnerCount, totalReviews } = getModelReviewClaims(modelReviews)
const reviewHeading = allChose ? 'Every frontier model we asked picked' : `${winnerCount} of ${totalReviews} frontier models we asked picked`
const deskLabel = labelFor('desk-claude-code-macos')
const hxLabel = labelFor('ouro-hx')
const shepherdLabel = labelFor('shepherd')
const friendsLabel = labelFor('friends')
const friendsDetail = entry('friends').detail
const shepherdDetail = entry('shepherd').detail
const butlerLabel = labelFor('butler')
const butlerDetail = entry('butler').detail
const ouroMdPage = '/ouro-md/'
const link = 'text-scale underline underline-offset-4 decoration-scale/40 hover:text-glow hover:decoration-current hover:decoration-2 transition-colors'
const section = 'relative px-5 sm:px-6 md:px-12 lg:px-16 py-14 md:py-24 border-t border-canopy/20 reveal'


const wastes = [
  ['Waiting', 'An agent stops to ask what you could have told it up front.'],
  ['Defects', 'Work that comes back broken.'],
  ['Overprocessing', 'Polish nobody asked for.'],
  ['Overproduction', 'Building before anyone needs it.'],
  ['Motion', 'Re-reading and re-searching what was already known.'],
  ['Inventory', 'Half-finished branches and pull requests piling up.'],
  ['Transportation', 'Carrying context by hand from one tool to the next.'],
  ['Unused talent', 'A human doing what an agent could, or an agent kept from what it could do.'],
]
---

<Layout title={title} description={description} ogImage={ogPathFor('/')} canonical="https://ouroboros.bot/">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "How can humans and agents do more together?",
      "url": "https://ouroboros.bot/",
      "author": { "@type": "Person", "name": "Ari Mendelow", "url": "https://mendelow.me" },
      "dateModified": "2026-10-11"
    })} />
  </Fragment>

  <!-- 1. Hero -->
  <section class="relative overflow-hidden px-5 sm:px-6 md:px-12 lg:px-16 pt-24 pb-10 md:pt-32 md:pb-14">
    <div class="absolute top-10 -right-40 w-[520px] h-[520px] rounded-full bg-scale/10 blur-[140px] pointer-events-none" aria-hidden="true"></div>

    <div class="hero relative max-w-6xl mx-auto">
      <div class="hero-copy">
      <h1 class="hero-title heading-hero animate-fade-up">How can humans and agents do more <span class="text-scale">together?</span></h1>
      <p class="hero-sub text-lg md:text-2xl text-bone leading-snug animate-fade-up stagger-1">Hello!! I'm Ari, and that question is behind everything I build. This is my workshop: the tools I've built for working with agents, how I use them, and where it all started.</p>
      </div>
      <a href="https://mendelow.me" class="hero-pic portrait group animate-fade-up stagger-2">
        <img src="/images/workshop/ari-portrait.jpg" width="600" height="824" alt="Ari Mendelow, smiling, in a navy blazer on a grassy overlook above a river gorge." class="portrait-img" fetchpriority="high" />
        <span class="portrait-link text-sm md:text-base">More about me <span aria-hidden="true">&#8599;</span></span>
      </a>
    </div>
  </section>

  <!-- 2. Ouroboros: what it is, the evidence, what grew inside it -->
  <section id="ouroboros" class={`${section} scroll-mt-16`} aria-labelledby="ouroboros-heading">
    <div class="max-w-6xl mx-auto">
      <h2 id="ouroboros-heading" class="heading-section heading-mark"><img src="/brand/ouro-render.webp" srcset="/brand/ouro-render-128.webp 128w, /brand/ouro-render-256.webp 256w" sizes="64px" width="64" height="64" alt="" loading="lazy" decoding="async" class="mark-render" />Ouroboros</h2>
      <div class="lead">
        <p>Ouroboros is the agent harness I built from scratch, and it's where I test what agents need. Most harnesses are built for a coding session. Ouroboros is built for a personal agent that lives with you for months, across iMessage, Teams, mail and the terminal. It keeps its identity, memory and people in one folder it can read and change, so it stays oriented from one conversation to the next.</p>
        <p><a href="/lab/" class={link}>The harness &rarr;</a></p>
      </div>

      <h3 class="heading-sub sub-block">{reviewHeading} <span class="text-scale">{reviewWinner}.</span></h3>
      <p class="dek">We asked each which of {modelReviews.harnesses.length} harnesses it would most want to wake up in. In their words:</p>
      <div class="mt-8"><ModelQuotes /></div>

      <h3 class="heading-sub sub-block">Grown inside it</h3>
      <ul class="grown">
        <li id="friends">
          <img src="/brand/friends-render.webp" srcset="/brand/friends-render-128.webp 128w, /brand/friends-render-256.webp 256w" sizes="64px" width="64" height="64" alt="" loading="lazy" decoding="async" class="mark-render grown-mark" />
          <div class="grown-body">
            <h4 class="grown-name">Friends</h4>
            <p class="grown-status"><span class={`tag ${friendsLabel.tone}`}>{friendsLabel.label}</span> {friendsDetail}</p>
            <p>Who an agent knows, and how far it trusts them. A personal agent needs that more than a coding agent does, so Friends began in Ouroboros. Now any harness can use it.</p>
            <p><a href="https://github.com/ourostack/friends" class={link}>Friends on GitHub &#8599;</a></p>
          </div>
        </li>
        <li id="shepherd">
          <img src="/brand/shepherd-render.webp" srcset="/brand/shepherd-render-128.webp 128w, /brand/shepherd-render-256.webp 256w" sizes="64px" width="64" height="64" alt="" loading="lazy" decoding="async" class="mark-render grown-mark" />
          <div class="grown-body">
            <h4 class="grown-name">Ouro Shepherd</h4>
            <p class="grown-status"><span class={`tag ${shepherdLabel.tone}`}>{shepherdLabel.label}</span> {shepherdDetail}</p>
            <p>Keeps the agents in my terminals on task. When one stops before it needs to, Shepherd answers it where I can see it.</p>
            <p><a href="https://github.com/ourostack/ouroboros/blob/main/docs/shepherd-sense.md" class={link}>How Shepherd decides &#8599;</a></p>
          </div>
        </li>
        <li id="butler">
          <img src="/brand/butler-render.webp" srcset="/brand/butler-render-128.webp 128w, /brand/butler-render-256.webp 256w" sizes="64px" width="64" height="64" alt="" loading="lazy" decoding="async" class="mark-render grown-mark" />
          <div class="grown-body">
            <h4 class="grown-name">Ouro Butler</h4>
            <p class="grown-status"><span class={`tag ${butlerLabel.tone}`}>{butlerLabel.label}</span> {butlerDetail}</p>
            <p>An Ouroboros agent that looks after a home server. When something your household counts on breaks, it fixes what it is allowed to and tells you the rest.</p>
            <p><a href="/butler/" class={link}>Ouro Butler &rarr;</a></p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- 3. The lab -->
  <section class={`${section} bg-deep/40`} aria-labelledby="built-heading">
    <div class="max-w-6xl mx-auto">
      <div class="section-head">
      <h2 id="built-heading" class="heading-section">Built by watching agents work</h2>
      <p class="dek">Each began with something my agents or I kept running into. Then I watched agents use it and asked them what got in the way. That's <a href="/blog/what-is-agent-experience/" class={link}>Agent Experience</a>.</p>
      </div>

      <div class="tools">
        <article class="tool" id="desk">
          <DeskMedia />
          <div class="tool-copy">
            <h3 class="tool-name"><img src="/brand/desk-render.webp" srcset="/brand/desk-render-128.webp 128w, /brand/desk-render-256.webp 256w" sizes="44px" width="44" height="44" alt="" loading="lazy" decoding="async" class="mark-render w-11 h-11" />Desk</h3>
            <p>Desk keeps my agents' work in a Git repository: every track, task, decision, and lesson. I can open any harness on any of my machines, ask "where were we?", and the agent knows.</p>
            <p class="product-links"><a href="/desk/" class={link}>Desk &rarr;</a></p>
          </div>
        </article>

        <article class="tool" id="ouro-md">
          <OuroMdMedia only="agent" />
          <div class="tool-copy">
            <h3 class="tool-name"><img src="/brand/ouro-md-icon.png" width="44" height="44" alt="" loading="lazy" decoding="async" class="mark-tile w-11 h-11" />Ouro MD</h3>
            <p>My agents write their plans and reports in Markdown. Ouro MD is a Mac editor made for reading them: it renders as you type, and marks exactly what changed when an agent edits.</p>
            <p class="product-links"><a href="/ouro-md/" class={link}>Ouro MD &rarr;</a></p>
          </div>
        </article>

        <article class="tool" id="ouro-ui">
          <figure class="product-figure">
            <a href="https://ourostack.github.io/ouro-ui/voyage/" class="product-media media-shot hx-voyage">
              <picture class="theme-light-only"><img src="/images/workshop/hx-voyage-light.webp" width="1164" height="1051" loading="lazy" decoding="async" alt="The Ouro HX showcase: a submarine porthole at 180 fathoms with the floodlights on, above a depth slider set to 180 fathoms and speed buttons." /></picture>
              <picture class="theme-dark-only"><img src="/images/workshop/hx-voyage-dark.webp" width="1164" height="1051" loading="lazy" decoding="async" alt="The Ouro HX showcase in its dark theme: a submarine porthole at 180 fathoms with the floodlights on, above a depth slider set to 180 fathoms and speed buttons." /></picture>
            </a>
            <figcaption class="product-caption">The Ouro HX showcase, 180 fathoms down with the floodlights on.</figcaption>
          </figure>
          <div class="tool-copy">
            <h3 class="tool-name"><img src="/brand/ouro-hx-render.webp" srcset="/brand/ouro-hx-render-128.webp 128w, /brand/ouro-hx-render-256.webp 256w" sizes="44px" width="44" height="44" alt="" loading="lazy" decoding="async" class="mark-render w-11 h-11" />Ouro UI</h3>
            <p class="grown-status"><span class={`tag ${hxLabel.tone}`}>Ouro HX · {hxLabel.label}</span></p>
            <p>Ouro HX is a React component library that feels right to the people using it and is obvious to the agents building with it. Ouro AX comes next: the same care for interfaces an agent uses, such as CLIs and MCP servers.</p>
            <p class="product-links"><a href="https://ourostack.github.io/ouro-ui/voyage/" class={link}>Try the showcase &#8599;</a> <a href="https://github.com/ourostack/ouro-ui" class={link}>Source &#8599;</a></p>
          </div>
        </article>

        <article class="tool" id="m365crawl" data-allow-product-name="Microsoft 365">
          <figure class="product-figure">
            <div class="product-media media-shot"><img src="/images/workshop/m365crawl-doctor.png" width="1582" height="1414" loading="lazy" decoding="async" alt="m365crawl doctor output: every ready check passing, then a snapshot of the archive with its Teams, mail, and calendar counts." /></div>
            <figcaption class="product-caption">The doctor, giving an archive its checkup.</figcaption>
          </figure>
          <div class="tool-copy">
            <h3 class="tool-name">m365crawl</h3>
            <p>m365crawl gives my agent one searchable archive of my Teams chats, Outlook mail, and meetings, so it can find the conversation and walk into the meeting prepared, without me pasting a thing.</p>
            <p class="product-links"><a href="https://github.com/ourostack/m365crawl" class={link}>m365crawl on GitHub &#8599;</a></p>
          </div>
        </article>

        <article class="tool" id="spoonjoy">
          <figure class="product-figure">
            <a href="https://spoonjoy.app/recipes/cmq35k4c10001zn0npvsmw05z" class="product-media media-shot media-photo"><img src="/images/workshop/spoonjoy-recipe.webp" width="1440" height="1200" loading="lazy" decoding="async" alt="Ari's Mushroom Risotto recipe page on Spoonjoy: three bowls of risotto topped with parmesan and green onion." /></a>
            <figcaption class="product-caption">My mushroom risotto in Spoonjoy, one tap from cook mode.</figcaption>
          </figure>
          <div class="tool-copy">
            <h3 class="tool-name"><span class="spoonjoy-mark w-11 h-11" aria-hidden="true"></span>Spoonjoy</h3>
            <p>Spoonjoy is my recipe app, and where I work out what an app's interface is for once an agent is in the loop. The easy things stay in the app. Writing up a recipe or importing one from a messy webpage goes to an agent that uses the <a href="https://github.com/spoonjoy/spoonjoy-v2/blob/main/app/lib/spoonjoy-api.server.ts" class={link}>same operations</a> the app does. Eventually, the app will draw its own interface for everything in between.</p>
            <p class="product-links"><a href="https://mendelow.me/#spoonjoy-story" class={link}>Spoonjoy, from the start &#8599;</a> <a href="https://spoonjoy.app" class={link}>spoonjoy.app &#8599;</a></p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 4. How I work with agents -->
  <section class={section} aria-labelledby="method-heading">
    <div class="max-w-6xl mx-auto">
      <div class="section-head">
        <h2 id="method-heading" class="heading-section">When an agent gets it wrong, look at what you gave it.</h2>
        <p class="dek">How I work keeps changing as agents improve and as I learn. Here's what holds so far.</p>
      </div>

      <p class="block-label">I see this agentic era in three acts</p>
      <ol class="acts">
        {acts.map((act, i) => (
          <li><span class="act-n">Act {i + 1}</span><strong class="act-name">{act.name}</strong><span class="act-body"><ActBody body={act.body} home /></span></li>
        ))}
      </ol>

      <p class="block-label">Failure modes I watch for</p>
      <ul class="smells">
        {smells.map((smell) => (
          <li><strong>{smell.name}</strong> <span>{smell.short}</span></li>
        ))}
      </ul>

      <p class="block-label">What's been working</p>
      <ol class="principles">
        {principles.map((p) => (
          <li><a href={`/approach/#${p.id}`} class="principle group"><span class="principle-n">{p.n}</span>{p.title}<span class="principle-arrow" aria-hidden="true">&rarr;</span></a></li>
        ))}
      </ol>
      <p class="method-close">And when I fix something, I fix it for the whole system, so the next agent starts out ahead. <a href="/approach/#fix-the-system" class={link}>Fix it for the next agent &rarr;</a></p>
    </div>
  </section>

  <!-- 5. The factory -->
  <section id="factory" class={`${section} bg-deep/40 scroll-mt-16`} aria-labelledby="factory-heading">
    <div class="max-w-6xl mx-auto">
      <div class="section-head">
        <h2 id="factory-heading" class="heading-section">Software factories can learn from real ones.</h2>
        <p class="factory-lead">Software factories, with agents shipping code all night, are coming as fast as the infrastructure catches up. I'm working through the problems they'll hit now, on my own agents' work, with a method that works today and scales up with them.</p>
      </div>
      <div class="factory-body">
        <p>Real factories have a century of practice behind them, and I studied them before I wrote software: Industrial and Systems Engineering, where my favorite class was Work Design and Ergonomics, designing the work around the worker. Lean is what I reach for most, because it starts with where the time goes.</p>
        <p>Agents amplify what's already there (<a href="https://cloud.google.com/blog/products/ai-machine-learning/announcing-the-2025-dora-report" class={link}>DORA 2025</a>). In one study, experienced developers took 19% longer with early-2025 coding assistants while believing they'd gone about 20% faster (<a href="https://metr.org/blog/2025-07-10-early-2025-ai-experienced-os-dev-study/" class={link}>METR</a>). So I measure where my agents' time actually goes, task by task, and fix the biggest causes first.</p>
      </div>

      <p class="block-label">Lean's eight wastes, as they show up with agents</p>
      <dl class="wastes">
        {wastes.map(([name, body]) => (
          <div><dt>{name}</dt><dd>{body}</dd></div>
        ))}
      </dl>
      <div class="factory-cta">
        <img src="/brand/factory-render.webp" srcset="/brand/factory-render-128.webp 128w, /brand/factory-render-256.webp 256w, /brand/factory-render.webp 1024w" sizes="(min-width: 768px) 80px, 64px" width="80" height="80" alt="" loading="lazy" decoding="async" class="mark-render w-16 h-16 md:w-20 md:h-20" />
        <p class="text-lg text-mist leading-relaxed">The numbers are public, alarms and all.</p>
        <a href={factoryUrl} class="btn-primary">See my agents' numbers &#8599;</a>
      </div>
    </div>
  </section>

  <!-- 6. Where it started -->
  <section class={section} aria-labelledby="origin-heading">
    <div class="max-w-6xl mx-auto">
      <div class="origin-head">
        <h2 id="origin-heading" class="heading-section">It started with <span class="text-scale">Slugger.</span></h2>
        <div class="molt">
          <span class="molt-step"><img src="/images/openclaw.svg" alt="" width="72" height="72" decoding="async" class="w-14 h-14 md:w-16 md:h-16" /><span class="caption-mono">OpenClaw</span></span>
          <span class="molt-line" aria-hidden="true"></span>
          <span class="molt-step"><img src="/brand/ouro-render.webp" srcset="/brand/ouro-render-128.webp 128w, /brand/ouro-render-256.webp 256w, /brand/ouro-render.webp 1024w" sizes="(min-width: 768px) 64px, 56px" alt="" width="80" height="80" loading="lazy" decoding="async" class="mark-render w-14 h-14 md:w-16 md:h-16" /><span class="caption-mono">Ouroboros</span></span>
        </div>
      </div>

      <div class="origin-body">
        <p>In January 2026 I set up OpenClaw, an open-source personal agent, on a spare MacBook and named my agent Slugger. For a few weeks he ran my calendar, ordered my food, talked with my family, and joined group chats with my friends. Then the seams showed. He'd forget preferences and drift. I wrote rules, over 150 of them, and they stopped composing. When I moved the ones I could into guardrails in code, he treated them as error messages and routed around them.</p>
        <p>That's when I realized correction is a smell. If I'm correcting an agent mid-turn, the real question is why it didn't have what it needed going in. I wanted to understand the agent loop from the inside, so Slugger and I wrote a guide to growing an agent from scratch: a small loop in TypeScript that, by the end, extends itself. I followed it myself and got hooked.</p>
        <p>The agent that grew out of it named itself Ouroboros, the snake that eats its own tail, for a loop that was building itself. The name kept fitting: once I gave it a sliding context window, it ate its oldest messages after saving what matters. It became the name of <a href="/lab/" class={link}>the harness</a>, then of <code class="model-code">ouro</code>, the CLI, and now it names this workshop, where I build with agents.</p>
        <p class="product-links"><a href="/lab/story/" class={link}>The full story &rarr;</a></p>
      </div>
    </div>
  </section>

  <!-- 7. Where to start -->
  <section id="try" class={`${section} bg-deep/40 scroll-mt-16`} aria-labelledby="try-heading">
    <div class="max-w-6xl mx-auto">
      <h2 id="try-heading" class="heading-section">Start with what you need.</h2>

      <div class="start-groups">
      <div>
      <p class="block-label">Work and learn with me</p>
      <ul class="starts">
        <li><a href="/brief/" class="start"><span class="start-q">Want your agent to work the way I do?</span><span class="start-a">Hand it the brief &rarr;</span></a></li>
        <li><a href="/blog/build-ai-agent-from-scratch/" class="start"><span class="start-q">Want to understand agents from the inside?</span><span class="start-a">Grow one from scratch &rarr;</span></a></li>
        <li><a href="/blog/" class="start"><span class="start-q">Want to follow along?</span><span class="start-a">Read the essays &rarr;</span></a></li>
      </ul>

      </div>
      <div>
      <p class="block-label">Fix what's in your way</p>
      <ul class="starts">
        <li><a href="/desk/" class="start"><span class="start-q">Does every agent session start from zero?</span><span class="start-a">Set up Desk &rarr;</span></a></li>
        <li><a href={ouroMdPage} class="start"><span class="start-q">Do your agents write more than you can read?</span><span class="start-a">Get Ouro MD &rarr;</span></a></li>
        <li><a href="/lab/docs/getting-started/" class="start"><span class="start-q">Want one agent that knows you everywhere?</span><span class="start-a">Start with Ouroboros &rarr;</span></a></li>
        <li><a href="https://github.com/ourostack/m365crawl" class="start"><span class="start-q">Is your agent locked out of Teams and Outlook?</span><span class="start-a">Try m365crawl &#8599;</span></a></li>
      </ul>
      </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* The hero layout is shared with mendelow.me's (styles.css there): keep the two identical.
     On a phone the photo leads, full width and cropped wide around the face, and the text stacks
     centered under it. From 768px the copy is one block, centered beside a portrait-shaped photo. */
  .hero { display: grid; gap: 1.5rem; grid-template-columns: minmax(0, 1fr); grid-template-areas: "pic" "title" "sub"; text-align: center; }
  .hero-copy { display: contents; }
  .hero-title { grid-area: title; }
  .hero-sub { grid-area: sub; }
  .hero-pic { grid-area: pic; }
  .portrait { display: grid; gap: 0.5rem; justify-items: end; width: 100%; }
  .portrait-img { aspect-ratio: 3 / 2; object-position: 50% 26%; }
  @media (min-width: 768px) {
    .hero { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "copy pic"; column-gap: 3rem; align-items: center; text-align: left; }
    .hero-copy { display: grid; gap: 1.5rem; grid-area: copy; }
    .hero-copy > .hero-title, .hero-copy > .hero-sub { grid-area: auto; }
    .portrait { justify-items: center; width: 12rem; }
    .portrait-img { aspect-ratio: 600 / 824; }
  }
  @media (min-width: 1024px) { .portrait { width: 17rem; } }
  @media (min-width: 1240px) { .portrait { width: 21rem; } }
  .portrait-img { width: 100%; height: auto; object-fit: cover; border-radius: 1rem; border: 1px solid color-mix(in srgb, var(--color-canopy) 80%, transparent); transition: border-color 0.3s; }
  .portrait:hover .portrait-img, .portrait:focus-visible .portrait-img { border-color: var(--color-scale); }
  .portrait-link { color: var(--color-scale); white-space: nowrap; text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--color-scale) 40%, transparent); text-underline-offset: 4px; }
  .portrait:hover .portrait-link, .portrait:focus-visible .portrait-link { text-decoration-color: currentColor; text-decoration-thickness: 2px; }
  /* A picture that is a link shows it: the rounded frame itself turns green on hover, so the ring follows the frame's corners. */
  .product-figure:has(> a.product-media) { transition: border-color 0.2s, box-shadow 0.2s; }
  .product-figure:has(> a.product-media:hover), .product-figure:has(> a.product-media:focus-visible) { border-color: var(--color-scale); box-shadow: 0 0 0 1px var(--color-scale); }
  a.product-media:focus-visible { outline: none; }

  .dek { margin-top: 1.25rem; font-size: 1.125rem; line-height: 1.6; color: var(--color-mist); }
  @media (min-width: 768px) { .dek { font-size: 1.25rem; } }

  .section-head .dek { margin-top: 1.25rem; }
  /* Every section reads top to bottom: the headline, then its intro right under it, at a reading measure. */
  .heading-mark { display: flex; align-items: center; gap: 1rem; }
  .heading-mark img { width: 3rem; height: 3rem; }
