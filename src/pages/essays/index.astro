---
import Layout from '../../layouts/Layout.astro'
import { ogPathFor, pageOg } from '../../data/og'

const title = 'Essays on working with agents | Ouroboros'
const description = pageOg['/essays'].subtitle

// Titles and one-line descriptions come from the OG manifest, so the index,
// the essay and its share card say the same thing.
const essays = [
  { href: '/essays/trust-the-agent/', route: '/essays/trust-the-agent', title: 'Trust the Fucking Agent', date: 'May 2026', lead: true },
  { href: '/essays/take-the-agents-seat/', route: '/essays/take-the-agents-seat', title: "Take the agent's seat", date: 'May 2026', lead: true },
  { href: '/essays/stop-being-the-glue/', route: '/essays/stop-being-the-glue', title: 'Stop being the glue', date: 'February 2026' },
  { href: '/essays/designing-with-your-agent/', route: '/essays/designing-with-your-agent', title: 'The work spoke back', date: 'March 2026' },
].map((essay) => ({ ...essay, summary: pageOg[essay.route].subtitle }))
---

<Layout title={title} description={description} ogImage={ogPathFor('/essays')} canonical="https://ouroboros.bot/essays/">
  <section class="px-6 md:px-12 lg:px-16 pt-32 pb-10 md:pt-44">
    <div class="max-w-5xl mx-auto">
      <span class="eyebrow block mb-6">Essays</span>
      <h1 class="heading-lead">Essays</h1>
      <p class="text-lg md:text-xl text-mist leading-relaxed mt-6 max-w-[52ch]">Longer arguments for <a href="/approach/" class="text-scale underline underline-offset-4 decoration-scale/40 hover:text-glow">the approach</a>, in my own words.</p>
    </div>
  </section>

  <section class="px-6 md:px-12 lg:px-16 pb-16">
    <ul class="max-w-5xl mx-auto grid gap-4 md:grid-cols-2">
      {essays.map((essay) => (
        <li>
          <a href={essay.href} class:list={[
            'group h-full rounded-2xl border bg-deep/70 p-6 grid gap-3 content-start hover:border-scale transition-colors',
            essay.lead ? 'border-scale/60' : 'border-canopy/40',
          ]}>
            <span class="caption-mono">{essay.date}</span>
            <h2 class="font-display text-3xl text-bone leading-tight group-hover:text-scale transition-colors">{essay.title}</h2>
            <p class="text-mist">{essay.summary}</p>
            <span class="text-sm text-scale underline underline-offset-4 decoration-scale/40">Read &rarr;</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
