---
import fs from 'node:fs'
import path from 'node:path'
import Layout from '../layouts/Layout.astro'
import PageHero from '../components/PageHero.astro'
import { ogPathFor } from '../data/og'

// The page shows public/brief.md itself, read at build time, so the page and
// the plain-text file an agent fetches can never drift.
const brief = fs.readFileSync(path.join(process.cwd(), 'public', 'brief.md'), 'utf8').trim()

const title = 'Hand this to your agent | Ouro'
const description = 'A one-page brief with the five principles, written for your agent to read. Paste it into whatever agent you use now.'
const link = 'text-scale underline underline-offset-4 decoration-scale/40 hover:text-glow hover:decoration-current hover:decoration-2 transition-colors'
---

<Layout title={title} description={description} ogImage={ogPathFor('/brief')} canonical="https://ouroboros.bot/brief/">
  {/* The words sit above the page's scene, never over it (Ouro HX Hero); the brief itself follows the art. */}
  <PageHero title="Hand this to your agent">
    <Fragment slot="description">
      <p class="m-0">The five principles, written for your agent to read. Paste it into any agent.</p>
      <div class="flex flex-wrap items-center gap-3 mt-6">
        <button type="button" data-copy-target="brief-text" class="inline-flex items-center gap-2 rounded-xl bg-bone text-void px-5 py-3 font-medium hover:bg-scale transition-colors">
          <span data-copy-label="Copy the brief">Copy the brief</span>
        </button>
        <a href="/brief.md" class={`hit ${link} text-sm`}>Or give your agent the link: ouroboros.bot/brief.md</a>
      </div>
    </Fragment>
  </PageHero>

  <section class="px-6 md:px-12 lg:px-16 pb-16">
    <div class="max-w-6xl mx-auto"><pre id="brief-text" class="agent-text">{brief}</pre></div>
  </section>
</Layout>

