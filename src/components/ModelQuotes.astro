---
import modelReviews from '../data/model-reviews.json'

// Each frontier model's own verdict on Ouroboros, straight from the published
// review data, set as plain pull quotes.
---

<ul class="quotes">
  {modelReviews.reviews.map((review) => (
    <li>
      <a href={`/lab/model-reviews/${review.provider}`} class="quote group">
        <span class="quote-text">&#8220;{review.pullQuote}&#8221;</span>
        <span class="quote-who">{review.displayName}<span class="quote-vendor"> · {review.vendor}</span></span>
      </a>
    </li>
  ))}
</ul>

<style>
  /* Four parallel verdicts in a plain grid: two by two from 768px, read left to right. */
  .quotes { display: grid; gap: 2.25rem 3rem; }
  @media (min-width: 768px) { .quotes { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .quote { display: grid; gap: 0.7rem; height: 100%; align-content: start; padding-left: 1.25rem; border-left: 2px solid color-mix(in srgb, var(--color-scale) 55%, transparent); transition: border-color 0.2s; }
  .quote:hover { border-color: var(--color-scale); }
  .quote-text { font-family: var(--font-display); font-size: 1.5rem; line-height: 1.25; color: var(--color-bone); }
  @media (min-width: 1024px) { .quote-text { font-size: 1.75rem; } }
  .quote-who { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-scale); }
  .quote-vendor { color: var(--color-mist); }
</style>
