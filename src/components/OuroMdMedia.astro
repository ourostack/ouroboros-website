---
import WorkshopVideo from './WorkshopVideo.astro'

// The Ouro MD media, verbatim from the copy deck (2026-10-11). The homepage card
// and /ouro-md/ both lead with it, so the two cannot drift.
//
// Each clip comes in a light and a dark recording. CSS shows the one for the
// active theme (the saved data-theme, else the system setting), so the poster
// matches with no JS, and the hidden one never plays or loads its video.
// `only="agent"` shows just the agent-edit clip. Every page uses it now: the typing clip
// scrolls its top heading under the title bar by its last frame, and two stacked
// windows of the same document read as doubled content (taste review, 2026-11-06).
interface Props { stacked?: boolean; only?: 'agent' }
const { stacked = false, only } = Astro.props
const themes = ['light', 'dark'] as const
// Each clip's caption is also its poster's alt text and its video's aria-label,
// so the clip is named programmatically (root final ruling F15).
const typing = 'Lists and flowcharts render as you type.'
const agentEdit = 'An agent fills in its test results, and a bar in the margin marks what changed.'
---

<figure class="product-figure">
  <div class:list={['clip-pair', { 'clip-stack': stacked || only }]}>
    {!only && <figure class="clip">
      <div class="product-media media-clip">
        {themes.map((theme) => <div class={`clip-theme theme-${theme}-only`}><WorkshopVideo src={`/images/workshop/ouro-md-typing-${theme}.mp4`} webm={`/images/workshop/ouro-md-typing-${theme}.webm`} poster={`/images/workshop/ouro-md-typing-${theme}-poster.png`} width={840} height={630} alt={typing} /></div>)}
      </div>
      <figcaption class="product-caption"><span class="caption-note">Dramatization</span> {typing}</figcaption>
    </figure>}
    <figure class="clip">
      <div class="product-media media-clip">
        {themes.map((theme) => <div class={`clip-theme theme-${theme}-only`}><WorkshopVideo src={`/images/workshop/ouro-md-agent-edit-${theme}.mp4`} webm={`/images/workshop/ouro-md-agent-edit-${theme}.webm`} poster={`/images/workshop/ouro-md-agent-edit-${theme}-poster.png`} width={840} height={630} alt={agentEdit} /></div>)}
      </div>
      <figcaption class="product-caption"><span class="caption-note">Dramatization</span> {agentEdit}</figcaption>
    </figure>
  </div>
</figure>
