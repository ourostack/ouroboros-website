---
// The same short route onward at the end of every blog post.
import { deskSetupUrl } from '../data/principles.mjs'
const link = 'text-scale underline underline-offset-4 decoration-scale/40 hover:text-glow hover:decoration-current hover:decoration-2 transition-colors'
---

{/* No card (lesson "No unnecessary cards in UI"): the glowing trail leads out of the essay, and the way onward stands open beneath it. */}
<aside class="post-end trail-top px-6 md:px-12 lg:px-16 pt-14 pb-20" aria-labelledby="post-end-heading" data-post-end>
  <div class="max-w-6xl mx-auto grid gap-3">
    <h2 id="post-end-heading" class="font-display text-3xl md:text-4xl text-bone leading-snug"><a href="/approach/" class={link}>How I work</a></h2>
    <p class="text-mist">To try <a href="/desk/" class={link}>Desk</a>, give your agent <span class="font-mono text-sm text-bone break-all">{deskSetupUrl}</span> and say "set this up".</p>
    <p class="text-mist">Running a team? <a href="/approach/#for-teams" class={link}>Start with four steps</a>.</p>
  </div>
</aside>
