---
import Glossary from './Glossary.astro'
interface Props {
  title: string
  description: string
  eyebrow?: string
  canonical?: string
  intro?: string
  ogImage?: string
  /** The h1 as clauses of phrases, for a two-clause title. Clauses flow inline
      across the full width; .t-clause only marks them for the line checks. "~" inside a phrase marks a break for the narrowest phones
      only. Joined with spaces, it must read exactly as the title. */
  lines?: string[][]
}

const {
  title,
  description,
  eyebrow = 'Operator guide',
  canonical,
  intro,
  ogImage,
  lines,
} = Astro.props
if (lines && lines.map((clause) => clause.join(' ')).join(' ').replaceAll('~', ' ') !== title) throw new Error(`DocsPageShell lines must read as the title: ${title}`)

import Layout from '../layouts/Layout.astro'
import PageHero from './PageHero.astro'
---

<Layout
  title={`${title} | Ouro docs`}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  ogType="article"
  crumbs={[eyebrow]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TechArticle",
      "headline": title,
      "description": description,
      "author": { "@type": "Person", "name": "Ari Mendelow", "url": "https://linkedin.com/in/arimendelow" },
      "publisher": { "@type": "Organization", "name": "Ouro Labs", "url": "https://ouroboros.bot" },
      "url": canonical,
    })} />
  </Fragment>

  <PageHero>
    <Fragment slot="title">{lines ? lines.map((clause, i) => (
      <>{i > 0 && ' '}<span class="t-clause">{clause.map((phrase, j) => (
        <>{j > 0 && ' '}{phrase.includes('~')
          ? <span class="t-ph-soft">{phrase.split('~').map((part, k) => <>{k > 0 && ' '}<span class="t-ph">{part}</span></>)}</span>
          : <span class="t-ph">{phrase}</span>}</>
      ))}</span></>
    )) : title}</Fragment>
    <Fragment slot="description"><p class="m-0">{description}</p></Fragment>
  </PageHero>

  <section class="px-6 md:px-12 lg:px-16 pb-20 md:pb-24">
    <div class="max-w-6xl mx-auto space-y-16">
      <div class="space-y-10">
        {intro && (
          <div class="border-l-2 border-scale/60 pl-6">
            <p class="text-base text-mist leading-relaxed">{intro}</p>
          </div>
        )}
        <Glossary wide />
      </div>
      <slot />
    </div>
  </section>
</Layout>
