---
/*
  The top of a page on Ouro HX's Hero (layout="column"): the eyebrow, the title
  and the lede in the page's column, and the page's scene below them, shown whole
  in that same column. The words never sit over the art.

  The Hero takes the page's column (max-w-6xl) with fullWidth, so the header,
  the art and the body share one edge. The art rises in (motion="rise", its
  keyframes from ouro-base in global.css).

  Slots: "eyebrow" for an eyebrow with markup, such as a status tag (it
  replaces the eyebrow prop), "title" for a title with markup (it replaces the title prop),
  "description" for the lede (a post's lede and its byline), "actions" for
  the links under the lede.

  Astro hands the Hero every named slot as a prop, even one that renders
  nothing ({cond && <Fragment slot="actions">} still makes an "actions" slot),
  and the Hero then draws an empty element for it. So each slot is rendered to
  HTML here and passed as a prop only when it has something in it, wrapped the
  way Astro wraps a slot: in <astro-static-slot>, which Astro removes again
  from a component that isn't hydrated.
*/
import { createElement } from 'react'
import { Hero } from './ouro/hero/hero'
import StoryScene from './StoryScene.astro'
import { sceneFor } from '../data/scenes.mjs'
import { PAGE_HERO_SIZES } from '../data/page-hero.mjs'

interface Props {
  eyebrow?: string
  title?: string
  /** The page's scene; by default the route's hero scene (src/data/scenes.mjs). */
  scene?: string
  class?: string
}

const { eyebrow, title, scene: sceneProp, class: className } = Astro.props
const route = sceneFor(Astro.url.pathname)
const scene = sceneProp ?? route.hero

const filled = async (name: string) => {
  if (!Astro.slots.has(name)) return undefined
  const html = (await Astro.slots.render(name)).trim()
  return html === '' ? undefined : html
}
const asNode = (html: string | undefined) =>
  html === undefined ? undefined : createElement('astro-static-slot', { dangerouslySetInnerHTML: { __html: html } })
const titleHtml = await filled('title')
const heroTitle = titleHtml !== undefined ? asNode(titleHtml) : title
const description = asNode(await filled('description'))
const actions = asNode(await filled('actions'))
const eyebrowHtml = await filled('eyebrow')
const eyebrowText = eyebrowHtml !== undefined ? asNode(eyebrowHtml) : eyebrow?.trim() || undefined
---
<div class:list={['page-hero px-6 md:px-12 lg:px-16 pt-(--nav-h) pb-12 md:pb-14', className]}>
  <div class="max-w-6xl mx-auto">
    <Hero layout="column" fullWidth headingLevel={1} eyebrow={eyebrowText} title={heroTitle} description={description} actions={actions}>
      {scene && <Fragment slot="media"><StoryScene scene={scene} variant="hero" contained sizes={PAGE_HERO_SIZES} product={route.product} /></Fragment>}
    </Hero>
  </div>
</div>
