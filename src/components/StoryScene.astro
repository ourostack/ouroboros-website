---
/*
  StoryScene: one storybook scene, served byte for byte from
  /brand/storybook/ (see scripts/sync-storybook.mjs and src/data/scenes.mjs).

  variant="hero"   the page's arrival: full bleed under the nav, loaded first
                   (fetchpriority high, never lazy), the phone crop below 640px
                   at its own size (4:3, or wider where the cast stands apart).
  variant="inline" a scene further down the page, sized by `sizes`, deferred.
  variant="meadow" the short band above the footer, deferred.
  variant="vignette" a small 4:3 portrait of a product's character beside its
                   name (the phone crop, which frames Ouro and the product), deferred.
  contained        with variant="hero": the art as Ouro HX's Hero media (PageHero),
                   shown whole at its own aspect inside the page's column, loaded
                   first, with no crop, drift or trail.

  The art is never re-encoded or cropped in a build step; CSS crops the
  meadow band with object-fit. Behind it sits the scene's own paint (a tiny
  soft preview, src/data/scene-paint.json), so the dawn is there before, and
  even without, the art. No variant fades into the page: every picture ends
  on a hard edge.
*/
import { scenes, darkScenes, columnHeroes, columnHeroSrcset, wideSrcset, COLUMN_HERO_MEDIA, sceneRatio, phoneSize, heroFrame, thumbPosition } from '../data/scenes.mjs'
import paints from '../data/scene-paint.json'

interface Props {
  scene: string
  variant?: 'hero' | 'inline' | 'meadow' | 'vignette'
  sizes?: string
  alt?: string
  class?: string
  /** A product page's hero: its floor may drop to PRODUCT_FLOOR (heroFrame()). */
  product?: boolean
  /** A hero shown whole inside Ouro HX's Hero (PageHero), not full bleed under the nav. */
  contained?: boolean
}

const { scene, variant = 'inline', sizes, alt, class: className, product = false, contained = false } = Astro.props
if (!(scene in scenes)) throw new Error(`StoryScene: unknown scene ${scene}`)
const base = '/brand/storybook'
const [w, h] = sceneRatio(scene)
// The phone crop's own size (4:3, or 16:9 / 2:1 for the wide-cast scenes); the
// phone box takes this aspect, so the crop is shown whole, never cut again.
const [pw, ph] = phoneSize(scene)
const hero = variant === 'hero'
// The desktop hero keeps the whole cast in frame at every width (taste review
// r5): global.css never lets the box show less of the art than `floor` (the
// cast's `need`, and never under 82%: taste review r8; 76% on a product
// page, for the room under its edge), and
// object-position `y` keeps the whole cast inside whatever it shows, or shows
// the art's own foot where the cast stands on it. Every hero ends on a hard
// edge, closed by the gold trail (global.css): no fade, and no box ever runs
// past its art. Where the feet stand too near that edge for the trail's glow,
// the trail hangs below it (data-trail-below).
const frame = heroFrame(scene, { product })
const phoneAspect = hero && !contained
  ? `--phone-ar: ${pw} / ${ph}; --hero-floor: ${frame.floor}; --hero-arh: ${(h / w).toFixed(4)}; --hero-y: ${frame.y}%`
  : `--phone-ar: ${pw} / ${ph}`
// The scene's own dawn, painted behind the art (scripts/scene-paint.mjs): a
// tiny soft preview of the wide art and of the phone crop, so a slow or failed
// image still shows this scene's sky and meadow, never a blank box or alt text
// (taste review r10).
// A hero with a night version (darkScenes) carries both paints, and global.css
// picks the one for the theme in use.
const night = hero ? darkScenes[scene] : undefined
const paintOf = (s: string) => {
  if (!paints[s]) throw new Error(`StoryScene: no paint for ${s}; run node scripts/scene-paint.mjs`)
  return paints[s]
}
const paint = paintOf(scene)
const paintVars = night
  ? `--paint-day: url(${paint.wide.uri}); --paint-phone-day: url(${paint.phone.uri}); --paint-night: url(${paintOf(night).wide.uri}); --paint-phone-night: url(${paintOf(night).phone.uri})`
  : `--paint: url(${paint.wide.uri}); --paint-phone: url(${paint.phone.uri})`
const style = `${phoneAspect}; ${paintVars}${variant === 'vignette' ? `; --thumb-pos: ${thumbPosition(scene)}` : ''}`
const wideSizes = sizes ?? (variant === 'inline' ? '(min-width: 1024px) 50vw, 100vw' : '100vw')
const phoneSizes = variant === 'inline' ? 'calc(100vw - 2.5rem)' : contained ? (sizes ?? '100vw') : '100vw'
const sources = (s: string) => ({
  phoneAvif: `${base}/phone/${s}-384.avif 384w, ${base}/phone/${s}-768.avif 768w`,
  phoneWebp: `${base}/phone/${s}-384.webp 384w, ${base}/phone/${s}-768.webp 768w`,
  wideAvif: wideSrcset(s, 'avif'),
  wideWebp: wideSrcset(s, 'webp'),
  fallback: `${base}/headers/${s}.webp`,
})
const { phoneAvif, phoneWebp, wideAvif, wideWebp, fallback } = sources(scene)
const altText = alt ?? scenes[scene]
// A hero with a night version is still one picture, so only the art for the
// theme in use is fetched: the day art's sources come first and ask for a light
// color scheme, and the night art (the site's default theme) takes the rest.
// The script after it follows the site's own theme toggle (data-theme), which
// a media query can't see.
const lightScheme = '(prefers-color-scheme: light)'
const day = night ? sources(scene) : undefined
const dark = night ? sources(night) : undefined
const nightAlt = night ? (alt ?? scenes[night]) : undefined
const vignette = variant === 'vignette'
// A column hero (columnHeroes) has its own 2:1 art from 1600px, listed ahead of the
// full-bleed art so it wins there and nowhere else.
const column = hero && night && !contained ? columnHeroes[scene] : undefined
---

<div class:list={['story-scene', contained && hero ? 'story-contained' : `story-${variant}`, className]} data-brand-scene={scene} data-night-scene={night} data-trail-below={hero && !contained && frame.trailBelow ? '' : undefined} data-hero-column={column ? '' : undefined} style={style}>
  {hero && day && dark ? (
    <>
      <picture>
        <source media={`(max-width: 640px) and ${lightScheme}`} data-media="(max-width: 640px)" data-theme-art="light" type="image/avif" srcset={day.phoneAvif} sizes={phoneSizes} width={pw} height={ph} />
        <source media={`(max-width: 640px) and ${lightScheme}`} data-media="(max-width: 640px)" data-theme-art="light" type="image/webp" srcset={day.phoneWebp} sizes={phoneSizes} width={pw} height={ph} />
        <source media="(max-width: 640px)" data-media="(max-width: 640px)" data-theme-art="dark" type="image/avif" srcset={dark.phoneAvif} sizes={phoneSizes} width={pw} height={ph} />
        <source media="(max-width: 640px)" data-media="(max-width: 640px)" data-theme-art="dark" type="image/webp" srcset={dark.phoneWebp} sizes={phoneSizes} width={pw} height={ph} />
        {column && (
          <>
            <source media={`${COLUMN_HERO_MEDIA} and ${lightScheme}`} data-media={COLUMN_HERO_MEDIA} data-theme-art="light" type="image/avif" srcset={columnHeroSrcset(scene, 'avif')} sizes={column.sizes} width="1152" height="576" />
            <source media={`${COLUMN_HERO_MEDIA} and ${lightScheme}`} data-media={COLUMN_HERO_MEDIA} data-theme-art="light" type="image/webp" srcset={columnHeroSrcset(scene, 'webp')} sizes={column.sizes} width="1152" height="576" />
            <source media={COLUMN_HERO_MEDIA} data-media={COLUMN_HERO_MEDIA} data-theme-art="dark" type="image/avif" srcset={columnHeroSrcset(night, 'avif')} sizes={column.sizes} width="1152" height="576" />
            <source media={COLUMN_HERO_MEDIA} data-media={COLUMN_HERO_MEDIA} data-theme-art="dark" type="image/webp" srcset={columnHeroSrcset(night, 'webp')} sizes={column.sizes} width="1152" height="576" />
          </>
        )}
        <source media={lightScheme} data-media="" data-theme-art="light" type="image/avif" srcset={day.wideAvif} sizes={wideSizes} width={w} height={h} />
        <source media={lightScheme} data-media="" data-theme-art="light" type="image/webp" srcset={day.wideWebp} sizes={wideSizes} width={w} height={h} />
        <source data-media="" data-theme-art="dark" type="image/avif" srcset={dark.wideAvif} sizes={wideSizes} width={w} height={h} />
        <source data-media="" data-theme-art="dark" type="image/webp" srcset={dark.wideWebp} sizes={wideSizes} width={w} height={h} />
        <img src={dark.fallback} data-light-src={day.fallback} data-dark-src={dark.fallback} width={w} height={h} alt={nightAlt} data-light-alt={altText} data-dark-alt={nightAlt} fetchpriority="high" />
      </picture>
      {/* A chosen theme (data-theme, Nav.astro) wins over the system's: the other
          art's sources are switched off, and the alt follows what is shown. */}
      <script is:inline>
        (function () {
          var pic = document.currentScript.previousElementSibling, img = pic.querySelector('img'), root = document.documentElement;
          var light = matchMedia('(prefers-color-scheme: light)');
          var set = function (el, name, value) {
            if (value == null || value === '') { if (el.hasAttribute(name)) el.removeAttribute(name); }
            else if (el.getAttribute(name) !== value) el.setAttribute(name, value);
          };
          var sync = function () {
            var chosen = root.dataset.theme === 'light' || root.dataset.theme === 'dark' ? root.dataset.theme : '';
            var shown = chosen || (light.matches ? 'light' : 'dark');
            pic.querySelectorAll('source').forEach(function (s) {
              var base = s.getAttribute('data-media'), art = s.getAttribute('data-theme-art');
              set(s, 'media', chosen ? (art === chosen ? base : 'not all')
                : art === 'light' ? (base ? base + ' and ' : '') + '(prefers-color-scheme: light)' : base);
            });
            set(img, 'src', img.getAttribute('data-' + (chosen || 'dark') + '-src'));
            set(img, 'alt', img.getAttribute('data-' + shown + '-alt'));
          };
          sync();
          new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
          light.addEventListener('change', sync);
        })();
      </script>
    </>
  ) : hero ? (
    <picture>
      <source media="(max-width: 640px)" type="image/avif" srcset={phoneAvif} sizes={phoneSizes} width={pw} height={ph} />
      <source media="(max-width: 640px)" type="image/webp" srcset={phoneWebp} sizes={phoneSizes} width={pw} height={ph} />
      <source type="image/avif" srcset={wideAvif} sizes={wideSizes} width={w} height={h} />
      <source type="image/webp" srcset={wideWebp} sizes={wideSizes} width={w} height={h} />
      <img src={fallback} width={w} height={h} alt={altText} fetchpriority="high" />
    </picture>
  ) : vignette ? (
    <>
      <picture data-defer>
        <source type="image/avif" data-srcset={phoneAvif} sizes={sizes ?? '8rem'} width={pw} height={ph} />
        <source type="image/webp" data-srcset={phoneWebp} sizes={sizes ?? '8rem'} width={pw} height={ph} />
        <img data-src={`${base}/phone/${scene}-384.webp`} width={pw / 2} height={ph / 2} alt={altText} loading="lazy" decoding="async" />
      </picture>
      <noscript><img src={`${base}/phone/${scene}-384.webp`} width={pw / 2} height={ph / 2} alt={altText} loading="lazy" decoding="async" /></noscript>
    </>
  ) : (
    <>
      {/* Deferred: the sources wait in data-srcset until the hero has landed and the
          scene is near (Layout.astro), so the arrival gets the whole connection. */}
      <picture data-defer={variant === 'meadow' ? 'far' : ''}>
        <source media="(max-width: 640px)" type="image/avif" data-srcset={phoneAvif} sizes={phoneSizes} width={pw} height={ph} />
        <source media="(max-width: 640px)" type="image/webp" data-srcset={phoneWebp} sizes={phoneSizes} width={pw} height={ph} />
        <source type="image/avif" data-srcset={wideAvif} sizes={wideSizes} width={w} height={h} />
        <source type="image/webp" data-srcset={wideWebp} sizes={wideSizes} width={w} height={h} />
        <img data-src={fallback} width={w} height={h} alt={altText} loading="lazy" decoding="async" />
      </picture>
      <noscript><img src={fallback} width={w} height={h} alt={altText} loading="lazy" decoding="async" /></noscript>
    </>
  )}
</div>
