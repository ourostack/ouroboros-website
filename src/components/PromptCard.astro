---
// A prompt or command to copy. Only the copyable text wears a frame; the label
// sits above it in the page's own type, not in a header strip (taste review r2).
interface Props {
  label?: string
  prompt: string
  footnote?: string
}

const { label = 'Ask your agent', prompt, footnote } = Astro.props
---

<div class="prompt-card">
  <div class="flex items-center justify-between gap-4 mb-2">
    <p class="prompt-label">{label}</p>
    <button
      class="prompt-copy-btn flex flex-none items-center gap-2 text-xs text-mist hover:text-bone transition-colors font-mono uppercase tracking-[0.18em] cursor-pointer"
      data-prompt={prompt}
    >
      <svg class="prompt-copy-icon w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2" stroke-width="2" />
        <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" stroke-width="2" />
      </svg>
      <svg class="prompt-check-icon w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
      <span class="prompt-copy-label">Copy</span>
    </button>
  </div>
  <pre class="prompt-frame font-mono text-sm text-bone leading-relaxed whitespace-pre-wrap">{prompt}</pre>
  {footnote && (
    <p class="text-sm text-mist mt-3 leading-relaxed">{footnote}</p>
  )}
</div>

<style>
  .prompt-label { font-family: var(--font-display); font-size: 1.35rem; line-height: 1.2; color: var(--color-bone); }
  .prompt-frame { margin: 0; padding: 0.9rem 1.1rem; border-radius: 0.75rem; border: 1px solid color-mix(in srgb, var(--color-canopy) 70%, transparent); background: color-mix(in srgb, var(--color-deep) 60%, transparent); }
</style>

<script>
  document.querySelectorAll('.prompt-copy-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var prompt = btn.getAttribute('data-prompt');
      if (!prompt) return;
      navigator.clipboard.writeText(prompt).then(function() {
        var copyIcon = btn.querySelector('.prompt-copy-icon');
        var checkIcon = btn.querySelector('.prompt-check-icon');
        var label = btn.querySelector('.prompt-copy-label');
        if (copyIcon) copyIcon.classList.add('hidden');
        if (checkIcon) checkIcon.classList.remove('hidden');
        if (label) label.textContent = 'Copied';
        setTimeout(function() {
          if (copyIcon) copyIcon.classList.remove('hidden');
          if (checkIcon) checkIcon.classList.add('hidden');
          if (label) label.textContent = 'Copy';
        }, 2000);
      });
    });
  });
</script>
