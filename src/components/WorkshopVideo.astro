---
import fs from 'node:fs'
import path from 'node:path'

/**
 * A short clip with its poster. It loads nothing but the poster until it is on
 * screen, then plays muted and looped. Under reduced motion, with Save-Data,
 * or without JS, the poster stays. Until the clip file exists in public/, only
 * the poster renders, so a clip can be dropped in without touching the page.
 *
 * An optional WebM goes first, and the MP4 is the fallback.
 *
 * The poster waits in data-poster until the page's storybook hero has landed
 * (Layout.astro marks <html data-arrived>), and only the clip for the active
 * theme fetches it, so a slow phone spends its first bytes on the arrival.
 * Without JS, a <noscript> image shows the poster instead.
 *
 * Once a clip plays, a visible Pause/Play button appears on it (WCAG 2.2.2).
 * A clip the reader paused stays paused when it scrolls back into view.
 */
interface Props { src: string; webm?: string; poster: string; width: number; height: number; alt?: string }
const { src, webm, poster, width, height, alt = '' } = Astro.props
const hasClip = fs.existsSync(path.join(process.cwd(), 'public', src))
---

{hasClip ? (
  <div class="workshop-clip" data-workshop-clip>
    <video class="workshop-video" muted playsinline loop preload="none" data-poster={poster} width={width} height={height} aria-label={alt || undefined} data-workshop-video>
      {webm && <source src={webm} type="video/webm" />}
      <source src={src} type="video/mp4" />
    </video>
    <noscript><img class="workshop-video clip-noscript" src={poster} width={width} height={height} alt="" /></noscript>
    <button type="button" class="clip-toggle hit" data-clip-toggle hidden>Pause</button>
  </div>
) : (
  <img class="workshop-video" src={poster} width={width} height={height} loading="lazy" decoding="async" alt={alt} data-clip-pending={src} />
)}

<script>
  // Posters: set once the arrival has landed, and only on the clips that show.
  const showPosters = () => {
    document.querySelectorAll<HTMLVideoElement>('video[data-poster]').forEach((video) => {
      if (video.offsetParent !== null || video.getClientRects().length) { video.poster = video.dataset.poster!; delete video.dataset.poster }
    })
  }
  const whenArrived = () => {
    showPosters()
    new MutationObserver(showPosters).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] })
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', showPosters)
  }
  if (document.documentElement.hasAttribute('data-arrived')) whenArrived()
  else document.addEventListener('story:arrived', whenArrived, { once: true })

  const clips = document.querySelectorAll<HTMLElement>('[data-workshop-clip]')
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true
  if (clips.length && !reduce && !saveData && 'IntersectionObserver' in window) {
    const paused = new WeakSet<HTMLVideoElement>()
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const video = entry.target as HTMLVideoElement
        if (entry.isIntersecting && !paused.has(video)) video.play().catch(() => {})
        else video.pause()
      }
    }, { threshold: 0.5 })
    clips.forEach((clip) => {
      const video = clip.querySelector<HTMLVideoElement>('video[data-workshop-video]')
      const toggle = clip.querySelector<HTMLButtonElement>('[data-clip-toggle]')
      if (!video || !toggle) return
      video.addEventListener('play', () => { toggle.hidden = false; toggle.textContent = 'Pause' })
      video.addEventListener('pause', () => { toggle.textContent = 'Play' })
      toggle.addEventListener('click', () => {
        if (video.paused) { paused.delete(video); video.play().catch(() => {}) }
        else { paused.add(video); video.pause() }
      })
      io.observe(video)
    })
  }
</script>

<style>
  .workshop-video { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .workshop-clip { position: relative; width: 100%; height: 100%; }
  /* The demo's Pause/Play: one size on both sites (taste review r16: it was
     60x31 here and 51x28 on ouro.bot). A fixed box, so Pause and Play are the
     same width, and the shared .hit area reaches out to 44x44 for a finger
     while staying inside the frame. scripts/hit-areas.mjs probes it. */
  .clip-toggle { position: absolute; right: 0.6rem; bottom: 0.6rem; display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; min-width: 4.25rem; height: 2rem; padding: 0 0.85rem; border-radius: 999px; font: 500 0.8125rem/1 var(--font-body); color: var(--color-bone); background: color-mix(in srgb, var(--color-void) 85%, transparent); border: 1px solid color-mix(in srgb, var(--color-canopy) 80%, transparent); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); cursor: pointer; }
  .clip-toggle:hover { color: var(--color-scale); }
  .clip-toggle[hidden] { display: none; }
  .clip-noscript { position: absolute; inset: 0; }
</style>
