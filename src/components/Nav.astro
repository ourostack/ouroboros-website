---
import { navLinks, githubOrg, sisterNav } from '../data/site.mjs'

const currentPath = Astro.url.pathname
// The longest matching link is the active one, so /lab/story/ lights Story, not Lab too.
const active = navLinks.map((l) => l.href).filter((href) => currentPath.startsWith(href)).sort((a, b) => b.length - a.length)[0]
const isActive = (href: string) => href === active
const isHomepage = currentPath === '/'
// The arrow is decoration; screen readers read only the words.
const sisterText = sisterNav.label.replace(/↗$/, '')
const sisterArrow = sisterNav.label.endsWith('↗') ? '↗' : ''
---

<nav class="fixed top-0 inset-x-0 z-40" id="main-nav" aria-label="Main" data-homepage={isHomepage ? 'true' : undefined}>
  <div id="nav-bg" class:list={[
    'transition-all duration-500',
    isHomepage ? 'bg-transparent' : 'bg-deep/75 backdrop-blur-lg border-b border-canopy/15'
  ]}>
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4 h-16 px-4 sm:px-6 md:px-12 lg:px-16">
      <a href="/" class="brand-home group flex items-center gap-3 text-bone" aria-label="Ouro home">
        <img src="/brand/ouro-render.webp" srcset="/brand/ouro-render-128.webp 128w, /brand/ouro-render-256.webp 256w, /brand/ouro-render.webp 1024w" sizes="32px" width="32" height="32" alt="" class="mark-render brand-mark w-8 h-8" />
        <span class="font-display text-xl xl:text-2xl">ouro</span>
      </a>

      <div class="hidden lg:flex items-center gap-6 xl:gap-8">
        {navLinks.map(link => (
          <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined} class:list={[
            'font-display text-base xl:text-lg tracking-wide transition-colors duration-200',
            isActive(link.href) ? 'text-scale' : 'text-mist hover:text-scale'
          ]}>
            {link.label}
          </a>
        ))}
        <a href={githubOrg} target="_blank" rel="noopener" class="text-mist hover:text-scale transition-colors" aria-label="ourostack on GitHub">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        </a>
        <a href={sisterNav.href} class="font-display text-base xl:text-lg tracking-wide text-mist hover:text-scale transition-colors duration-200">{sisterText}<span aria-hidden="true">{sisterArrow}</span></a>
      </div>

      <div class="flex items-center gap-2 lg:ml-0 -mr-2 lg:mr-0">
        <button type="button" id="theme-toggle" class="p-2 text-mist hover:text-scale transition-colors" aria-label="Switch to light theme" title="Light or dark">
          <svg class="w-5 h-5 theme-icon-sun" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path stroke-linecap="round" d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="w-5 h-5 theme-icon-moon" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linejoin="round" d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
        </button>
        <button class="lg:hidden p-2 text-mist hover:text-scale transition-colors" id="menu-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
          <svg class="w-6 h-6" id="menu-icon-open" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="w-6 h-6 hidden" id="menu-icon-close" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden fixed inset-0 top-16 bg-deep/95 backdrop-blur-2xl z-30">
    <div class="flex flex-col items-center gap-7 pt-14 px-6 text-center">
      {navLinks.map(link => (
        <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined} class:list={[
          'font-display text-3xl tracking-wide transition-colors duration-200',
          isActive(link.href) ? 'text-scale' : 'text-mist hover:text-scale'
        ]}>
          {link.label}
        </a>
      ))}
      <a href={githubOrg} target="_blank" rel="noopener" class="text-mist hover:text-scale transition-colors mt-2 font-display text-xl">
        GitHub &#8599;
      </a>
      <a href={sisterNav.href} class="font-display text-3xl tracking-wide text-mist hover:text-scale transition-colors duration-200">{sisterText}<span aria-hidden="true">{sisterArrow}</span></a>
    </div>
  </div>
</nav>

<style>
  @media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
    .brand-mark { transition: transform 0.5s var(--ease-expo); }
    .brand-home:hover .brand-mark { transform: rotate(25deg); }
  }
</style>

<script is:inline>
  // Theme toggle. The <head> script in Layout.astro applies a saved choice
  // before paint; this flips it and remembers it.
  (function () {
    var button = document.getElementById('theme-toggle');
    if (!button) return;
    var root = document.documentElement;
    function current() {
      return root.dataset.theme || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    }
    function label() { button.setAttribute('aria-label', current() === 'dark' ? 'Switch to light theme' : 'Switch to dark theme'); }
    label();
    button.addEventListener('click', function () {
      var next = current() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (e) {}
      label();
    });
  })();
</script>
<script is:inline>
  (function() {
    var toggle = document.getElementById('menu-toggle');
    var menu = document.getElementById('mobile-menu');
    var iconOpen = document.getElementById('menu-icon-open');
    var iconClose = document.getElementById('menu-icon-close');
    if (toggle) {
      toggle.addEventListener('click', function() {
        var isOpen = !menu.classList.contains('hidden');
        menu.classList.toggle('hidden');
        iconOpen.classList.toggle('hidden');
        iconClose.classList.toggle('hidden');
        toggle.setAttribute('aria-expanded', String(!isOpen));
        document.body.style.overflow = isOpen ? '' : 'hidden';
      });
    }
    if (menu) {
      menu.querySelectorAll('a').forEach(function(link) {
        link.addEventListener('click', function() {
          menu.classList.add('hidden');
          iconOpen.classList.remove('hidden');
          iconClose.classList.add('hidden');
          toggle.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        });
      });
    }
    // Homepage: transparent at the very top, glass as soon as anything scrolls under it (1px).
    var nav = document.getElementById('main-nav');
    var navBg = document.getElementById('nav-bg');
    if (nav && nav.dataset.homepage && navBg) {
      var scrolled = false;
      function updateNav() {
        var shouldBeOpaque = window.scrollY > 0;
        if (shouldBeOpaque !== scrolled) {
          scrolled = shouldBeOpaque;
          if (scrolled) {
            navBg.classList.remove('bg-transparent');
            navBg.classList.add('bg-deep/75', 'backdrop-blur-lg', 'border-b', 'border-canopy/15');
          } else {
            navBg.classList.add('bg-transparent');
            navBg.classList.remove('bg-deep/75', 'backdrop-blur-lg', 'border-b', 'border-canopy/15');
          }
        }
      }
      window.addEventListener('scroll', updateNav, { passive: true });
      updateNav();
    }
  })();
</script>
