---
import { navLinks, familyLinks, familyCurrent, localHref } from '../data/site.mjs'

const currentPath = Astro.url.pathname
// The longest matching link is the active one, so /lab/story/ lights Story, not Lab too.
const active = navLinks.map((l) => l.href).filter((href) => currentPath.startsWith(href)).sort((a, b) => b.length - a.length)[0]
const isActive = (href: string) => href === active
// The family links (src/data/family.json) carry the other sites; the phone
// menu lists them too, under the site's own sections, the current one marked.
const current = familyCurrent(currentPath)
---

{/* Sticky under the family bar: the bar scrolls away, and the nav holds the top. */}
<nav class="sticky top-0 z-40" id="main-nav" aria-label="Primary">
  {/* The header reads cleanly over the bright dawn on every page: paper (or
      night) over the page's own ground, so it is opaque and nothing shows or
      smears under the words, with a thin line of trail light along its foot. */}
  <div id="nav-bg" class="nav-glass">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4 h-(--nav-h) px-6 md:px-12 lg:px-16">
      <a href="/" class="brand-home group flex items-center gap-3 min-h-11 text-bone" aria-label="Ouro home">
        <img src="/brand/ouro-render.webp" srcset="/brand/ouro-render-128.webp 128w, /brand/ouro-render-256.webp 256w, /brand/ouro-render.webp 1024w" sizes="32px" width="32" height="32" alt="" class="mark-render brand-mark w-8 h-8 lg:w-7 lg:h-7" />
        <span class="font-display text-xl xl:text-2xl">ouro</span>
      </a>

      <div class="hidden lg:flex items-center gap-6 xl:gap-8">
        {navLinks.map(link => (
          <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined} class:list={[
            'font-display text-lg xl:text-xl tracking-wide transition-colors duration-200',
            isActive(link.href) ? 'text-scale' : 'text-bone/85 hover:text-scale'
          ]}>
            {link.label}
          </a>
        ))}
      </div>

      {/* On a phone the bar keeps the page's 24px gutter: the mark's left edge and the
          menu icon's right edge sit on it, and each button is a 44px tap target
          whose padding hangs into the gutter (taste review r13). */}
      <div class="flex items-center gap-2 lg:ml-0 -mr-2.5 lg:mr-0">
        <button type="button" id="theme-toggle" class="p-3 lg:p-2 text-mist hover:text-scale transition-colors" aria-label="Switch to light theme" title="Light or dark">
          <svg class="w-5 h-5 theme-icon-sun" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path stroke-linecap="round" d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="w-5 h-5 theme-icon-moon" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linejoin="round" d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
        </button>
        <button class="lg:hidden p-2.5 text-mist hover:text-scale transition-colors" id="menu-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
          <svg class="w-6 h-6" id="menu-icon-open" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="w-6 h-6 hidden" id="menu-icon-close" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden fixed inset-x-0 bottom-0 bg-deep z-30">
    <div class="menu-links flex flex-col items-center px-6 text-center">
      {navLinks.map(link => (
        <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined} class:list={[
          'font-display text-3xl tracking-wide transition-colors duration-200',
          isActive(link.href) ? 'text-scale' : 'text-mist hover:text-scale'
        ]}>
          {link.label}
        </a>
      ))}
      <div class="menu-family-group">
        <p class="menu-family-heading" id="menu-family-heading">Ouro family</p>
        <ul class="menu-family" aria-labelledby="menu-family-heading">
          {familyLinks.map((link) => (
            <li><a href={localHref(link.href)} aria-current={link.id === current ? 'true' : undefined}>{link.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</nav>

<style>
  /* The bar that sticks is opaque: the page's ground, under the nav's paper,
     so what scrolls beneath is covered, not drawn through it (Ouro check's
     overlap rule reads the sticky element's own background). */
  #main-nav { background: var(--color-void); }
  .nav-glass {
    position: relative;
    background: color-mix(in srgb, var(--color-deep) 94%, transparent);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--color-canopy) 40%, transparent);
  }
  /* While the phone menu is open the bar is solid too, so the bar and the
     panel read as one sheet and no page text shows through either (taste
     review r6). Only the colour changes: the filter stays, so nothing moves. */
  #main-nav:has(#menu-toggle[aria-expanded="true"]) .nav-glass { background: var(--color-deep); }
  /* The panel drops from the nav's foot (--menu-top, set when it opens: the
     family bar above may still show), scrolls on its own when its links
     outrun a short screen, and a swipe inside it never reaches the page
     (taste review r7). */
  #mobile-menu { top: var(--menu-top, 4rem); overflow-y: auto; overscroll-behavior: contain; }
  /* Every link fits without scrolling down to a 320x568 phone (Ari's ruling,
     taste review r14: the last two hid below the fold with no cue): the
     site's four sections, then the family's seven sites under a small
     heading in a two-column grid, four rows. Each link is a 44px tap target;
     the space left over (the viewport less the panel's top, eight 2.75rem
     rows and the heading's 1.75rem) goes to the
     padding and the gaps, which tighten on short screens and open up on tall
     ones. The panel's own scroll stays the fallback for anything shorter. */
  #mobile-menu .menu-links {
    --menu-spare: calc(100dvh - var(--menu-top, 4rem) - 8 * 2.75rem - 1.75rem);
    --menu-pad: clamp(1rem, calc(var(--menu-spare) / 7), 3rem);
    padding-block: var(--menu-pad);
    gap: clamp(0.125rem, calc((var(--menu-spare) - 2 * var(--menu-pad)) / 8), 1.5rem);
  }
  /* An inline-block, not a flex box, so a label keeps its spaces. */
  #mobile-menu .menu-links a { display: inline-block; padding-block: 0.25rem; min-height: 2.75rem; }
  /* Below 40rem the family bar gives way to this list (Layout.astro), so it
     is where a phone finds the other sites: a small heading on the hairline,
     then the seven in the bar's own face and weight, a step larger. */
  #mobile-menu .menu-family-group { width: 100%; margin-top: clamp(0.25rem, calc(var(--menu-spare) / 10), 1.5rem); padding-top: clamp(0.25rem, calc(var(--menu-spare) / 10), 1.5rem); border-top: 1px solid color-mix(in srgb, var(--color-canopy) 45%, transparent); }
  #mobile-menu .menu-family-heading { height: 1.75rem; margin: 0; font-family: var(--font-body); font-size: 0.875rem; font-weight: 500; line-height: 1.75rem; letter-spacing: 0.04em; color: var(--color-mist); }
  #mobile-menu .menu-family { display: grid; grid-template-columns: repeat(2, minmax(0, 10rem)); justify-content: center; gap: 0 1.5rem; width: 100%; margin: 0; padding: 0; list-style: none; }
  #mobile-menu .menu-family a { display: flex; align-items: center; justify-content: center; min-height: 2.75rem; padding: 0; font-family: var(--font-body); font-size: 1rem; font-weight: 400; color: var(--color-mist); text-decoration: none; }
  #mobile-menu .menu-family a:hover { color: var(--color-scale); }
  /* The site you are on: ink colour and a line of trail light under it, never colour alone. */
  #mobile-menu .menu-family a[aria-current="true"] { color: var(--color-bone); text-decoration-line: underline; text-decoration-color: var(--color-scale); text-decoration-thickness: 2px; text-underline-offset: 0.4em; }
  :global(html.menu-open) { overflow: hidden; }
  .nav-glass::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -1px; height: 1px;
    pointer-events: none;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, #F4B63F 70%, transparent) 30%, color-mix(in srgb, #FFE7A3 80%, transparent) 50%, color-mix(in srgb, #F4B63F 70%, transparent) 70%, transparent);
    opacity: 0.6;
  }
  @media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
    .brand-mark { transition: transform 0.5s var(--ease-expo); }
    .brand-home:hover .brand-mark { transform: rotate(25deg); }
  }
</style>

<script is:inline>
  // Theme toggle. The <head> script in Layout.astro applies a saved choice
  // before paint; this flips it and remembers it.
  (function () {
    var button = document.getElementById('theme-toggle');
    if (!button) return;
    var root = document.documentElement;
    function current() {
      return root.dataset.theme || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    }
    function label() { button.setAttribute('aria-label', current() === 'dark' ? 'Switch to light theme' : 'Switch to dark theme'); }
    label();
    button.addEventListener('click', function () {
      var next = current() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (e) {}
      label();
    });
  })();
</script>
<script is:inline>
  // The phone menu: the toggle opens and closes it; a link, Escape or the
  // toggle again closes it, as does a tap outside the links. While it is open the page behind is inert;
  // closing unlocks it and hands focus back to the toggle so a keyboard reader is never left stranded.
  (function() {
    var toggle = document.getElementById('menu-toggle');
    var menu = document.getElementById('mobile-menu');
    var iconOpen = document.getElementById('menu-icon-open');
    var iconClose = document.getElementById('menu-icon-close');
    if (!toggle || !menu) return;
    function isOpen() { return !menu.classList.contains('hidden'); }
    // While the menu is open, everything it covers is inert, so Tab walks the
    // menu and the bar's buttons, never the page hidden behind the panel
    // (taste review r4). The home mark goes inert too, keeping the keyboard in the menu.
    var nav = document.getElementById('main-nav');
    function behind() {
      // The family bar stays live while it is wholly on screen, above the
      // panel, so its links work. Once the page has scrolled it away it goes
      // inert, or Tab would reach it and scroll the locked page back up.
      var liveBar = function (el) { return el.classList && el.classList.contains('family-bar-wrap') && el.getBoundingClientRect && el.getBoundingClientRect().top >= 0 && el.getBoundingClientRect().height > 0; };
      var els = Array.prototype.filter.call(document.body.children, function (el) { return el !== nav && el.tagName !== 'SCRIPT' && !liveBar(el); });
      nav.querySelectorAll('.brand-home').forEach(function (el) { els.push(el); });
      return els;
    }
    function setOpen(open, refocus) {
      // The panel starts at the nav's foot, wherever the page has scrolled the family bar to.
      if (open && nav.getBoundingClientRect && menu.style && menu.style.setProperty) menu.style.setProperty('--menu-top', Math.max(0, nav.getBoundingClientRect().bottom) + 'px');
      behind().forEach(function (el) { if (open) el.setAttribute('inert', ''); else el.removeAttribute('inert'); });
      menu.classList.toggle('hidden', !open);
      iconOpen.classList.toggle('hidden', open);
      iconClose.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      // Lock the viewport itself. html carries overflow-x: clip (global.css),
      // so body's overflow never reaches the viewport, and the page scrolled
      // behind the open menu (taste review r7). Locking <html> moves nothing,
      // and the scroll position is kept for closing. Body is left alone: an
      // overflow on it would make it the sticky nav's scroller, and the nav
      // would drop back under the family bar, off a scrolled screen.
      document.documentElement.classList.toggle('menu-open', open);
      if (!open && refocus) toggle.focus();
    }
    toggle.addEventListener('click', function() { setOpen(!isOpen(), true); });
    menu.querySelectorAll('a').forEach(function(link) {
      link.addEventListener('click', function() { setOpen(false, false); });
    });
    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape' && isOpen()) setOpen(false, true);
    });
    // A tap on the panel's open space, or anywhere outside the panel and the
    // toggle, closes it too.
    document.addEventListener('click', function(event) {
      if (!isOpen() || toggle.contains(event.target)) return;
      if (event.target === menu || event.target === menu.firstElementChild || !menu.contains(event.target)) setOpen(false, true);
    });
    // A swipe closes it too (taste review r17, 2026-11-07: no swipe did). The
    // panel drops from the bar, so a swipe down the panel or back up toward
    // the bar closes it. The panel follows the finger, closes past a short
    // threshold (or on a quick flick), and springs back under it. When the
    // links outrun the screen and the panel scrolls, a swipe that would
    // scroll it scrolls it instead. Under reduced motion nothing follows the
    // finger and it closes at once. scripts/menu-swipe.mjs drives it with
    // touch events.
    (function swipeToClose() {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      var THRESHOLD = 64, FLICK = 0.5, SLOP = 10;
      var start = null, dy = 0, dragging = false;
      function reset(animate) {
        menu.style.transition = animate && !reduce.matches ? 'transform 0.28s cubic-bezier(0.2, 0.9, 0.3, 1.2)' : '';
        menu.style.transform = '';
        if (animate) setTimeout(function () { menu.style.transition = ''; }, 300);
      }
      function close() {
        if (reduce.matches) { reset(false); setOpen(false, true); return; }
        menu.style.transition = 'transform 0.2s ease-in';
        menu.style.transform = 'translateY(' + (dy > 0 ? '100%' : '-100%') + ')';
        setTimeout(function () { setOpen(false, true); reset(false); }, 200);
      }
      menu.addEventListener('touchstart', function (e) {
        if (e.touches.length !== 1) { start = null; return; }
        start = { x: e.touches[0].clientX, y: e.touches[0].clientY, t: Date.now(), top: menu.scrollTop };
        dy = 0; dragging = false;
      }, { passive: true });
      menu.addEventListener('touchmove', function (e) {
        if (!start) return;
        var mx = e.touches[0].clientX - start.x, my = e.touches[0].clientY - start.y;
        if (!dragging) {
          if (Math.abs(my) < SLOP || Math.abs(mx) > Math.abs(my)) return;
          // A swipe the panel can scroll with is a scroll, not a close.
          var canUp = menu.scrollTop > 0, canDown = menu.scrollTop + menu.clientHeight < menu.scrollHeight - 1;
          if ((my > 0 && canUp) || (my < 0 && canDown)) { start = null; return; }
          dragging = true;
        }
        e.preventDefault();
        dy = my;
        if (!reduce.matches) {
          menu.style.transition = '';
          menu.style.transform = 'translateY(' + dy + 'px)';
        }
      }, { passive: false });
      function end() {
        if (!start) return;
        var fast = Math.abs(dy) / Math.max(1, Date.now() - start.t) > FLICK && Math.abs(dy) > 24;
        var was = dragging;
        start = null; dragging = false;
        if (!was) return;
        if (Math.abs(dy) >= THRESHOLD || fast) close();
        else reset(true);
      }
      menu.addEventListener('touchend', end);
      menu.addEventListener('touchcancel', function () { if (start) { start = null; dragging = false; reset(true); } });
    })();
    // Widening past the phone layout hides the menu, so never leave the page locked.
    window.matchMedia('(min-width: 1024px)').addEventListener('change', function(e) { if (e.matches && isOpen()) setOpen(false, false); });
  })();
</script>
