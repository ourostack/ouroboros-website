---
// A post's byline: its authors, the month it was published and, when it has
// changed since, the month it was updated. Pass the same ISO dates the post's
// JSON-LD uses, so the visible dates and the metadata can't drift apart.
interface Props {
  authors: string[];
  published: string;
  updated?: string;
  // Where the update lives on the page, so the byline itself is the note.
  updatedHref?: string;
  class?: string;
}

const { authors, published, updated, updatedHref, class: className = 'mt-5' } = Astro.props;

const month = (iso: string) =>
  new Date(`${iso.slice(0, 10)}T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });

const publishedMonth = month(published);
const updatedMonth = updated ? month(updated) : undefined;
const escape = (text: string) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const parts = [authors.join(' & '), publishedMonth];
const html = parts.map(escape);
if (updatedMonth && updatedMonth !== publishedMonth) {
  const label = escape(`Updated ${updatedMonth}`);
  html.push(updatedHref ? `<a class="underline decoration-1 underline-offset-4 hover:text-bone" href="${escape(updatedHref).replace(/"/g, '&quot;')}">${label}</a>` : label);
}
// Joined with &middot; as the posts always wrote it; the no-break space keeps each dot
// on the line before it, so a wrapped byline never starts with a dot.
---
<p class={`text-sm text-mist ${className}`} set:html={html.join('&nbsp;&middot; ')} />
