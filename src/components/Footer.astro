---
import { footerLine, footerExtras, familyLinks, familyCurrent, localHref } from '../data/site.mjs'
import { FamilyFooter } from './ouro/family-bar/family-footer'

// The line in the display font, then the family's links (Ouro HX's
// FamilyFooter, the family bar's links in the same order, rendered on the
// server with no client script) with this site's own extras after them.
// Each sentence of the line is its own span, so a phone breaks the line between them, as on mendelow.me (root misses ruling 8.4).
const lineParts = footerLine.split(/(?<=\.)\s+/)
const family = familyLinks.map((link) => ({ ...link, href: localHref(link.href) }))
const current = familyCurrent(Astro.url.pathname)
const linkClass = 'underline decoration-canopy underline-offset-4 hover:text-bone transition-colors'
---

<footer class="site-footer trail-top relative mt-8">
  <div class="px-6 md:px-12 lg:px-16 pt-14 sm:pt-20 pb-6"><div class="footer-inner max-w-6xl mx-auto">
    <p class="font-display text-2xl md:text-3xl text-bone leading-snug footer-line">{lineParts.map((part, i) => (<>{i > 0 && ' '}<span>{part}</span></>))}</p>
    <FamilyFooter links={family} current={current} className="mt-8">
      {footerExtras.map((link) => <a href={link.href} class={linkClass}>{link.label}</a>)}
      <span>© 2026 Ari Mendelow</span>
    </FamilyFooter>
  </div></div>
</footer>

<style>
  .footer-line { text-wrap: balance; }
  .footer-line span { display: inline-block; }
  /* The footer's extras stand a finger tall on a phone, as the family links do (taste review r15). */
  @media (pointer: coarse) {
    .site-footer :global([data-ouro-family-extras] a) { display: inline-flex; align-items: center; min-height: 2.75rem; min-width: 2.75rem; }
  }
</style>
