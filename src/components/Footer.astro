---
import { footerLine, footerRow } from '../data/site.mjs'

// Shared kit: the line in the display font, then one row. The same structure ships on mendelow.me.
// Each sentence of the line is its own span, so a phone breaks the line between them, as on mendelow.me (root misses ruling 8.4).
const lineParts = footerLine.split(/(?<=\.)\s+/)
const linkClass = 'underline decoration-canopy underline-offset-4 hover:text-bone transition-colors'
---

<footer class="site-footer relative border-t border-canopy/15 mt-8">
  <div class="px-5 sm:px-6 md:px-12 lg:px-16 py-14 sm:py-20"><div class="footer-inner max-w-6xl mx-auto text-center">
    <p class="font-display text-2xl md:text-3xl text-bone leading-snug footer-line">{lineParts.map((part, i) => (<>{i > 0 && ' '}<span>{part}</span></>))}</p>
    <p class="footer-row text-sm text-mist mt-6">
      <span>© 2026 Ari Mendelow</span>
      {footerRow.map((link) => (
        <>
          <span class="footer-sep" aria-hidden="true">&middot;</span>
          <a href={link.href} class={linkClass}>{link.label}</a>
        </>
      ))}
    </p>
  </div></div>
</footer>

<style>
  .footer-row { display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline; gap: 0.35rem 0.6rem; }
  .footer-sep { color: var(--color-shadow); }
  .footer-line { text-wrap: balance; }
  .footer-line span { display: inline-block; }
  /* On a desktop the line and the links share one row across the container, as on mendelow.me. */
  @media (min-width: 1024px) {
    .footer-inner { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem var(--split-gap); text-align: left; }
    .footer-row { flex: none; margin-top: 0; justify-content: flex-end; }
  }
  /* The row wraps on a phone, so a separator would dangle at a line's end; the
     wider gap separates the items instead (root final ruling F17). */
  @media (max-width: 639.98px) { .footer-sep { display: none; } .footer-row { column-gap: 1.1rem; } }
</style>
