---
import { navLinks, footerExtraLinks, githubOrg } from '../data/site.mjs'

const currentYear = new Date().getFullYear()
---

<footer class="relative border-t border-canopy/15 mt-32">
  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-24 py-16 sm:py-20 text-center">
    <a href="/" class="inline-flex items-center gap-3 text-bone" aria-label="Ouroboros home">
      <span class="mark-mask w-8 h-8" style="--mark:url(/brand/ouro-badge.svg)" aria-hidden="true"></span>
      <span class="font-display text-xl">ouro</span>
    </a>

    <p class="font-display text-mist mt-3">Bring judgement. They've got the rest.</p>

    <nav class="flex flex-wrap justify-center gap-x-6 gap-y-3 text-sm text-mist mt-8" aria-label="Footer">
      {navLinks.map(link => (
        <a href={link.href} class="underline decoration-canopy underline-offset-4 hover:text-bone transition-colors">{link.label}</a>
      ))}
      {footerExtraLinks.map(link => (
        <a href={link.href} class="underline decoration-canopy underline-offset-4 hover:text-bone transition-colors">{link.label}</a>
      ))}
      <a href={githubOrg} target="_blank" rel="noopener" class="underline decoration-canopy underline-offset-4 hover:text-bone transition-colors">GitHub</a>
    </nav>

    <div class="mt-12 pt-8 border-t border-canopy/15 text-xs text-shadow">
      &copy; {currentYear} Ouroboros. <a href={githubOrg} target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-mist transition-colors">Open source</a>.
    </div>
  </div>
</footer>
