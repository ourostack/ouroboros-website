---
// An optional detour: always open, styled like PromptCard, with a link back
// to where the reader left the main path.
interface Props {
  id: string;
  title: string;
  back: string;
}

const { id, title, back } = Astro.props;
---
<aside id={id} class="side-quest my-8" data-side-quest aria-labelledby={`${id}-title`}>
  <p class="side-quest-eyebrow">Side quest</p>
  <h3 id={`${id}-title`} class="side-quest-title">{title}</h3>
  <div class="side-quest-body"><slot /></div>
  <p class="side-quest-foot"><a href={`#${back}`} class="hit">Back to the main path</a></p>
</aside>

<style>
  .side-quest {
    scroll-margin-top: 6rem; padding: 1.25rem 1.4rem 0.5rem; border-radius: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--color-canopy) 70%, transparent);
    background: color-mix(in srgb, var(--color-deep) 60%, transparent);
  }
  .side-quest-eyebrow { margin: 0; font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--color-fang); }
  .side-quest .side-quest-title { margin: 0.4rem 0 0.75rem; font-family: var(--font-display); font-size: 1.5rem; line-height: 1.2; color: var(--color-bone); }
  .side-quest-body > :global(:first-child) { margin-top: 0; }
  .side-quest-foot { margin: 0.5rem 0 0; }
</style>
