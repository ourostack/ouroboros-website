---
import '../styles/global.css'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import { labStatusFor } from '../data/lab.mjs'
import PostEnd from '../components/PostEnd.astro'
import { pageOg, routePathForSlug } from '../data/og'
import StoryScene from '../components/StoryScene.astro'
import { sceneFor, meadowScene, scenes } from '../data/scenes.mjs'

interface Props {
  title: string
  description?: string
  ogImage?: string
  canonical?: string
  ogType?: string
  /** What a Lab page is ("Operator guide", a reviewer and its date): set on the Lab's own line, so the labels never stack. */
  crumbs?: string[]
}

const {
  title,
  description = "How can humans and agents do more together? Here's how I believe it works, what I use to support it, and what you can try.",
  ogImage = '/og/og-home.jpg',
  canonical = `https://ouroboros.bot${Astro.url.pathname}`,
  ogType = 'website',
  crumbs = [],
} = Astro.props
const lab = labStatusFor(Astro.url.pathname)
// The card's alt text says what the generated card shows: its title, set in its scene.
const ogSlug = ogImage.match(/\/og\/(og-[^/]+)\.jpg$/)?.[1]
const ogEntry = ogSlug ? pageOg[routePathForSlug(ogSlug) ?? ''] : undefined
const ogRoute = ogSlug ? routePathForSlug(ogSlug) : null
const ogAlt = ogEntry && ogRoute ? `${ogEntry.title} ${scenes[sceneFor(ogRoute).og]}` : title
// Every blog post ends with the same short route onward: Desk, the factory, the approach.
const isPost = /^\/blog\/[^/]+\/?$/.test(Astro.url.pathname)
// The page's storybook scene (src/data/scenes.mjs): the arrival, and the meadow by the footer.
const scene = sceneFor(Astro.url.pathname)
const showMeadow = scene.meadow && scene.hero !== meadowScene
// The hero is the largest paint on most pages, so fetch it alongside the CSS.
const heroBase = scene.hero ? `/brand/storybook` : ''
// Content pages (a Lab piece, a doc, a review, a post) open on a shorter scene,
// so the title and the first line of the intro sit above the fold on a laptop
// (taste review r3, 2026-11-06).
const contentHero = /^\/(lab|blog)\/[^/]+/.test(Astro.url.pathname)
// A review transcript's way back to all the reviews shares the Lab's line, so
// the breadcrumbs never stack (taste review r3).
const labParent = /^\/lab\/model-reviews\/[^/]+/.test(Astro.url.pathname) ? { href: '/lab/model-reviews/', label: 'All reviews' } : null
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply a saved theme before first paint, so there is no flash.
      try { var t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/brand/ouro.svg" />
    <link rel="apple-touch-icon" href="/brand/storybook/icons/ouro-180.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {scene.hero && (
      <>
        <link rel="preload" as="image" type="image/avif" media="(max-width: 640px)" imagesrcset={`${heroBase}/phone/${scene.hero}-384.avif 384w, ${heroBase}/phone/${scene.hero}-768.avif 768w`} imagesizes="100vw" fetchpriority="high" />
        <link rel="preload" as="image" type="image/avif" media="(min-width: 641px)" imagesrcset={`${heroBase}/scenes/${scene.hero}-640.avif 640w, ${heroBase}/scenes/${scene.hero}-960.avif 960w, ${heroBase}/scenes/${scene.hero}-1536.avif 1536w`} imagesizes="100vw" fetchpriority="high" />
      </>
    )}
    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={`https://ouroboros.bot${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Ouro" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`https://ouroboros.bot${ogImage}`} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="canonical" href={canonical} />
    <slot name="head" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Ouro",
      "url": "https://ouroboros.bot",
      "description": "How can humans and agents do more together? The approach, the tools that support it, and what you can try.",
      "publisher": { "@type": "Person", "name": "Ari Mendelow", "url": "https://linkedin.com/in/arimendelow" }
    })} />
  </head>
  <body class="bg-void text-bone font-body antialiased overflow-x-hidden">
    {/* Atmospheric base — not pure black, a living dark gradient */}
    <div class="fixed inset-0 pointer-events-none z-0 bg-gradient-to-b from-void via-deep/50 to-void" aria-hidden="true"></div>
    {/* Grain */}
    <div class="fixed inset-0 pointer-events-none z-50" style="background-image: url('/images/grain.png'); background-repeat: repeat; opacity: 0.03;" aria-hidden="true"></div>

    <Nav />
    <main class="relative z-10">
      {scene.hero && <StoryScene scene={scene.hero} variant="hero" class={scene.band ? 'story-hero-band' : contentHero ? 'story-hero-content' : undefined} />}
      {lab && (
        <div class:list={['lab-status z-20 px-6 md:px-12 lg:px-16', scene.hero ? 'relative pt-5' : 'absolute top-16 inset-x-0 pt-3']} data-lab-status={lab.status}>
          {/* One line, never two stacked rows (taste reviews r3 and r4): the way back, what
              the page is, then its status. "← Lab · Operator guide · Experimental". */}
          <div class="lab-line max-w-6xl mx-auto text-sm text-mist"><p class="lab-items">
            <span class="lab-item"><a href="/lab/" class="text-scale underline underline-offset-4 decoration-scale/40 hover:text-glow">&larr; Lab</a></span>
            {labParent && <span class="lab-item"><a href={labParent.href} class="text-scale underline underline-offset-4 decoration-scale/40 hover:text-glow">{labParent.label}</a></span>}
            {crumbs.map((crumb) => <span class="lab-item lab-crumb">{crumb}</span>)}
            {lab.status !== 'Origin' && <span class="lab-item"><span class={`tag ${lab.tone}`}>{lab.status}</span></span>}
          </p></div>
        </div>
      )}
      <slot />
      {isPost && <PostEnd />}
    </main>
    {showMeadow && <StoryScene scene={meadowScene} variant="meadow" alt="" />}
    <Footer />

    <script is:inline>
      // A deep link (/#try, /approach/#durable-context) lands on its anchor at
      // once; smooth scrolling starts only after arrival, for clicks within the
      // page (global.css applies it only without reduced motion).
      (function () {
        function ready() { requestAnimationFrame(function () { document.documentElement.classList.add('smooth-scroll'); }); }
        if (document.readyState === 'complete') ready(); else window.addEventListener('load', ready, { once: true });
      })();
    </script>
    <script is:inline>
      // Copy buttons: <button data-copy-target="id"> copies that element's text.
      // Without the Clipboard API, select the text so the visitor can copy it.
      (function () {
        document.querySelectorAll('[data-copy-target]').forEach(function (button) {
          button.addEventListener('click', function () {
            var target = document.getElementById(button.getAttribute('data-copy-target'));
            var label = button.querySelector('[data-copy-label]') || button;
            if (!target) return;
            var original = label.textContent;
            function done(text) {
              label.textContent = text;
              setTimeout(function () { label.textContent = original; }, 1600);
            }
            function select() {
              var range = document.createRange();
              range.selectNodeContents(target);
              var selection = window.getSelection();
              selection.removeAllRanges();
              selection.addRange(range);
              done('Selected, now copy it');
            }
            if (navigator.clipboard && window.isSecureContext) {
              navigator.clipboard.writeText(target.textContent).then(function () { done('Copied'); }, select);
            } else {
              select();
            }
          });
        });
      })();
    </script>
    <script is:inline>
      (function() {
        var reveals = document.querySelectorAll('.reveal');
        if (!reveals.length || !('IntersectionObserver' in window)) return;
        reveals.forEach(function(el) {
          var rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight && rect.bottom > 0) el.classList.add('visible');
        });
        document.documentElement.classList.add('reveal-ready');
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) { entry.target.classList.add('visible'); observer.unobserve(entry.target); }
          });
        }, { threshold: 0, rootMargin: '0px 0px 200px 0px' });
        reveals.forEach(function(el) { if (!el.classList.contains('visible')) observer.observe(el); });
      })();
    </script>
    <script is:inline>
      // Storybook scenes below the arrival (StoryScene.astro) and video posters
      // (WorkshopVideo.astro) load only after the hero scene has landed, the scenes
      // then as they come within reach, so on a slow phone the hero has the
      // connection to itself.
      (function() {
        var deferred = document.querySelectorAll('picture[data-defer]');
        function show(p) {
          p.querySelectorAll('source[data-srcset]').forEach(function(s) { s.srcset = s.dataset.srcset; });
          var img = p.querySelector('img[data-src]');
          if (img) img.src = img.dataset.src;
        }
        function start() {
          // Anything else waiting on the arrival (video posters) goes now too.
          document.documentElement.setAttribute('data-arrived', '');
          document.dispatchEvent(new Event('story:arrived'));
          if (!deferred.length) return;
          if (!('IntersectionObserver' in window)) { deferred.forEach(show); return; }
          var io = new IntersectionObserver(function(entries) {
            entries.forEach(function(e) { if (e.isIntersecting) { show(e.target); io.unobserve(e.target); } });
          }, { rootMargin: '600px 0px' });
          // The meadow above the footer starts far earlier, a few screens ahead, so a
          // quick scroll to the foot never meets an empty band (taste review r4).
          var far = new IntersectionObserver(function(entries) {
            entries.forEach(function(e) { if (e.isIntersecting) { show(e.target); far.unobserve(e.target); } });
          }, { rootMargin: '2400px 0px' });
          deferred.forEach(function(p) { (p.getAttribute('data-defer') === 'far' ? far : io).observe(p); });
        }
        var hero = document.querySelector('.story-hero img');
        if (!hero || hero.complete) { start(); return; }
        var started = false;
        function once() { if (!started) { started = true; start(); } }
        hero.addEventListener('load', once); hero.addEventListener('error', once);
        setTimeout(once, 4000);
      })();
    </script>
  </body>
</html>
