{
  "name": "ouroboros-website",
  "account_id": "4b157323bc7b08c0f6b0dc9c23b1e2b1",
  "compatibility_date": "2026-03-06",
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/docs*",
      "/model-reviews*",
      "/story*",
      "/why*",
      "/what-is-an-agent-harness*",
      "/essays*",
      "/lab/what-is-agent-experience*",
      "/lab/give-your-agent-a-home*",
      "/lab/build-ai-agent-from-scratch*",
      "/og/*.png",
      "/og/og-ouro-hx.*",
      "/sitemap.xml",
      "/ouro-hx*"
    ]
  },
  "routes": [
    {
      "pattern": "ouroboros.bot/*",
      "zone_name": "ouroboros.bot"
    }
  ]
}
